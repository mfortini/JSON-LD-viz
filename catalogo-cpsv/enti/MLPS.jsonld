    {
      "@id": "https://www.lavoro.gov.it/strumenti-e-servizi/Attuazione-Interventi-PNRR/Pagine/M5C2/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "M5C2 (Componente C2 - “Infrastrutture sociali, famiglie, comunità e terzo settore”)"
      },
      "dct:title": {
        "@language": "it",
        "@value": "M5C2 (Componente C2 - “Infrastrutture sociali, famiglie, comunità e terzo settore”)"
      },
      "cpsv:producedBy": {
        "@id": "https://www.lavoro.gov.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.lavoro.gov.it"
      },
      "foaf:page": "https://www.lavoro.gov.it/strumenti-e-servizi/Attuazione-Interventi-PNRR/Pagine/M5C2/",
      "dct:description": {
        "@language": "it",
        "@value": "Gli interventi della Componente 2 della Missione 5 di competenza MLPS per PNRR italiano valorizzano l'intera dimensione sociale delle politiche sanitarie, urbanistiche, abitative e dei servizi per l’infanzia, per le persone anziane, per i soggetti più vulnerabili, con una particolare attenzione alle sfere della formazione, del lavoro, del sostegno alle famiglie, dell’equità sociale e tra i generi.\nGli interventi previsti interessano le persone più fragili, nella loro dimensione individuale, familiare e sociale. Il fine di tutte le misure nel complesso è quello di prevenire l’istituzionalizzazione della persona e intervenire sui principali fattori di rischio che portano a una condizione di marginalità sociale, mirando a una sempre maggiore autonomia delle persone coinvolte.\nL’attenzione verso i soggetti più fragili comporta proprio la necessità di investire in interventi di inclusione sociale volti a eliminare tutti quegli ostacoli che impediscono a persone con una data vulnerabilità (minori in povertà educativa, anziani non autosufficienti, persone con disabilità e senza dimora) una reale autonomia e autodeterminazione personale, nonché la partecipazione a percorsi di politica…"
      },
      "cpsv:hasChannel": {
        "@id": "https://www.lavoro.gov.it/strumenti-e-servizi/Attuazione-Interventi-PNRR/Pagine/M5C2/#channel-online-0",
        "@type": "cpsv:OtherElectronicChannel",
        "foaf:page": "https://www.lavoro.gov.it/strumenti-e-servizi/Attuazione-Interventi-PNRR/Pagine/M5C2/"
      },
      "cpsv:hasTheme": {
        "@id": "https://w3id.org/italia/controlled-vocabulary/classifications-for-public-services/public-services-subject-matters/3"
      },
      "cpsv:isPartOfEvent": [
        {
          "@id": "https://w3id.org/italia/controlled-vocabulary/classifications-for-public-services/life-business-event/life-event/3"
        },
