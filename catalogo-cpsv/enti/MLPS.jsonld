    {
      "@id": "https://www.lavoro.gov.it/strumenti-e-servizi/pagine/albo-nazionale-soggetti-accreditati-ai-servizi-lavoro/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Albo nazionale soggetti accreditati ai servizi lavoro"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Albo nazionale soggetti accreditati ai servizi lavoro"
      },
      "cpsv:producedBy": {
        "@id": "https://www.lavoro.gov.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.lavoro.gov.it"
      },
      "foaf:page": "https://www.lavoro.gov.it/strumenti-e-servizi/pagine/albo-nazionale-soggetti-accreditati-ai-servizi-lavoro/",
      "dct:description": {
        "@language": "it",
        "@value": "Per erogare servizi di politica attiva del lavoro è necessario essere accreditati. L’iscrizione all'Albo nazionale dei soggetti accreditati ai servizi per il lavoro può essere richiesta al Ministero del Lavoro e delle Politiche Sociali.\nI soggetti accreditati da Regioni e Province Autonome sono inseriti, da queste ultime, nella sezione 2 dell’Albo nazionale.\nAlbo dei soggetti accreditati ai servizi per il lavoro\nRaccoglie i soggetti accreditati a livello nazionale e regionale a svolgere servizi e misure di politica attiva del lavoro."
      },
      "cpsv:hasChannel": {
