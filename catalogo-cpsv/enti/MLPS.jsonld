    {
      "@id": "https://www.lavoro.gov.it/strumenti-e-servizi/Deposito-telematico-contratti/Pagine/Decontribuzione-deposito-contratti/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Misure di conciliazione vita lavoro"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Misure di conciliazione vita lavoro"
      },
      "cpsv:producedBy": {
        "@id": "https://www.lavoro.gov.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.lavoro.gov.it"
      },
      "foaf:page": "https://www.lavoro.gov.it/strumenti-e-servizi/Deposito-telematico-contratti/Pagine/Decontribuzione-deposito-contratti/",
      "dct:description": {
        "@language": "it",
        "@value": "​ Per il biennio 2017-2018, era stata avviata una sperimentazione per favorire la conciliazione dei tempi di vita e lavoro all'interno delle aziende: lo sgravio contributivo previsto dall'articolo 25 del Decreto Legislativo n. 80/2015 e attuato secondo le modalità del Decreto Interministeriale del 12 settembre 2017 .\nL'agevolazione riguardava i contratti aziendali sottoscritti dal 1° gennaio 2017 al 31 agosto 2018 che promuovevano misure di conciliazione per i dipendenti, migliorative rispetto alle previsioni di legge o del CCNL di riferimento. Il sostegno alla genitorialità, la flessibilità organizzativa e l'erogazione di servizi di welfare aziendale a favore dei lavoratori: sono le tre le linee di intervento individuate dal Decreto.\nI datori di lavoro che intendavano usufruire della decontribuzione dovevano inviare un'apposita istanza sul portale INPS e, preventivamente, effettuare il deposito telematico del contratto aziendale, anche qualora si trattasse del recepimento di un contratto territoriale di secondo livello.\nPer accedere alle risorse stanziate dal Decreto per l'anno 2017, il deposito doveva avvenire entro il 31 ottobre 2017 e la richiesta all'INPS doveva essere…"
      },
      "cpsv:hasChannel": {
        "@id": "https://www.lavoro.gov.it/strumenti-e-servizi/Deposito-telematico-contratti/Pagine/Decontribuzione-deposito-contratti/#channel-online-0",
        "@type": "cpsv:OtherElectronicChannel",
        "foaf:page": "https://servizi.lavoro.gov.it/deposito-contratti/"
      },
      "cpsv:hasTheme": {
        "@id": "https://w3id.org/italia/controlled-vocabulary/classifications-for-public-services/public-services-subject-matters/3"
      },
      "cpsv:isPartOfEvent": [
