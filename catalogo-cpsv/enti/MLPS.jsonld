        },
        {
          "@id": "https://w3id.org/italia/controlled-vocabulary/classifications-for-public-services/life-business-event/life-event/4"
        }
      ],
      "cpsv-portalone:lifeEventMapping": {
        "cpsv-portalone:method": "mlps-hub-crosswalk",
        "cpsv-portalone:methodLabel": "mlps-hub-crosswalk",
        "cpsv-portalone:confidence": "unknown",
