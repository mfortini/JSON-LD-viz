    {
      "@id": "https://www.lavoro.gov.it/strumenti-e-servizi/Attuazione-Interventi-PNRR/Pagine/M5C1/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "M5C1 (Componente C1 - “Politiche del lavoro”)"
      },
      "dct:title": {
        "@language": "it",
        "@value": "M5C1 (Componente C1 - “Politiche del lavoro”)"
      },
      "cpsv:producedBy": {
