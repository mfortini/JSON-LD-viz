    {
      "@id": "https://www.lavoro.gov.it/strumenti-e-servizi/Deposito-telematico-contratti/Pagine/Credito-d-imposta-deposito-contratti/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Credito d'imposta per la formazione 4.0"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Credito d'imposta per la formazione 4.0"
      },
      "cpsv:producedBy": {
        "@id": "https://www.lavoro.gov.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.lavoro.gov.it"
      },
      "foaf:page": "https://www.lavoro.gov.it/strumenti-e-servizi/Deposito-telematico-contratti/Pagine/Credito-d-imposta-deposito-contratti/",
      "dct:description": {
        "@language": "it",
        "@value": "La Legge di Bilancio 2018 (Legge 27 dicembre 2017, n. 205) ha introdotto una misura volta a favorire i processo di innovazione tecnologica e digitale delle aziende, incentrata su una delle risorse più importanti: il capitale umano.\nÈ il credito d'imposta per la formazione 4.0 di cui sono fornite le modalità operative nel DM 4 maggio 2018. Possono beneficiarne imprese residenti in Italia o all'estero ma con stabili organizzazioni sul territorio italiano, gli enti non commerciali residenti che svolgono attività commerciali rilevanti ai fini del reddito d'impresa.\nL'agevolazione è modulata in base alle dimensioni aziendali, dopo la Legge di Bilancio 2019 (Legge 30 dicembre 2018 n.145) che ha inteso favorire, in particolare, le piccole e medie imprese. Riguarda le spese sostenute nel 2019 per il personale dipendente impegnato nelle attività di formazione relative alle \"tecnologie abilitanti\" - limitatamente al costo aziendale riferito alle ore o alle giornate di formazione - e pattuite attraverso contratti collettivi aziendali o territoriali. Sono ammissibili anche le spese per il personale impegnato come tutor o docente, nel limite del 30% della retribuzione complessiva annua…"
      },
      "cpsv:hasChannel": {
        "@id": "https://www.lavoro.gov.it/strumenti-e-servizi/Deposito-telematico-contratti/Pagine/Credito-d-imposta-deposito-contratti/#channel-online-0",
        "@type": "cpsv:OtherElectronicChannel",
        "foaf:page": "https://servizi.lavoro.gov.it/deposito-contratti"
      },
      "cpsv:hasTheme": {
        "@id": "https://w3id.org/italia/controlled-vocabulary/classifications-for-public-services/public-services-subject-matters/3"
      },
