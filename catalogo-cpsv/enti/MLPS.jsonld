    {
      "@id": "https://www.lavoro.gov.it/strumenti-e-servizi/pagine/albo-nazionale-delle-agenzie-il-lavoro/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Albo nazionale delle Agenzie per il lavoro"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Albo nazionale delle Agenzie per il lavoro"
      },
      "cpsv:producedBy": {
