      }
    },
    {
      "@id": "https://aci.gov.it/servizio/consultazione-online-esito-istanza-di-rimborso/#input-cosa-serve",
      "@type": "cpsv:Input",
      "dct:description": {
        "@language": "it",
        "@value": "Cosa serve: numero di protocollo assegnato all’istanza codice fiscale del richiedente presenti sul documento rilasciato dall’Ufficio PRA (Pubblico Registro Automobilistico)."
      }
    },
