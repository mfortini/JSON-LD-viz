      "cpsv-portalone:lifeEventMapping": {
        "cpsv-portalone:method": "aci-area-crosswalk",
        "cpsv-portalone:methodLabel": "Curato · area tematica ACI",
        "cpsv-portalone:confidence": "curated",
        "cpsv-portalone:badge": "aci",
        "cpsv-portalone:sourceField": "area_tematica",
        "cpsv-portalone:sourceValue": "Pratiche auto"
      },
      "dct:description": {
        "@language": "it",
        "@value": "Il servizio consente di effettuare il pagamento tramite pagoPA degli importi: delle somme di spettanza ACI, sia per le pratiche richieste agli Uffici del Pubblico Registro Automobilistico (PRA) tramite PEC o mail sia per quelle presentate presso gli Uffici della Motorizzazione Civile (UMC) delle visure nominative delle certificazioni e delle visure non effettuabili tramite i servizi online Crononet e Visurenet."
      },
      "dct:modified": "5 Settembre 2025",
      "aci:outputDescription": {
        "@language": "it",
        "@value": "Effettuato e andato a buon fine il pagamento su pagoPA, eseguito con una delle modalità previste, si ottiene la ricevuta contenente il codice IUV (Identificativo Univoco di Versamento) generato dal sistema. Tale ricevuta dovrà essere presentata all’Ufficio PRA o, in alternativa, all’Ufficio della Motorizzazione Civile. In caso di richieste tramite PEC o mail di pratiche, visure nominative e certificazioni, la ricevuta dovrà essere inviata unitamente alla relativa documentazione."
      },
      "aci:processingTime": {
        "@language": "it",
        "@value": "Quelli previsti dalla modalità di pagamento scelta (carta di credito/debito, bonifico, altri sistemi di pagamento come ad esempio PayPal)."
      },
      "aci:costDescription": {
        "@language": "it",
        "@value": "Il servizio è gratuito. Possono essere previste commissioni bancarie o postali, legate alla modalità di pagamento scelta."
      },
      "cpsv:hasWebSiteChannel": {
        "@id": "https://aci.gov.it/servizio/pagamento-formalita-pra-presso-uffici-motorizzazione-civile/#website-channel"
      },
