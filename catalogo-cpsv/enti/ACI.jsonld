    {
      "@id": "https://aci.gov.it/servizio/visurenet-visura-della-banca-dati-del-pubblico-registro-automobilistico-pra/#addressee-cittadino",
      "@type": "cv:Agent",
      "skos:prefLabel": {
        "@language": "it",
        "@value": "Cittadino"
      }
    },
    {
      "@id": "https://aci.gov.it/servizio/visurenet-visura-della-banca-dati-del-pubblico-registro-automobilistico-pra/#addressee-description",
      "@type": "cv:Agent",
      "dct:description": {
        "@language": "it",
        "@value": "A chiunque ne faccia richiesta. Attenzione La visura viene rilasciata solo se il veicolo è iscritto al PRA e la targa è contenuta in un archivio informatico (generalmente per i veicoli iscritti e/o oggetto di pratiche/operazioni effettuate dopo il 1992)."
      }
    },
    {
      "@id": "https://aci.gov.it/servizio/visurenet-visura-della-banca-dati-del-pubblico-registro-automobilistico-pra/#input-cosa-serve",
      "@type": "cpsv:Input",
      "dct:description": {
        "@language": "it",
        "@value": "Cosa serve: tipo di veicolo (autoveicolo, motoveicolo, rimorchio) targa completa."
      }
    },
    {
      "@id": "https://aci.gov.it/servizio/visurenet-visura-della-banca-dati-del-pubblico-registro-automobilistico-pra/#input-come-fare",
      "@type": "cpsv:Input",
      "dct:description": {
        "@language": "it",
        "@value": "Come fare: La visura può essere richiesta: con il servizio Visurenet mediante autenticazione con le credenziali SPID, CIE, CNS ed eIDAS. Sono consentite solamente tre visure nello stesso giorno con lo stesso codice fiscale; per le visure non richiedibili tramite il servizio Visurenet è possibile fare richiesta via PEC o posta elettronica all’Ufficio del Pubblico Registro Automobilistico della provincia di residenza. I recapiti sono reperibili nella sezione Sedi ACI sul territorio ; i richiedenti stranieri extra UE, o UE che non sono in possesso di una identità digitale, possono richiedere le visure agli Uffici provinciali PRA seguendo le indicazioni riportate nell’ Avviso/Notice . Per la richiesta, è necessario utilizzare il Modulo/Application Form ."
      }
    },
    {
      "@id": "https://aci.gov.it/servizio/visurenet-visura-della-banca-dati-del-pubblico-registro-automobilistico-pra/#access-description",
      "@type": "cpsv:OtherElectronicChannel",
      "dct:description": {
        "@language": "it",
        "@value": "Puoi effettuare una visura online tramite identità digitale. visurenet.aci.it"
      }
    },
    {
      "@id": "https://visurenet.aci.it/#electronic-channel",
      "@type": "cpsv:OtherElectronicChannel",
      "foaf:page": "https://visurenet.aci.it/"
    }
