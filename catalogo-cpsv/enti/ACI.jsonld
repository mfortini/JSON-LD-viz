    {
      "@id": "https://aci.gov.it/servizio/fornitura-dati-pra/#website-channel",
      "@type": "cpsv:WebSiteChannel",
      "foaf:page": "https://aci.gov.it/servizio/fornitura-dati-pra/"
    },
    {
      "@id": "https://aci.gov.it/servizio/fornitura-dati-pra/#addressee-professionisti%2C%20imprese%2C%20enti%20e%20pa",
      "@type": "cv:Agent",
      "skos:prefLabel": {
        "@language": "it",
        "@value": "Professionisti, imprese, Enti e PA"
      }
    },
    {
      "@id": "https://aci.gov.it/servizio/fornitura-dati-pra/#addressee-description",
      "@type": "cv:Agent",
      "dct:description": {
        "@language": "it",
        "@value": "Il servizio è predisposto a beneficio: degli Operatori del mercato automotive , quali ad esempio le aziende autorizzate alla revisione dei veicoli, o aziende che debbano utilizzare le informazioni del PRA per effettuare analisi di mercato o per la realizzazione di iniziative o progetti connessi con il mondo dell’automobile; delle Pubbliche Amministrazioni , ad esempio per soddisfare specifiche esigenze legate al parco circolante, alle zone a traffico limitato, in materia tributaria, ai fini della pianificazione in materia ambientale o delle attività degli studi di consulenza automobilistica."
      }
    },
    {
      "@id": "https://aci.gov.it/servizio/fornitura-dati-pra/#input-come-fare",
      "@type": "cpsv:Input",
      "dct:description": {
        "@language": "it",
        "@value": "Come fare: Forniture “una tantum” c.d. catalogate , tramite registrazione al servizio Forniture Dati PRA, per accedere a una propria area riservata dove inserire e gestire le richieste di fornitura. Forniture in convenzione con cadenza periodica (mensile, bimestrale, trimestrale ecc.) che può essere richiesta tramite registrazione al servizio Forniture Dati PRA, per accedere a una propria area riservata dove inserire una richiesta di convenzione. Il servizio viene erogato entro i termini disciplinati in convenzione. L’accesso al servizio è subordinato alla verifica della fattibilità tecnica ed eventuale sviluppo del software di estrazione e dopo la stipula della convenzione. Forniture “una tantum” c.d. non catalogate , tramite registrazione al servizio Forniture Dati PRA. Il servizio viene erogato previa verifica della fattibilità tecnica e sviluppo del software di estrazione."
      }
    },
    {
      "@id": "https://aci.gov.it/servizio/fornitura-dati-pra/#access-description",
      "@type": "cpsv:OtherElectronicChannel",
      "dct:description": {
        "@language": "it",
        "@value": "Puoi accedere al servizio online previa registrazione allo stesso. my.aci.it"
      }
    },
    {
      "@id": "https://my.aci.it/spec/pra/index#electronic-channel",
      "@type": "cpsv:OtherElectronicChannel",
      "foaf:page": "https://my.aci.it/spec/pra/index"
    },
