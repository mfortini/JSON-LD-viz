      },
      "dct:title": {
        "@language": "it",
        "@value": "Pagamento Formalità PRA"
      },
      "dct:identifier": "https://aci.gov.it/servizio/pagamento-formalita-pra-presso-uffici-motorizzazione-civile/",
      "foaf:page": "https://aci.gov.it/servizio/pagamento-formalita-pra-presso-uffici-motorizzazione-civile/",
      "dct:language": "http://publications.europa.eu/resource/authority/language/ITA",
