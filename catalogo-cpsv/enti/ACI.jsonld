    {
      "@id": "https://aci.gov.it/servizio/attestazione-classe-di-distanza-chilometrica-per-farmacie/",
      "@type": "cpsv:PublicService",
      "cv:hasCompetentAuthority": {
        "@id": "https://www.aci.it"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Attestazione classe di distanza chilometrica per farmacie"
      },
      "dct:identifier": "https://aci.gov.it/servizio/attestazione-classe-di-distanza-chilometrica-per-farmacie/",
      "foaf:page": "https://aci.gov.it/servizio/attestazione-classe-di-distanza-chilometrica-per-farmacie/",
      "dct:language": "http://publications.europa.eu/resource/authority/language/ITA",
      "dct:description": {
        "@language": "it",
        "@value": "Il servizio fornisce una attestazione che certifica la classe di distanza chilometrica che intercorre tra farmacie situate in frazioni comunali e il centro geografico comunale del capoluogo della provincia di appartenenza, ai fini di quanto previsto dal Titolo II, art. 17, comma 3 dell’Accordo Collettivo Nazionale per la disciplina dei rapporti con le farmacie pubbliche e private."
      },
      "dct:modified": "25 Novembre 2025",
      "aci:outputDescription": {
        "@language": "it",
        "@value": "Attestazione che certifica la classe di distanza chilometrica che intercorre tra farmacie situate in frazioni comunali e il centro geografico comunale del capoluogo della provincia di appartenenza."
      },
      "aci:processingTime": {
        "@language": "it",
        "@value": "La richiesta, di norma, viene svolta in 2-4 giorni lavorativi dalla ricezione della mail, esclusi sabato e festivi."
      },
      "aci:costDescription": {
        "@language": "it",
        "@value": "Il servizio è gratuito."
      },
      "cpsv:hasWebSiteChannel": {
        "@id": "https://aci.gov.it/servizio/attestazione-classe-di-distanza-chilometrica-per-farmacie/#website-channel"
      },
      "cv:addressee": [
        {
          "@id": "https://aci.gov.it/servizio/attestazione-classe-di-distanza-chilometrica-per-farmacie/#addressee-professionisti%2C%20imprese%2C%20enti%20e%20pa"
        },
        {
          "@id": "https://aci.gov.it/servizio/attestazione-classe-di-distanza-chilometrica-per-farmacie/#addressee-description"
        }
      ],
      "cpsv:hasInput": [
        {
          "@id": "https://aci.gov.it/servizio/attestazione-classe-di-distanza-chilometrica-per-farmacie/#input-cosa-serve"
        },
        {
          "@id": "https://aci.gov.it/servizio/attestazione-classe-di-distanza-chilometrica-per-farmacie/#input-come-fare"
        }
      ]
    },
    {
      "@id": "https://aci.gov.it/servizio/attestazione-classe-di-distanza-chilometrica-per-farmacie/#website-channel",
      "@type": "cpsv:WebSiteChannel",
      "foaf:page": "https://aci.gov.it/servizio/attestazione-classe-di-distanza-chilometrica-per-farmacie/"
    },
    {
      "@id": "https://aci.gov.it/servizio/attestazione-classe-di-distanza-chilometrica-per-farmacie/#addressee-professionisti%2C%20imprese%2C%20enti%20e%20pa",
      "@type": "cv:Agent",
      "skos:prefLabel": {
        "@language": "it",
        "@value": "Professionisti, imprese, Enti e PA"
      }
    },
    {
      "@id": "https://aci.gov.it/servizio/attestazione-classe-di-distanza-chilometrica-per-farmacie/#addressee-description",
      "@type": "cv:Agent",
      "dct:description": {
        "@language": "it",
        "@value": "Ad Amministrazioni Pubbliche – ASL – che ne facciano richiesta in ottemperanza a quanto previsto nell’Accordo Collettivo Nazionale per la disciplina dei rapporti con le farmacie pubbliche e private. Al fine di assicurare una gestione più efficiente e centralizzata si ritiene più opportuno che le richieste pervengano per area territoriale di competenza delle ASL."
      }
    },
    {
      "@id": "https://aci.gov.it/servizio/attestazione-classe-di-distanza-chilometrica-per-farmacie/#input-cosa-serve",
      "@type": "cpsv:Input",
      "dct:description": {
        "@language": "it",
        "@value": "Cosa serve: Ragione sociale della farmacia Indirizzo Numero civico Frazione Comune È obbligatoria la compilazione di tutte le informazioni richieste nel foglio excel ."
      }
    },
    {
      "@id": "https://aci.gov.it/servizio/attestazione-classe-di-distanza-chilometrica-per-farmacie/#input-come-fare",
      "@type": "cpsv:Input",
      "dct:description": {
        "@language": "it",
        "@value": "Come fare: Inviare una richiesta mail all’indirizzo distanzechilometriche@aci.it allegando una copia del foglio excel disponibile di seguito. È necessario compilare tutte le colonne del foglio excel, avendo cura di inserire una riga per ciascuna farmacia per la quale si richiede l’attestazione. farmacie ( excel , 6 KB)"
      }
    },
