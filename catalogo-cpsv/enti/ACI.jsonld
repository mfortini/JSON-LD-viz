      "dct:description": {
        "@language": "it",
        "@value": "A chiunque ne faccia richiesta."
      }
    },
    {
      "@id": "https://aci.gov.it/servizio/crononet-estratto-cronologico-pra/#input-cosa-serve",
      "@type": "cpsv:Input",
      "dct:description": {
        "@language": "it",
