      "dct:title": {
        "@language": "it",
        "@value": "Forniture Dati PRA"
      },
      "dct:identifier": "https://aci.gov.it/servizio/fornitura-dati-pra/",
      "foaf:page": "https://aci.gov.it/servizio/fornitura-dati-pra/",
      "dct:language": "http://publications.europa.eu/resource/authority/language/ITA",
      "aci:areaTematica": "Pratiche auto",
      "cpsv:hasTheme": {
        "@id": "https://w3id.org/italia/controlled-vocabulary/classifications-for-public-services/public-services-subject-matters/4"
      },
      "cpsv:isPartOfEvent": [
