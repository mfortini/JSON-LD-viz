    {
      "@id": "https://aci.gov.it/servizio/bollo-auto-istanze-online/#website-channel",
      "@type": "cpsv:WebSiteChannel",
      "foaf:page": "https://aci.gov.it/servizio/bollo-auto-istanze-online/"
    },
    {
      "@id": "https://aci.gov.it/servizio/bollo-auto-istanze-online/#addressee-cittadino",
      "@type": "cv:Agent",
      "skos:prefLabel": {
        "@language": "it",
        "@value": "Cittadino"
      }
    },
    {
      "@id": "https://aci.gov.it/servizio/bollo-auto-istanze-online/#addressee-description",
      "@type": "cv:Agent",
      "dct:description": {
        "@language": "it",
        "@value": "A Cittadini, Amministrazioni, Enti e Aziende che vogliono inviare istanze di rimborso, istanze di esenzione o di domiciliazione del bollo auto o che hanno ricevuto avvisi bonari, accertamenti o ingiunzioni di pagamento dalla propria Regione o Provincia autonoma, e che vogliono inviare online una memoria difensiva per chiedere il riesame della contestazione ricevuta."
      }
    },
    {
      "@id": "https://aci.gov.it/servizio/bollo-auto-istanze-online/#input-cosa-serve",
      "@type": "cpsv:Input",
      "dct:description": {
        "@language": "it",
        "@value": "Cosa serve: Per utilizzare il servizio sono necessari: Per le istanze di rimborso : copia e/o originale delle ricevute di versamento, a seconda delle motivazioni del rimborso eventuali documenti da allegare (in formato PDF, peso massimo 3 Mb) Per le istanze di esenzione : documentazione obbligatoria da allegare, a seconda del richiedente e della tipologia di esenzione richiesta: ad esempio Documento di circolazione, Verbale accertamento handicap, Certificato Commissione medica pubblica, Certificato indennità di accompagnamento, Dichiarazione sostitutiva carico fiscale (in formato PDF, peso massimo 3 Mb) Per le istanze di domiciliazione bancaria : coordinate bancarie del conto sul quale attivare la domiciliazione del bollo auto Per le memorie difensive : il numero pratica presente sull’avviso eventuali documenti da allegare (in formato PDF, peso massimo 3 Mb)."
      }
    },
    {
      "@id": "https://aci.gov.it/servizio/bollo-auto-istanze-online/#input-come-fare",
      "@type": "cpsv:Input",
      "dct:description": {
        "@language": "it",
        "@value": "Come fare: Per accedere al servizio occorre autenticarsi con le credenziali SPID, CIE, CNS ed eIDAS."
      }
    },
    {
      "@id": "https://aci.gov.it/servizio/bollo-auto-istanze-online/#input-condizioni-di-servizio",
      "@type": "cpsv:Input",
      "dct:description": {
        "@language": "it",
        "@value": "Condizioni di servizio: È richiesta l’autenticazione tramite SPID, CIE, CNS oppure eIDAS. È necessario che la Regione/Provincia Autonoma di competenza abbia attivato il servizio e, per le memorie difensive che ci sia una campagna in atto di recupero della tassa automobilistica."
      }
    },
    {
      "@id": "https://aci.gov.it/servizio/bollo-auto-istanze-online/#access-description",
      "@type": "cpsv:OtherElectronicChannel",
      "dct:description": {
        "@language": "it",
        "@value": "Puoi inviare una istanza direttamente online tramite identità digitale. my.aci.it"
      }
    },
