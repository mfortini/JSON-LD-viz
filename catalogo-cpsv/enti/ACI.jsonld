      "dct:description": {
        "@language": "it",
        "@value": "Il servizio fornisce, sulla base del numero di targa, le informazioni sullo stato giuridico attuale del veicolo (intestatario, vincoli/gravami) come risultante dalla banca dati del PRA."
      },
      "dct:modified": "22 Ottobre 2025",
      "aci:outputDescription": {
        "@language": "it",
        "@value": "La visura in formato digitale che non costituisce certificazione."
      },
      "aci:processingTime": {
        "@language": "it",
        "@value": "Il tempo di evasione è di 3-5 giorni lavorativi successivi alla ricezione della richiesta. Il costo è di euro 6,00 e in tal caso la ricevuta deve essere trasmessa via e-mail."
      },
      "aci:costDescription": {
        "@language": "it",
        "@value": "6,00 euro."
      },
