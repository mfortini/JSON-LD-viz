      "dct:description": {
        "@language": "it",
        "@value": "Il servizio consente di effettuare il pagamento delle somme di spettanza ACI ed è riservato esclusivamente agli operatori professionali (Agenzie, Studi di consulenza etc.) abilitati allo STA che come modalità di pagamento delle formalità telematiche utilizzano pagoPA."
      },
      "dct:modified": "25 Giugno 2025",
      "aci:outputDescription": {
        "@language": "it",
        "@value": "Effettuato e andato a buon fine il pagamento dei codici IUV (Identificativo Univoco di Versamento) le pratiche risulteranno pagate."
      },
      "aci:processingTime": {
        "@language": "it",
        "@value": "Quelli previsti dalla modalità di pagamento scelta (carta di credito/debito, bonifico, altri sistemi di pagamento come ad esempio PayPal)."
      },
      "aci:costDescription": {
        "@language": "it",
        "@value": "Il servizio è gratuito. Possono essere previste commissioni bancarie o postali, legate alla modalità di pagamento scelta."
      },
