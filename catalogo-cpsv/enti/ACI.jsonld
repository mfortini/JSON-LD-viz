      ],
      "cpsv-portalone:lifeEventMapping": {
        "cpsv-portalone:method": "aci-area-crosswalk",
        "cpsv-portalone:methodLabel": "Curato · area tematica ACI",
        "cpsv-portalone:confidence": "curated",
        "cpsv-portalone:badge": "aci",
        "cpsv-portalone:sourceField": "area_tematica",
        "cpsv-portalone:sourceValue": "Pratiche auto"
      },
      "dct:description": {
        "@language": "it",
        "@value": "Il servizio consiste nella fornitura di dati estratti dal Pubblico Registro Automobilistico (PRA) e relativi ai veicoli in esso registrati, strutturati in ragione di specifiche esigenze. Le informazioni possono essere fornite sia in forma analitica (targa, caratteristiche tecniche, dati anagrafici) sia in forma aggregata (statistiche di varia natura) e possono fare riferimento all’intero territorio nazionale oppure ad ambiti geografici precisi (regione, provincia, comune o CAP)."
      },
      "dct:modified": "21 Novembre 2024",
      "aci:outputDescription": {
        "@language": "it",
        "@value": "Si possono ottenere i principali dati tecnici (cilindrata, alimentazione, carrozzeria ecc.) del veicolo e i dati anagrafici degli intestatari dei veicoli (nel rispetto e nei limiti dettati dal GDPR), registrati nel Pubblico Registro Automobilistico."
      },
      "aci:processingTime": {
        "@language": "it",
        "@value": "Variano in base alla tipologia di fornitura dati richiesta."
      },
      "aci:costDescription": {
        "@language": "it",
        "@value": "Variano in base alla tipologia di fornitura dati richiesta."
      },
      "cpsv:hasWebSiteChannel": {
        "@id": "https://aci.gov.it/servizio/fornitura-dati-pra/#website-channel"
      },
