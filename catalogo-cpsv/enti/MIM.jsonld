    {
      "@id": "https://www.mim.gov.it/web/guest/accreditarmi-come-ente-di-formazione/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Accreditarmi come ente di formazione"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Accreditarmi come ente di formazione"
      },
      "cpsv:producedBy": {
        "@id": "https://www.mim.gov.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.mim.gov.it"
      },
      "foaf:page": "https://www.mim.gov.it/web/guest/accreditarmi-come-ente-di-formazione/",
      "dct:description": {
        "@language": "it",
        "@value": "La Direttiva 170 del 21 marzo 2016 disciplina le modalità di accreditamento, qualificazione e riconoscimento dei corsi proposti dai soggetti che offrono formazione per il personale del comparto scuola, certificando e assicurando la qualità delle iniziative formative. I soggetti interessati a ottenere uno dei suddetti riconoscimenti dal Miur, sono tenuti a presentare la domanda di accreditamento, di qualificazione o di riconoscimento di singoli percorsi secondo le modalità e i termini definiti all’interno della Direttiva 170. Presso il Ministero è istituita la piattaforma on-line (Piattaforma per la Governance della Formazione http://www.istruzione.it/pdgf/ ) S.O.F.I.A. per l’accreditamento, la qualificazione e il riconoscimento dei corsi dei soggetti che erogano la formazione e per l’incontro tra domanda e offerta di formazione (articolo 1 comma 2 della Direttiva 170). Dopo aver accolto e esaminato le domande pervenute, il Miur determina e aggiorna due elenchi contenenti:"
      },
      "cpsv:hasChannel": {
        "@id": "https://www.mim.gov.it/web/guest/accreditarmi-come-ente-di-formazione/#channel-online-0",
        "@type": "cpsv:OtherElectronicChannel",
        "foaf:page": "https://www.mim.gov.it/web/guest/accreditarmi-come-ente-di-formazione/"
      }
    },
    {
      "@id": "https://www.mim.gov.it/web/guest/acquistare-ausili-per-la-didattica-inclusiva/",
      "@type": "cpsv:PublicService",
