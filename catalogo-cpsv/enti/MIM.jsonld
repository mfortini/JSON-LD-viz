    {
      "@id": "https://www.mim.gov.it/web/guest/certificate-of-professional-qualification-as-a-teacher/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "How to have a professional qualification, including vocational education and training, recognised in Italy"
      },
      "dct:title": {
        "@language": "it",
        "@value": "How to have a professional qualification, including vocational education and training, recognised in Italy"
      },
      "cpsv:producedBy": {
        "@id": "https://www.mim.gov.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.mim.gov.it"
      },
      "foaf:page": "https://www.mim.gov.it/web/guest/certificate-of-professional-qualification-as-a-teacher/",
      "dct:description": {
        "@language": "it",
        "@value": "Teachers who have obtained their teaching qualification in ITALY and wish to pursue their profession abroad must ask the Ministry of Education and Merit for a certificate of their professional teaching qualification in accordance with Directive 2013/55/EU.\nPursuant to Directive 2013/55/EU, implemented in Italy by Legislative Decree No 15/ 2016, it is possible to submit a request for a certificate for the professions as: - nursery schoolteacher - primary school teacher - lower secondary school teacher - upper secondary school teacher\nThe application must be addressed, using the downloadable form and provided, with a revenue stamp to “Ministero dell’istruzione e del merito, Dipartimento per il sistema educativo di istruzione e formazione, Direzione Generale per gli ordinamenti scolastici, la formazione del personale scolastico e la valutazione del sistema nazionale di istruzione e formazione – Ufficio V”.\nApplications and the related documentation must be exclusively submitted online to the ordinary address: dgosvi.ufficio5@istruzione.it."
      },
      "cpsv:hasChannel": {
        "@id": "https://www.mim.gov.it/web/guest/certificate-of-professional-qualification-as-a-teacher/#channel-online-0",
        "@type": "cpsv:OtherElectronicChannel",
        "foaf:page": "https://www.mim.gov.it/web/guest/certificate-of-professional-qualification-as-a-teacher/"
      }
    },
