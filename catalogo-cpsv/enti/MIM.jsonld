      "foaf:page": "https://www.mim.gov.it/web/guest/comandi-presso-enti-e-associazioni/",
      "dct:description": {
        "@language": "it",
        "@value": "Comandi dei dirigenti scolastici e del personale docente a. s. 2026/2027 ai sensi dell'articolo 26, comma 8 della L. 23 dicembre 1998, n. 448 e dell'articolo 1, comma 65 della L. 13 luglio 2015, n. 107 Restano confermati i contingenti previsti per il triennio 2025/2026 - 2027/2028, ai sensi dell'articolo 26, comma 8, primo periodo, della legge 448/1998 e della nota circolare ministeriale prot. n. 71700 del 9 maggio 2025 e dei successivi decreti dipartimentali di ripartizione. Le assegnazioni dei dirigenti scolastici e del personale docente presso gli enti di prevenzione del disagio psico-sociale e presso le associazioni professionali dei dirigenti scolastici e del personale docente (art.26, comma 8, secondo e terzo periodo), per un totale di 150 unità Le assegnazioni dei docenti destinatari dei progetti nazionali nell’ambito dell’organico triennale dell’autonomia scolastica ai sensi del comma 65 dell’art. 1 della legge 107/15 nei medesimi limiti dei contingenti regionali definiti dal Decreto ministeriale numero 659 del 28 agosto 2016 (totale 732 unità)"
      },
      "cpsv:hasChannel": {
        "@id": "https://www.mim.gov.it/web/guest/comandi-presso-enti-e-associazioni/#channel-online-0",
        "@type": "cpsv:OtherElectronicChannel",
        "foaf:page": "https://www.mim.gov.it/web/guest/comandi-presso-enti-e-associazioni/"
      }
    },
    {
      "@id": "https://www.mim.gov.it/web/guest/come-fare-per-insegnare-all-estero/",
      "@type": "cpsv:PublicService",
