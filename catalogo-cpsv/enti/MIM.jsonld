      }
    },
    {
      "@id": "https://www.mim.gov.it/web/guest/come-farsi-riconoscere-in-italia-una-qualifica-professionale/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Come farsi riconoscere in Italia una qualifica professionale, compresa l’istruzione e la formazione professionale?"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Come farsi riconoscere in Italia una qualifica professionale, compresa l’istruzione e la formazione professionale?"
      },
      "cpsv:producedBy": {
        "@id": "https://www.mim.gov.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.mim.gov.it"
      },
      "foaf:page": "https://www.mim.gov.it/web/guest/come-farsi-riconoscere-in-italia-una-qualifica-professionale/",
      "dct:description": {
        "@language": "it",
        "@value": "Ultimo aggiornamento 16 novembre 2020\nIl sistema di riconoscimento dei titoli di studio osserva procedure diversificate in base ai settori formativi di riferimento, correlati alla competenza attribuita alle diverse istituzioni soggetti erogatori del servizio (Stato e Regioni).\nAi soli fini della partecipazione a pubblici concorsi i cittadini extracomunitari titolari di un permesso di soggiorno Ue per lungo soggiorno possono chiedere “l’equivalenza” del titolo di studio posseduto, valido ai soli fini della procedura concorsuale.\nDovrai presentare l’istanza di riconoscimento del titolo presso gli Uffici scolastici regionali corredata da:"
      },
      "cpsv:hasChannel": {
