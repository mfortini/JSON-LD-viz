    {
      "@id": "https://www.mim.gov.it/web/guest/anagrafe-nazionale-studenti/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Anagrafe nazionale degli studenti"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Anagrafe nazionale degli studenti"
      },
      "cpsv:producedBy": {
        "@id": "https://www.mim.gov.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.mim.gov.it"
      },
      "foaf:page": "https://www.mim.gov.it/web/guest/anagrafe-nazionale-studenti/",
      "dct:description": {
        "@language": "it",
        "@value": "L’Anagrafe Nazionale degli Studenti (ANS) è stata istituita, per il primo e secondo ciclo di istruzione, dall’art. 3 del Decreto Legislativo 76 del 15 aprile 2005 “Definizione delle norme generali sul diritto-dovere all’istruzione e alla formazione ai sensi dell’articolo 2, comma 1, lettera c) della legge 28 marzo 2003, n. 53” ai fini della realizzazione del diritto/dovere all’istruzione e alla formazione.\nSuccessivamente al DM 74 del 5 agosto 2010, n. 74, con cui è stata data prima attuazione al D. L.gs 76_2005 sono intervenuti diversi provvedimenti legislativi che hanno introdotto nuove finalizzazioni all’Anagrafe:\nIl DM 692 del 25_9_2017 riordina in un unico provvedimento la normativa di carattere secondario adottata nel tempo per la gestione dell’Anagrafe.\nUn patrimonio informativo indispensabile I dati dell’Anagrafe costituiscono un patrimonio informativo indispensabile per l’assolvimento dei compiti istituzionali del Ministero e per la valutazione del sistema scolastico. Ciascuna istituzione scolastica è tenuta a inserire e aggiornare i dati degli studenti sul portale SIDI nell’area Alunni. Tale area è raggiungibile da ciascuna istituzione scolastica che vede e gestisce…"
      },
      "cpsv:hasChannel": {
        "@id": "https://www.mim.gov.it/web/guest/anagrafe-nazionale-studenti/#channel-online-0",
        "@type": "cpsv:OtherElectronicChannel",
        "foaf:page": "https://www.mim.gov.it/web/guest/anagrafe-nazionale-studenti/"
      }
    },
