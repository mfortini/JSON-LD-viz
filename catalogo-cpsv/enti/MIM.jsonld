    {
      "@id": "https://www.mim.gov.it/web/guest/competizioni-sportive-scolastiche/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Competizioni sportive scolastiche"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Competizioni sportive scolastiche"
      },
      "cpsv:producedBy": {
        "@id": "https://www.mim.gov.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.mim.gov.it"
      },
      "foaf:page": "https://www.mim.gov.it/web/guest/competizioni-sportive-scolastiche/",
      "dct:description": {
        "@language": "it",
        "@value": "Le Competizioni sportive scolastiche sono organizzate dal Ministero dell’istruzione e del merito in collaborazione con Sport e Salute S.p.A., Comitato Olimpico Nazionale Italiano (CONI), Comitato Italiano Paralimpico (CIP), Federazioni Sportive Nazionali (FSN), Discipline Sportive Associate (DSA) riconosciute dal CONI, Federazioni Sportive e Discipline Sportive Associate riconosciute dal CIP, e con le Regioni e gli Enti locali.\nDal 13 dicembre 2024 e sino al 20 gennaio 2025, le Istituzioni scolastiche che intendono partecipare alle attività di avviamento alla pratica sportiva e alle Competizioni sportive scolastiche devono registrarsi sulla piattaforma dedicata, reperibile al link https://competizionisportivescolastiche.it nella quale è altresì presente ogni utile documentazione relativa a ciascuna disciplina sportiva."
      },
      "cpsv:hasChannel": {
        "@id": "https://www.mim.gov.it/web/guest/competizioni-sportive-scolastiche/#channel-online-0",
        "@type": "cpsv:OtherElectronicChannel",
        "foaf:page": "https://www.mim.gov.it/web/guest/competizioni-sportive-scolastiche/"
      }
    },
