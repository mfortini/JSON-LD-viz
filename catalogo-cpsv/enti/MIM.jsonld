    {
      "@id": "https://www.mim.gov.it/web/guest/cug/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Parità di genere: l'impegno strategico della Commissione europea per il triennio 2016-2019"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Parità di genere: l'impegno strategico della Commissione europea per il triennio 2016-2019"
      },
      "cpsv:producedBy": {
        "@id": "https://www.mim.gov.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.mim.gov.it"
      },
      "foaf:page": "https://www.mim.gov.it/web/guest/cug/",
      "dct:description": {
        "@language": "it",
        "@value": "Parità di genere: l'impegno strategico della Commissione europea per il triennio 2016-2019\nL'impegno strategico per la parità di genere della Commissione europea per il triennio 2016-2019 volge al termine e la Commissione ha lanciato una consultazione pubblica per ricevere input sulle priorità di una possibile nuova strategia.\nUn invito che la Commissione rivolge a: pubbliche autorità e amministrazioni, associazioni, organismi nazionali per la parità, ispettorati del lavoro, organizzazioni non governative, organizzazioni di ricerca, accademiche e università, cittadine e cittadini, società civile.\nL'obiettivo della consultazione, spiega la Commissione, è raccogliere opinioni rispetto alla parità di genere all'interno dell'Unione europea come una priorità del presente e prospettiva per il futuro. Le opinioni raccolte aiuteranno la prossima Commissione a definire le priorità politiche successive."
      },
      "cpsv:hasChannel": {
        "@id": "https://www.mim.gov.it/web/guest/cug/#channel-online-0",
        "@type": "cpsv:OtherElectronicChannel",
        "foaf:page": "https://www.mim.gov.it/web/guest/cug/"
      }
    },
