        "@language": "it",
        "@value": "Intelligenza artificiale, blockchain e internet of things"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Intelligenza artificiale, blockchain e internet of things"
      },
      "cpsv:producedBy": {
        "@id": "https://www.mimit.gov.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.mimit.gov.it"
      },
      "foaf:page": "https://www.mimit.gov.it/it/incentivi/fondo-per-interventi-volti-a-favorire-lo-sviluppo-delle-tecnologie-e-delle-applicazioni-di-intelligenza-artificiale-blockchain-e-internet-of-things/",
      "dct:description": {
        "@language": "it",
        "@value": "Il Fondo per lo sviluppo delle tecnologie e delle applicazioni di intelligenza artificiale, blockchain e internet of things è stato istituito dalla legge di bilancio 2019 (art. 1, comma 226), con una dotazione complessiva pari a 45 milioni di euro. I criteri e le modalità di utilizzo delle risorse sono stati definiti con il decreto interministeriale 6 dicembre 2021 . Con decreto direttoriale 24 giugno 2022 sono stati stabiliti i termini e le modalità per la presentazione delle domande di agevolazione, nonché i criteri per la concessione e l’erogazione delle agevolazioni."
      },
      "cv:addressee": {
        "@id": "https://www.mimit.gov.it/it/incentivi/fondo-per-interventi-volti-a-favorire-lo-sviluppo-delle-tecnologie-e-delle-applicazioni-di-intelligenza-artificiale-blockchain-e-internet-of-things#addressee"
      },
