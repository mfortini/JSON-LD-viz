    {
      "@id": "https://www.mimit.gov.it/it/incentivi/green-new-deal/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Green New Deal"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Green New Deal"
      },
      "cpsv:producedBy": {
        "@id": "https://www.mimit.gov.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.mimit.gov.it"
      },
      "foaf:page": "https://www.mimit.gov.it/it/incentivi/green-new-deal/",
      "dct:description": {
        "@language": "it",
        "@value": "L'incentivo sostiene con agevolazioni finanziarie la realizzazione di progetti di ricerca, sviluppo e innovazione nell’ambito delle finalità di transizione ecologica e circolare del Green New Deal italiano.\nLa misura è destinata al sostegno dei progetti di imprese ammesse ai finanziamenti agevolati del FRI (Fondo rotativo per il sostegno alle imprese e gli investimenti in ricerca), e prevede la concessione di contributi a sostegno delle attività di ricerca industriale, sviluppo sperimentale e, per le PMI, di industrializzazione dei risultati della ricerca e sviluppo.\nL'intervento, realizzato nell'ambito del Fondo per la crescita sostenibile (FCS), è disciplinato dal decreto 1° dicembre 2021 del Ministro dello sviluppo economico di concerto con il Ministro dell’economia e delle finanze."
      },
      "cpsv:hasChannel": {
        "@id": "https://www.mimit.gov.it/it/incentivi/green-new-deal/#channel-online-0",
        "@type": "cpsv:OtherElectronicChannel",
        "foaf:page": "https://www.mimit.gov.it/it/incentivi/green-new-deal/"
      }
    },
