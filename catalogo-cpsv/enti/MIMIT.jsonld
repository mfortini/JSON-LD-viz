        "@language": "it",
        "@value": "Gela - Area di crisi industriale (2019)"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Gela - Area di crisi industriale (2019)"
      },
      "cpsv:producedBy": {
        "@id": "https://www.mimit.gov.it"
      },
      "cv:hasCompetentAuthority": {
