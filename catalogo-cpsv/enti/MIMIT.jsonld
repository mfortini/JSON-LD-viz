    {
      "@id": "https://www.mimit.gov.it/it/incentivi/credito-d-imposta-societa-benefit/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Credito d’imposta Società Benefit"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Credito d’imposta Società Benefit"
      },
      "cpsv:producedBy": {
        "@id": "https://www.mimit.gov.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.mimit.gov.it"
      },
      "foaf:page": "https://www.mimit.gov.it/it/incentivi/credito-d-imposta-societa-benefit/",
      "dct:description": {
        "@language": "it",
        "@value": "Al fine di sostenere il rafforzamento del sistema delle società benefit nell'intero territorio nazionale, il decreto-legge 19 maggio 2020, n. 34 ha previsto la concessione, a titolo di de minimis, di un credito d’imposta nella misura del 50% delle spese di costituzione o trasformazione sostenute dalle società benefit (articolo 38-ter, comma 1). L'importo massimo utilizzabile in compensazione da ciascun beneficiario non può eccedere l’importo di 10 mila euro (articolo 38-ter, comma 2-bis)."
      },
      "cpsv:hasChannel": {
