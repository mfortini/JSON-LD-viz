    {
      "@id": "https://www.mimit.gov.it/it/incentivi/bando-valorizzazione-brevetti-poc/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Bando valorizzazione brevetti (PoC)"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Bando valorizzazione brevetti (PoC)"
      },
      "cpsv:producedBy": {
        "@id": "https://www.mimit.gov.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.mimit.gov.it"
      },
      "foaf:page": "https://www.mimit.gov.it/it/incentivi/bando-valorizzazione-brevetti-poc/",
      "dct:description": {
        "@language": "it",
        "@value": "Il bando Proof of concept (PoC) finanzia attività di valorizzazione dei brevetti.\nL'obiettivo della misura, finanziata con risorse del PNRR, è innalzare il livello di maturità delle invenzioni brevettate dal sistema della ricerca per rendere possibili azioni di sviluppo anche, e soprattutto, da parte delle imprese."
      },
      "cv:addressee": {
