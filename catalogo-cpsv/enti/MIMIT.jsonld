        "@value": "Aiuti di stato concessi sotto forma di garanzie: determinazione del premio teorico di mercato di una garanzia e dell’ESL"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Aiuti di stato concessi sotto forma di garanzie: determinazione del premio teorico di mercato di una garanzia e dell’ESL"
      },
      "cpsv:producedBy": {
