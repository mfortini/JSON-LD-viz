        "@id": "https://www.mimit.gov.it/it/incentivi/zone-franche-urbane/#channel-online-0",
        "@type": "cpsv:OtherElectronicChannel",
        "foaf:page": "https://www.mimit.gov.it/it/incentivi/zone-franche-urbane/"
      }
    }
