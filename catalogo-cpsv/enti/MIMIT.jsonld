    {
      "@id": "https://www.mimit.gov.it/it/incentivi/marchi-2024/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Marchi + 2024"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Marchi + 2024"
      },
      "cpsv:producedBy": {
        "@id": "https://www.mimit.gov.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.mimit.gov.it"
      },
      "foaf:page": "https://www.mimit.gov.it/it/incentivi/marchi-2024/",
      "dct:description": {
        "@language": "it",
        "@value": "La misura Marchi+2024 è l’intervento che intende supportare le imprese di micro, piccola e media dimensione nella tutela dei marchi all’estero mediante agevolazioni concesse nella forma di contributo in conto capitale, attraverso le seguenti misure agevolative:\nMisura A - Agevolazioni per favorire la registrazione di marchi dell’Unione europea presso EUIPO (Ufficio dell’Unione europea per la Proprietà Intellettuale) attraverso l’acquisto di servizi specialistici esterni;\nMisura B - Agevolazioni per favorire la registrazione di marchi internazionali presso OMPI (Organizzazione Mondiale per la Proprietà Intellettuale) attraverso l’acquisto di servizi specialistici esterni.\nLa dotazione finanziaria, riferita all’annualità 2024 e stanziata per l’attuazione dell’intervento, è pari a 2 milioni di euro."
      },
      "cpsv:hasChannel": {
        "@id": "https://www.mimit.gov.it/it/incentivi/marchi-2024/#channel-online-0",
        "@type": "cpsv:OtherElectronicChannel",
        "foaf:page": "https://www.mimit.gov.it/it/incentivi/marchi-2024/"
      }
    },
