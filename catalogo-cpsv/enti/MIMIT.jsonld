      "@id": "https://www.mimit.gov.it/it/incentivi/semiconduttori/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Contratti di sviluppo – Nuovo sportello Semiconduttori"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Contratti di sviluppo – Nuovo sportello Semiconduttori"
      },
      "cpsv:producedBy": {
        "@id": "https://www.mimit.gov.it"
