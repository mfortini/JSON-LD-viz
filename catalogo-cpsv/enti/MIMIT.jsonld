    {
      "@id": "https://www.mimit.gov.it/it/incentivi/nascita-e-sviluppo-di-societa-cooperative-di-piccola-e-media-dimensione-nuova-marcora/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Nascita e sviluppo di società cooperative di piccola e media dimensione (Nuova Marcora 2014)"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Nascita e sviluppo di società cooperative di piccola e media dimensione (Nuova Marcora 2014)"
      },
      "cpsv:producedBy": {
        "@id": "https://www.mimit.gov.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.mimit.gov.it"
      },
      "foaf:page": "https://www.mimit.gov.it/it/incentivi/nascita-e-sviluppo-di-societa-cooperative-di-piccola-e-media-dimensione-nuova-marcora/",
      "dct:description": {
        "@language": "it",
        "@value": "Per la concessione dei finanziamenti agevolati le risorse ammontano, complessivamente, a circa 9,8 milioni di euro.\nI finanziamenti agevolati sono concessi al fine di sostenere:\nsull’intero territorio nazionale, la nascita di società cooperative costituite, in misura prevalente, da lavoratori provenienti da aziende in crisi, di società cooperative sociali di cui alla legge 8 novembre 1991, n. 381 e successive integrazioni e modificazioni e di società cooperative che gestiscono aziende confiscate alla criminalità organizzata; nei territori delle Regioni del Mezzogiorno, oltre a quanto previsto al punto precedente, lo sviluppo o la ristrutturazione di società cooperative esistenti.\nI finanziamenti agevolati hanno una durata massima di 10 anni, sono regolati a un tasso di interesse pari al 20% del tasso comunitario di riferimento e hanno un importo massimo non superiore a 4 volte il valore della partecipazione detenuta dalla società finanziaria nella società cooperativa beneficiaria (importo comunque non superiore a euro 1.000.000,00)."
      },
      "cpsv:hasChannel": {
        "@id": "https://www.mimit.gov.it/it/incentivi/nascita-e-sviluppo-di-societa-cooperative-di-piccola-e-media-dimensione-nuova-marcora/#channel-online-0",
        "@type": "cpsv:OtherElectronicChannel",
        "foaf:page": "https://www.mimit.gov.it/it/incentivi/nascita-e-sviluppo-di-societa-cooperative-di-piccola-e-media-dimensione-nuova-marcora/"
      }
    },
