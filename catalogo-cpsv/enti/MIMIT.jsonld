        "@language": "it",
        "@value": "Credito d’imposta per la quotazione delle PMI"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Credito d’imposta per la quotazione delle PMI"
      },
      "cpsv:producedBy": {
