    {
      "@id": "https://www.mimit.gov.it/it/incentivi/voucher-per-consulenza-in-innovazione/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Voucher per consulenza in innovazione - primo sportello (2019)"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Voucher per consulenza in innovazione - primo sportello (2019)"
      },
      "cpsv:producedBy": {
        "@id": "https://www.mimit.gov.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.mimit.gov.it"
      },
      "foaf:page": "https://www.mimit.gov.it/it/incentivi/voucher-per-consulenza-in-innovazione/",
      "dct:description": {
        "@language": "it",
        "@value": "La misura Voucher per consulenza in innovazione è l’intervento che, in coerenza con il Piano nazionale “Impresa 4.0”, sostiene i processi di trasformazione tecnologica e digitale delle PMI e delle reti di impresa di tutto il territorio nazionale attraverso l’introduzione in azienda di figure manageriali in grado di implementare le tecnologie abilitanti previste dal Piano Nazionale Impresa 4.0, nonché di ammodernare gli assetti gestionali e organizzativi dell’impresa, compreso l’accesso ai mercati finanziari e dei capitali.\nLa dotazione finanziaria stanziata per l’attuazione dell’intervento è pari a 75 milioni di euro ripartita per ciascuna delle annualità 2019, 2020, e 2021."
      },
      "cpsv:hasChannel": {
        "@id": "https://www.mimit.gov.it/it/incentivi/voucher-per-consulenza-in-innovazione/#channel-online-0",
        "@type": "cpsv:OtherElectronicChannel",
        "foaf:page": "https://www.mimit.gov.it/it/incentivi/voucher-per-consulenza-in-innovazione/"
      }
    },
