    {
      "@id": "https://www.mimit.gov.it/it/incentivi/aiuti-per-l-area-di-crisi-industriale-complessa-di-savona/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Savona - Area di crisi industriale (2018)"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Savona - Area di crisi industriale (2018)"
      },
      "cpsv:producedBy": {
        "@id": "https://www.mimit.gov.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.mimit.gov.it"
      },
      "foaf:page": "https://www.mimit.gov.it/it/incentivi/aiuti-per-l-area-di-crisi-industriale-complessa-di-savona/",
      "dct:description": {
        "@language": "it",
        "@value": "Con circolare direttoriale 20 aprile 2018, n. 183965 (pdf) è stato attivato l’intervento ai sensi della legge n. 181/1989.\nLa misura, in sintesi, promuove la realizzazione di una o più iniziative imprenditoriali nel territorio dei Comuni riportati nell’allegato n. 1 alla circolare, finalizzate al rafforzamento del tessuto produttivo locale e all’attrazione di nuovi investimenti.\nLe risorse finanziarie disponibili ai fini della concessione delle agevolazioni ammontano a 20 milioni di euro a valere sulle risorse della legge n. 181/1989.\nLe domande di accesso alle agevolazioni potranno essere presentate all’Agenzia nazionale per l’attrazione degli investimenti e lo sviluppo di impresa S.p.a. – Invitalia, secondo le modalità e i modelli indicati nell’apposita sezione dedicata alla legge n. 181/1989 del sito internet dell’Agenzia medesima ( www.invitalia.it ) a partire dalle ore 12.00 del 2 luglio 2018 .\nCon circolare direttoriale 11 settembre 2018, n. 286862 (pdf) il termine finale di presentazione delle domande è stato prorogato alle ore 12.00 del 1° ottobre 2018 ."
      },
      "cpsv:hasChannel": {
        "@id": "https://www.mimit.gov.it/it/incentivi/aiuti-per-l-area-di-crisi-industriale-complessa-di-savona/#channel-online-0",
        "@type": "cpsv:OtherElectronicChannel",
        "foaf:page": "https://www.mimit.gov.it/it/incentivi/aiuti-per-l-area-di-crisi-industriale-complessa-di-savona/"
      }
    },
