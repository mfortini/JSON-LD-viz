      "@id": "https://www.mimit.gov.it/it/incentivi/ecobonus-automotive#addressee",
      "@type": "cv:Agent",
      "dct:description": {
        "@language": "it",
        "@value": "Il contributo è rivolto alle persone fisiche o giuridiche, che intendono acquistare veicoli non inquinanti.\nIl contributo sarà prenotato dal concessionario."
      }
    },
    {
      "@id": "https://www.mimit.gov.it/it/incentivi/ecobonus-automotive/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Ecobonus - Mobilità sostenibile"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Ecobonus - Mobilità sostenibile"
      },
      "cpsv:producedBy": {
        "@id": "https://www.mimit.gov.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.mimit.gov.it"
      },
      "foaf:page": "https://www.mimit.gov.it/it/incentivi/ecobonus-automotive/",
      "dct:description": {
        "@language": "it",
        "@value": "L'ecobonus automotive è la misura promossa del Ministero per favorire l’acquisto di veicoli a ridotte emissioni.\nL'incentivo riguarda l'acquisto di veicoli non inquinanti di categoria:\nM1 (autoveicoli) L1e - L7e (motocicli e ciclomotori) N1 e N2 (veicoli commerciali).\nIl contributo viene riconosciuto come minor prezzo praticato dal concessionario in fattura al momento dell’acquisto.\nLa misura ha una finalità ambientale ed è gestita da Invitalia."
      },
      "cv:addressee": {
        "@id": "https://www.mimit.gov.it/it/incentivi/ecobonus-automotive#addressee"
      },
