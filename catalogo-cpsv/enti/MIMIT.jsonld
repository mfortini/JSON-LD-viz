    {
      "@id": "https://www.mimit.gov.it/it/incentivi/tutela-prodotti-igp-non-agroalimentari/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Tutela prodotti IGP non agroalimentari"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Tutela prodotti IGP non agroalimentari"
      },
      "cpsv:producedBy": {
        "@id": "https://www.mimit.gov.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.mimit.gov.it"
      },
      "foaf:page": "https://www.mimit.gov.it/it/incentivi/tutela-prodotti-igp-non-agroalimentari/",
      "dct:description": {
        "@language": "it",
        "@value": "Il bando intende favorire l'accesso alla nuova tutela europea per le Indicazioni Geografiche Protette (IGP).\nA partire dal 1° dicembre 2025, infatti, la predisposizione del disciplinare sarà condizione necessaria per presentare la domanda di registrazione di un’IGP per prodotti artigianali e industriali.\nCiò permetterà di estendere alle produzioni non agroalimentari le stesse tutele previste a oggi per il settore agroalimentare, consentendo di promuovere a livello internazionale i territori e le produzioni locali e regionali."
      },
      "cpsv:hasChannel": {
        "@id": "https://www.mimit.gov.it/it/incentivi/tutela-prodotti-igp-non-agroalimentari/#channel-online-0",
