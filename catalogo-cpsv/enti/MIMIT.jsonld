    {
      "@id": "https://www.mimit.gov.it/it/incentivi/calcolo-ad-alte-prestazioni-euro-hpc/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Calcolo ad alte prestazioni (EURO HPC)"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Calcolo ad alte prestazioni (EURO HPC)"
      },
      "cpsv:producedBy": {
        "@id": "https://www.mimit.gov.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.mimit.gov.it"
      },
      "foaf:page": "https://www.mimit.gov.it/it/incentivi/calcolo-ad-alte-prestazioni-euro-hpc/",
      "dct:description": {
        "@language": "it",
        "@value": "È una partnership europea - a cui partecipano Unione Europea (rappresentata dalla Commissione), Stati membri e partners privati - che ha lo scopo di implementare e sostenere l’adozione di un sistema di supercalcolo innovativo e competitivo, nonché di ampliare l’uso dell’infrastruttura di supercalcolo a un gran numero di utenti pubblici e privati."
      },
      "cpsv:hasChannel": {
        "@id": "https://www.mimit.gov.it/it/incentivi/calcolo-ad-alte-prestazioni-euro-hpc/#channel-online-0",
        "@type": "cpsv:OtherElectronicChannel",
        "foaf:page": "https://www.mimit.gov.it/it/incentivi/calcolo-ad-alte-prestazioni-euro-hpc/"
      }
    },
    {
      "@id": "https://www.mimit.gov.it/it/incentivi/eurohpc-ju-iniziativa-tecnologica-congiunta-nel-settore-del-calcolo-ad-alte-prestazioni/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Calcolo ad alte prestazioni (EuroHPC JU)"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Calcolo ad alte prestazioni (EuroHPC JU)"
      },
      "cpsv:producedBy": {
        "@id": "https://www.mimit.gov.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.mimit.gov.it"
      },
      "foaf:page": "https://www.mimit.gov.it/it/incentivi/eurohpc-ju-iniziativa-tecnologica-congiunta-nel-settore-del-calcolo-ad-alte-prestazioni/",
      "dct:description": {
        "@language": "it",
        "@value": "EuroHPC (European High Performance Computing) rappresenta il pilastro portante della strategia industriale dell'Unione europea nel campo del supercalcolo e dell’elaborazione dei dati e che, attraverso il finanziamento di progetti innovativi, si pone il duplice obiettivo di sviluppare un’infrastruttura di supercalcolo paneuropea e di sostenere la cooperazione nella ricerca scientifica avanzata al fine di aumentare la competitività industriale e di garantire, al contempo, l'autonomia tecnologica e digitale europea.\nEuroHPC è implementata tramite l’omonima impresa comune (JOINT UNDERTAKING - JU), iniziativa congiunta tra l'Unione Europea, i paesi europei e partner privati, istituita ai sensi del regolamento (UE) n. 2018/1488 e ss.mm.ii. del Consiglio europeo, pubblicato nella Gazzetta Ufficiale dell’Unione europea L. n. 252 in data 8 ottobre 2018."
      },
      "cpsv:hasChannel": {
        "@id": "https://www.mimit.gov.it/it/incentivi/eurohpc-ju-iniziativa-tecnologica-congiunta-nel-settore-del-calcolo-ad-alte-prestazioni/#channel-online-0",
        "@type": "cpsv:OtherElectronicChannel",
        "foaf:page": "https://www.mimit.gov.it/it/incentivi/eurohpc-ju-iniziativa-tecnologica-congiunta-nel-settore-del-calcolo-ad-alte-prestazioni/"
      }
    },
