    {
      "@id": "https://www.mimit.gov.it/it/incentivi/scoperta-imprenditoriale#addressee",
      "@type": "cv:Agent",
      "dct:description": {
        "@language": "it",
        "@value": "Possono beneficiare delle agevolazioni le imprese di qualsiasi dimensione con almeno due bilanci approvati al momento della presentazione della domanda di agevolazioni, che esercitano attività industriali, agroindustriali, artigiane, di servizi all’industria (attività di cui all’art. 2195 del codice civile, numeri 1, 3 e 5), e i Centri di ricerca. Gli Organismi di ricerca possono essere co-proponenti di un progetto congiunto con i citati soggetti."
      }
    },
    {
      "@id": "https://www.mimit.gov.it/it/incentivi/scoperta-imprenditoriale/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Scoperta imprenditoriale (2023)"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Scoperta imprenditoriale (2023)"
      },
      "cpsv:producedBy": {
        "@id": "https://www.mimit.gov.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.mimit.gov.it"
      },
      "foaf:page": "https://www.mimit.gov.it/it/incentivi/scoperta-imprenditoriale/",
      "dct:description": {
        "@language": "it",
        "@value": "L’intervento, realizzato nell'ambito del Programma Nazionale Ricerca, Innovazione e Competitività 2021-27 , sostiene progetti di ricerca e sviluppo, da realizzare nei territori delle Regioni meno sviluppate.\nI progetti devono essere coerenti con le aree tematiche della Strategia nazionale di specializzazione intelligente ovvero finalizzati a individuare traiettorie tecnologiche e applicative evolutive della stessa."
      },
      "cv:addressee": {
        "@id": "https://www.mimit.gov.it/it/incentivi/scoperta-imprenditoriale#addressee"
      },
      "cpsv:hasChannel": {
        "@id": "https://www.mimit.gov.it/it/incentivi/scoperta-imprenditoriale/#channel-online-0",
        "@type": "cpsv:OtherElectronicChannel",
        "foaf:page": "https://www.mimit.gov.it/it/incentivi/scoperta-imprenditoriale/"
      }
    },
    {
      "@id": "https://www.mimit.gov.it/it/incentivi/scoperta-imprenditoriale-2026#addressee",
      "@type": "cv:Agent",
      "dct:description": {
        "@language": "it",
        "@value": "Possono beneficiare delle agevolazioni le imprese di qualsiasi dimensione con almeno due bilanci approvati al momento della presentazione della domanda di agevolazioni, che esercitano attività industriali, agroindustriali, artigiane e i Centri di ricerca. Gli Organismi di ricerca, le imprese agricole e le imprese di servizi all’industria possono essere co-proponenti di un progetto congiunto con i citati soggetti."
      }
    },
    {
      "@id": "https://www.mimit.gov.it/it/incentivi/scoperta-imprenditoriale-2026/",
