    {
      "@id": "https://www.mimit.gov.it/it/incentivi/scoperta-imprenditoriale/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Scoperta imprenditoriale (2023)"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Scoperta imprenditoriale (2023)"
      },
      "cpsv:producedBy": {
        "@id": "https://www.mimit.gov.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.mimit.gov.it"
      },
      "foaf:page": "https://www.mimit.gov.it/it/incentivi/scoperta-imprenditoriale/",
      "dct:description": {
        "@language": "it",
        "@value": "L’intervento, realizzato nell'ambito del Programma Nazionale Ricerca, Innovazione e Competitività 2021-27 , sostiene progetti di ricerca e sviluppo, da realizzare nei territori delle Regioni meno sviluppate.\nI progetti devono essere coerenti con le aree tematiche della Strategia nazionale di specializzazione intelligente ovvero finalizzati a individuare traiettorie tecnologiche e applicative evolutive della stessa."
      },
      "cpsv:hasChannel": {
