      },
      "dct:title": {
        "@language": "it",
        "@value": "Brevetti + 2024"
      },
      "cpsv:producedBy": {
        "@id": "https://www.mimit.gov.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.mimit.gov.it"
      },
      "foaf:page": "https://www.mimit.gov.it/it/incentivi/brevetti-2024/",
      "dct:description": {
        "@language": "it",
        "@value": "La misura Brevetti + 2024 è l’intervento che intende favorire lo sviluppo di una strategia brevettuale e l’accrescimento della capacità competitiva delle micro, piccole e medie imprese, attraverso la concessione ed erogazione di incentivi per l’acquisto di servizi specialistici finalizzati alla valorizzazione economica di un brevetto in termini di redditività, produttività e sviluppo di mercato.\nLa dotazione finanziaria, riferita all’annualità 2024 e stanziata per l’attuazione dell’intervento, è pari a 20 milioni di euro."
      },
      "cpsv:hasChannel": {
        "@id": "https://www.mimit.gov.it/it/incentivi/brevetti-2024/#channel-online-0",
        "@type": "cpsv:OtherElectronicChannel",
        "foaf:page": "https://www.mimit.gov.it/it/incentivi/brevetti-2024/"
      }
    },
