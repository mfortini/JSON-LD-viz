      },
      "dct:title": {
        "@language": "it",
        "@value": "Contratti di sviluppo – Investimenti per sostenibilità processi produttivi"
      },
      "cpsv:producedBy": {
        "@id": "https://www.mimit.gov.it"
      },
      "cv:hasCompetentAuthority": {
