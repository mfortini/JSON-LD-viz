    {
      "@id": "https://www.mimit.gov.it/it/incentivi/contratti-di-sviluppo-nuovo-sportello-filiere-produttive/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Contratti di sviluppo – Nuovo sportello “Filiere produttive”"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Contratti di sviluppo – Nuovo sportello “Filiere produttive”"
      },
      "cpsv:producedBy": {
        "@id": "https://www.mimit.gov.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.mimit.gov.it"
      },
      "foaf:page": "https://www.mimit.gov.it/it/incentivi/contratti-di-sviluppo-nuovo-sportello-filiere-produttive/",
      "dct:description": {
        "@language": "it",
        "@value": "Le imprese devono presentare domanda in via telematica accedendo alla piattaforma predisposta da Invitalia.\nIn sostituzione del consueto criterio cronologico con il quale vengono considerate le domande di Contratto di sviluppo, è prevista la formazione di una graduatoria per la determinazione dell’ordine di avvio all’istruttoria, basata su specifici criteri di valutazione dei programmi, in ordine di importanza:\nl’innovatività del programma di sviluppo, con la valorizzazione delle spese in beni strumentali coerenti con il piano Transizione 4.0, rispetto al totale degli investimenti previsti; l’impatto occupazionale connesso al programma realizzato, con particolare riguardo all’impiego di personale in possesso di laurea in discipline di ambito tecnico o scientifico; il coinvolgimento di piccole e medie imprese nel programma di sviluppo.\nIl punteggio complessivo ottenuto potrà poi essere incrementato – fino ad un massimo del 10% - per le imprese in possesso:\ndel rating di legalità (5%); di almeno una certificazione ambientale (EMAS, ISO 140001, ISO 50001) (5%).\nLe istanze prive di copertura finanziaria saranno considerate decadute."
      },
      "cpsv:hasChannel": {
        "@id": "https://www.mimit.gov.it/it/incentivi/contratti-di-sviluppo-nuovo-sportello-filiere-produttive/#channel-online-0",
        "@type": "cpsv:OtherElectronicChannel",
        "foaf:page": "https://www.mimit.gov.it/it/incentivi/contratti-di-sviluppo-nuovo-sportello-filiere-produttive/"
      }
    },
