    {
      "@id": "https://www.mimit.gov.it/it/incentivi/piano-operativo-imprese-e-competitivita-fsc-2014-2020/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Piano operativo imprese e competitività FSC 2014-2020"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Piano operativo imprese e competitività FSC 2014-2020"
      },
      "cpsv:producedBy": {
        "@id": "https://www.mimit.gov.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.mimit.gov.it"
      },
      "foaf:page": "https://www.mimit.gov.it/it/incentivi/piano-operativo-imprese-e-competitivita-fsc-2014-2020/",
      "dct:description": {
        "@language": "it",
        "@value": "Rilancio della propensione agli investimenti del sistema produttivo: (Contratti di sviluppo e Fondo di reindustrializzazione) finalizzato a favorire la realizzazione di progetti di investimento strategici per lo sviluppo del paese sia in ambito industriale, dei servizi e in quello turistico. (dotazione finanziaria: € 1.945.610.000,00) Iniziativa PMI : complemento nazionale al PON Iniziativa PMI 2014-2020 finalizzato ad ampliare le opportunità di accesso al credito delle PMI meridionali (dotazione finanziaria: € 100.000.000,00)"
      },
      "cpsv:hasChannel": {
        "@id": "https://www.mimit.gov.it/it/incentivi/piano-operativo-imprese-e-competitivita-fsc-2014-2020/#channel-online-0",
