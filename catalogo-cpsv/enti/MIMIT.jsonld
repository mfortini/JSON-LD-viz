      },
      "dct:title": {
        "@language": "it",
        "@value": "Toscana - Area di crisi industriale (alluvione ottobre-novembre 2023)"
      },
      "cpsv:producedBy": {
        "@id": "https://www.mimit.gov.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.mimit.gov.it"
      },
      "foaf:page": "https://www.mimit.gov.it/it/incentivi/toscana-area-di-crisi-industriale-alluvione-2023/",
      "dct:description": {
        "@language": "it",
        "@value": "Con la circolare direttoriale 7 giugno 2024, n. 713 , è stato pubblicato l’Avviso pubblico per la selezione di iniziative imprenditoriali nei territori della Regione Toscana interessati dagli eventi alluvionali di cui all'articolo 18, comma 1, del decreto-legge 9 dicembre 2023, n. 181 (convertito, con modificazioni, dalla legge 2 febbraio 2024, n. 11) tramite ricorso al regime di aiuto di cui alla legge n. 181/1989 .\nLa misura, in sintesi, promuove la realizzazione di una o più iniziative imprenditoriali nei territori della Regione Toscana interessati dagli eventi alluvionali verificatisi a partire dal 29 ottobre 2023, finalizzate al rafforzamento del tessuto produttivo locale e all’attrazione di nuovi investimenti.\nI Comuni interessati dagli eventi alluvionali sono riportati nell'allegato 1 della circolare 7 giugno 2024 ."
      },
      "cpsv:hasChannel": {
        "@id": "https://www.mimit.gov.it/it/incentivi/toscana-area-di-crisi-industriale-alluvione-2023/#channel-online-0",
