        "@type": "cpsv:OtherElectronicChannel",
        "foaf:page": "https://www.mimit.gov.it/it/incentivi/scoperta-imprenditoriale/"
      }
    },
    {
      "@id": "https://www.mimit.gov.it/it/incentivi/scoperta-imprenditoriale-2026/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Scoperta imprenditoriale II (2026)"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Scoperta imprenditoriale II (2026)"
      },
      "cpsv:producedBy": {
        "@id": "https://www.mimit.gov.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.mimit.gov.it"
      },
      "foaf:page": "https://www.mimit.gov.it/it/incentivi/scoperta-imprenditoriale-2026/",
      "dct:description": {
        "@language": "it",
        "@value": "Il decreto ministeriale 19 maggio 2026 disciplina l’intervento del Fondo per la crescita sostenibile a sostegno di progetti di ricerca e sviluppo, da realizzare nei territori delle Regioni meno sviluppate, coerenti con le aree tematiche della Strategia nazionale di specializzazione intelligente ovvero finalizzati a individuare traiettorie tecnologiche e applicative evolutive della stessa."
      },
