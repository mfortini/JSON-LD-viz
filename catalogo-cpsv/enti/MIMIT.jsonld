      },
      "dct:title": {
        "@language": "it",
        "@value": "Bonus colonnine domestiche"
      },
      "cpsv:producedBy": {
        "@id": "https://www.mimit.gov.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.mimit.gov.it"
      },
      "foaf:page": "https://www.mimit.gov.it/it/incentivi/bonus-colonnine-domestiche/",
      "dct:description": {
        "@language": "it",
        "@value": "Il bonus colonnine domestiche è un contributo pari all’80% del prezzo di acquisto e posa delle infrastrutture per la ricarica dei veicoli alimentati ad energia elettrica (come, ad esempio, colonnine o wall box).\nIl limite massimo del contributo è di 1.500 euro per gli utenti privati e fino a 8.000 euro in caso di installazione sulle parti comuni degli edifici condominiali."
      },
      "cv:addressee": {
        "@id": "https://www.mimit.gov.it/it/incentivi/bonus-colonnine-domestiche#addressee"
      },
      "mimit:howTo": {
        "@language": "it",
        "@value": "Gli interessati possono presentare la domanda tramite la piattaforma online, all’indirizzo indicato prima dell'apertura dello sportello.\nL’accesso può essere effettuato tramite sistema pubblico di identità digitale (SPID), carta d’identità elettronica (CIE) o carta nazionale dei servizi (CNS). Una volta effettuato l’accesso si può procedere alla compilazione del modulo elettronico seguendo la procedura guidata."
      },
      "cpsv:hasChannel": {
        "@id": "https://www.mimit.gov.it/it/incentivi/bonus-colonnine-domestiche/#channel-online-0",
        "@type": "cpsv:OtherElectronicChannel",
        "foaf:page": "https://www.mimit.gov.it/it/incentivi/bonus-colonnine-domestiche/"
      }
    },
