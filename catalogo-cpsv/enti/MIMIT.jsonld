    {
      "@id": "https://www.mimit.gov.it/it/incentivi/abruzzo-aiuti-per-l-area-del-cratere-sismico-legge-181-89/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Abruzzo - Area cratere sismico (legge 181/89)"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Abruzzo - Area cratere sismico (legge 181/89)"
      },
      "cpsv:producedBy": {
        "@id": "https://www.mimit.gov.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.mimit.gov.it"
      },
      "foaf:page": "https://www.mimit.gov.it/it/incentivi/abruzzo-aiuti-per-l-area-del-cratere-sismico-legge-181-89/",
      "dct:description": {
        "@language": "it",
        "@value": "Con decreto direttoriale 26 maggio 2020 è stata disposta l’apertura dello sportello a partire dalle ore 12 del 1° giugno 2020.\nLe domande di accesso alle agevolazioni potranno essere presentate all’Agenzia nazionale per l’attrazione degli investimenti e lo sviluppo di impresa S.p.a. – Invitalia, secondo le modalità e i modelli indicati nell’apposita sezione dedicata alla legge n. 181/1989 del sito internet dell’Agenzia medesima ( www.invitalia.it ).\nCon decreto direttoriale 18 novembre 2020 è stata disposta, per esaurimento delle risorse disponibili, la chiusura dello sportello a partire dalle ore 17 del 18 novembre 2020."
      },
      "cpsv:hasChannel": {
        "@id": "https://www.mimit.gov.it/it/incentivi/abruzzo-aiuti-per-l-area-del-cratere-sismico-legge-181-89/#channel-online-0",
        "@type": "cpsv:OtherElectronicChannel",
        "foaf:page": "https://www.mimit.gov.it/it/incentivi/abruzzo-aiuti-per-l-area-del-cratere-sismico-legge-181-89/"
      }
    },
