        "@language": "it",
        "@value": "Marcianise - Area di crisi industriale (2023)"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Marcianise - Area di crisi industriale (2023)"
      },
      "cpsv:producedBy": {
        "@id": "https://www.mimit.gov.it"
