      "cpsv:name": {
        "@language": "it",
        "@value": "Nuovo Bando “Fabbrica intelligente, Agrifood, Scienze della vita” e “Calcolo ad alte prestazioni”"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Nuovo Bando “Fabbrica intelligente, Agrifood, Scienze della vita” e “Calcolo ad alte prestazioni”"
      },
      "cpsv:producedBy": {
