        "foaf:page": "https://www.mimit.gov.it/it/incentivi/fondo-straordinario-per-gli-interventi-di-sostegno-alleditoria-2025/"
      }
    },
    {
      "@id": "https://www.mimit.gov.it/it/incentivi/aiuti-per-aree-di-crisi-industriale-non-complessa-della-regione-friuli-venezia-giulia/",
