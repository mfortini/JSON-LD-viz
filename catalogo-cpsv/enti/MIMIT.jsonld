    {
      "@id": "https://www.mimit.gov.it/it/incentivi/porto-torres-area-di-crisi-industriale-2023/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Porto Torres. Area di crisi industriale (2023)"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Porto Torres. Area di crisi industriale (2023)"
      },
      "cpsv:producedBy": {
        "@id": "https://www.mimit.gov.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.mimit.gov.it"
      },
      "foaf:page": "https://www.mimit.gov.it/it/incentivi/porto-torres-area-di-crisi-industriale-2023/",
      "dct:description": {
        "@language": "it",
        "@value": "L'accordo di programma del 10 agosto 2020 è finalizzato a:\nrilanciare le attività imprenditoriali salvaguardare i livelli occupazionali sostenere i programmi di investimento\nnel territorio dei Comuni appartenenti all’area di crisi industriale complessa del Polo industriale di Porto Torres.\nL'accordo è stato sottoscritto tra Ministero delle imprese e del made in Italy, Agenzia nazionale delle politiche attive lavoro – ANPAL, Ministero delle Infrastrutture e della Mobilità Sostenibili, Ministero della Transizione Ecologica, Regione Autonoma della Sardegna, Provincia di Sassari, Comune di Sassari, Comune di Porto Torres, Autorità di Sistema Portuale del mare di Sardegna e Agenzia nazionale per l’attrazione degli investimenti e lo sviluppo d’impresa S.p.a. – Invitalia."
      },
      "cpsv:hasChannel": {
        "@id": "https://www.mimit.gov.it/it/incentivi/porto-torres-area-di-crisi-industriale-2023/#channel-online-0",
        "@type": "cpsv:OtherElectronicChannel",
        "foaf:page": "https://www.mimit.gov.it/it/incentivi/porto-torres-area-di-crisi-industriale-2023/"
      }
    },
