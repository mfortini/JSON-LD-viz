    {
      "@id": "https://www.agenziaentrate.gov.it/portale/servizi/servizitrasversali/altri/ricevute",
      "@type": "cpsv:PublicService",
      "cv:hasCompetentAuthority": {
        "@id": "https://www.agenziaentrate.gov.it"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Ricevute"
      },
      "dct:description": {
        "@language": "it",
        "@value": "<p>Nella sezione &quot;Ricevute&quot; sono consultabili le attestazioni per ogni invio effettuato. In particolare per ogni dichiarazione trasmessa telematicamente e regolarmente acquisita dal sistema viene predisposta una comunicazione di avvenuta presentazione; qualora invece i dati trasmessi non siano corretti, il sistema produce una comunicazione di scarto.</p>\n<p><a href=\"https://www.agenziaentrate.gov.it/portale/web/guest/servizi/servizitrasversali/altri/ricevute/attestazione-delle-dichiarazioni\">Ulteriori informazioni sulle attestazioni delle dichiarazioni</a></p>"
      },
      "dct:abstract": {
        "@language": "it",
        "@value": "Ricevute"
      },
