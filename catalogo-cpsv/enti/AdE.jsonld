      "dct:description": {
        "@language": "it",
        "@value": "<p>In questa sezione, che puoi navigare utilizzando il menu di navigazione, sono contenute le informazioni relative a &quot;Servizi per Enti - Cooperazione informatica&quot;.</p>"
      },
