      "dct:title": {
        "@language": "it",
        "@value": "Canale di assistenza Civis"
      },
      "dct:description": {
        "@language": "it",
        "@value": "<p>Il servizio Civis, disponibile in area riservata, fornisce assistenza sulle comunicazioni di irregolarità, sugli avvisi telematici e le cartelle di pagamento (artt. 36 bis del Dpr n. 600/73 e 54 bis del Dpr n. 633/72) e, inoltre, consente la presentazione dei documenti per il controllo formale (art. 36 ter del Dpr n. 600/73).</p>"
      },
