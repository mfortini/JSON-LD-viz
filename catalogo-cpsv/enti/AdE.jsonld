    {
      "@id": "https://www.agenziaentrate.gov.it/portale/schede/istanze/inclusione-archivio-vies/compilazione-e-invio-via-web-vies",
      "@type": "cpsv:PublicService",
      "cv:hasCompetentAuthority": {
