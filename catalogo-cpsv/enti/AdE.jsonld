      "dct:title": {
        "@language": "it",
        "@value": "Desktop telematico"
      },
      "dct:description": {
        "@language": "it",
        "@value": "<p>L&#x27;applicazione <strong>Desktop Telematico</strong> è un &quot;contenitore&quot; destinato ad accogliere le applicazioni per il controllo, l’autenticazione e l’invio dei file. Entratel, FileInternet ed i vari moduli di controllo sono le applicazioni che si possono installare all&#x27;interno del Desktop Telematico che provvede a gestirne gli aggiornamenti in modo automatico. <strong>Principali caratteristiche</strong></p>"
      },
