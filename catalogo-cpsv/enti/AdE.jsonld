    {
      "@id": "https://www.agenziaentrate.gov.it/portale/servizi/servizitrasversali/assistenza/email-e-comunicazioni-telefoniche",
      "@type": "cpsv:PublicService",
      "cv:hasCompetentAuthority": {
        "@id": "https://www.agenziaentrate.gov.it"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Email e comunicazioni telefoniche"
      },
      "dct:description": {
        "@language": "it",
        "@value": "<p>Il servizio permette di ricevere, sul proprio telefono cellulare o nella propria casella di posta elettronica, messaggi personalizzati e comunicazioni telefoniche.</p>\n<p><strong>Attenzione:</strong> gli SMS avranno come mittente <strong>“Ag. Entrate”.</strong></p>\n<p>Potrai ricevere avvisi relativi, ad esempio, a scadenze, rimborsi, ricezione di atti, operazioni di pagamento effettuate o comunicazioni da parte dell’Agenzia delle Entrate, oltre a segnalazioni sulla disponibilità di ricevute non ancora lette riferite a dichiarazioni, pagamenti o altri documenti inviati tramite i nostri servizi telematici.</p>"
      },
      "dct:abstract": {
        "@language": "it",
        "@value": "Email e comunicazioni telefoniche"
      },
