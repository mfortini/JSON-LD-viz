      "cpsv:hasWebSiteChannel": {
        "@id": "https://www.agenziaentrate.gov.it/portale/servizi/servizitrasversali/verifica/verifica-della-firma-digitale-da-agenzia#website-channel"
      },
      "cv:addressee": [
        {
          "@id": "https://www.agenziaentrate.gov.it/portale/servizi/servizitrasversali/verifica/verifica-della-firma-digitale-da-agenzia#addressee-cittadini"
        },
        {
