    {
      "@id": "https://www.agenziaentrate.gov.it/portale/documents/20143/267376/Elenco+dei+codici+ufficio+per+periodo+di+validit%C3%A0+v2022_08_01.xls/61390d24-4bd2-4081-6a9e-67679f29c209",
