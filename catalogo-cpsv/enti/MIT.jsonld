    {
      "@id": "https://www.ilportaledellautomobilista.it/web/portale-automobilista/rui-registro-unico-ispettori/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Istruzioni operative per il Registro Unico Ispettori (RUI)"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Istruzioni operative per il Registro Unico Ispettori (RUI)"
      },
      "cpsv:producedBy": {
        "@id": "https://www.ilportaledellautomobilista.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.ilportaledellautomobilista.it"
      },
      "foaf:page": "https://www.ilportaledellautomobilista.it/web/portale-automobilista/rui-registro-unico-ispettori/",
      "dct:description": {
        "@language": "it",
        "@value": "Per consentire l'integrazione di soluzioni di firma digitale remota nei sistemi della Motorizzazione, è stato adottato il decreto direttoriale n. 407 del 17 ottobre 2025, che definisce la procedura di adesione alla piattaforma per i prestatori di servizi fiduciari qualificati (QTSP).\nFino al completamento delle attività di adeguamento dei provider, l'inserimento del documento di firma digitale nel RUI è temporaneamente sospeso. La funzionalità sarà riattivata non appena la procedura di accreditamento sarà completata.\nDecreto n. 219 del 6 agosto 2025. Modifiche al Decreto del Capo del Dipartimento n. 198/2025\nCon il Decreto del Capo del Dipartimento n. 219 del 6 agosto 2025 sono state introdotte modifiche e integrazioni al precedente Decreto n. 198 del 9 giugno 2025."
      },
      "cpsv:hasChannel": {
        "@id": "https://www.ilportaledellautomobilista.it/web/portale-automobilista/rui-registro-unico-ispettori/#channel-online-0",
        "@type": "cpsv:OtherElectronicChannel",
        "foaf:page": "https://www.ilportaledellautomobilista.it/web/portale-automobilista/rui-registro-unico-ispettori/"
      }
    },
