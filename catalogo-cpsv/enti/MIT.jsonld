    {
      "@id": "https://www.ilportaledellautomobilista.it/web/portale-automobilista/monopattini-contrassegno-identificativo/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Istruzioni operative contrassegni monopattini a propulsione prevalentemente elettrica"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Istruzioni operative contrassegni monopattini a propulsione prevalentemente elettrica"
      },
      "cpsv:producedBy": {
        "@id": "https://www.ilportaledellautomobilista.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.ilportaledellautomobilista.it"
      },
      "foaf:page": "https://www.ilportaledellautomobilista.it/web/portale-automobilista/monopattini-contrassegno-identificativo/",
      "dct:description": {
        "@language": "it",
        "@value": "Decreto del Capo Dipartimento per i trasporti e la navigazione 27 giugno 2025, n.210\nCon il Decreto del Capo Dipartimento per i trasporti e la navigazione 27 giugno 2025, n. 210, sono definiti i criteri e le modalità di stampa dei contrassegni identificativi.\nL'apposizione deve essere visibile e permanente nell'alloggiamento sul parafango posteriore o, in assenza dello stesso, sul piantone dello sterzo, rispettando orientamento, verticalità e leggibilità.\nLa mancata o non corretta applicazione comporta le sanzioni previste dall'art. 1, comma 75-undevicies, della legge n. 160/2019."
      },
      "cpsv:hasChannel": {
        "@id": "https://www.ilportaledellautomobilista.it/web/portale-automobilista/monopattini-contrassegno-identificativo/#channel-online-0",
        "@type": "cpsv:OtherElectronicChannel",
        "foaf:page": "https://www.ilportaledellautomobilista.it/web/portale-automobilista/monopattini-contrassegno-identificativo/"
      }
    },
    {
      "@id": "https://www.ilportaledellautomobilista.it/web/portale-automobilista/ext/neopatentati/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Limiti guida neopatentati categoria B"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Limiti guida neopatentati categoria B"
      },
      "cpsv:producedBy": {
        "@id": "https://www.ilportaledellautomobilista.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.ilportaledellautomobilista.it"
      },
      "foaf:page": "https://www.ilportaledellautomobilista.it/web/portale-automobilista/ext/neopatentati/",
      "dct:description": {
        "@language": "it",
        "@value": "Verifica quali sono i limiti in vigore per i neopatentati alla guida. Controlla, digitando la targa dell'autoveicolo, se un neopatentato ne è autorizzato alla guida. Limiti di velocità Si ricorda che per i primi 3 anni dal conseguimento della patente di categoria B non è consentito il superamento della velocità di 100 Km/h per le autostrade e di 90 Km/h per le strade extraurbane principali. Da dicembre 2024 il limite di potenza specifica, riferita alla tara, superiore a 75 kW/t fermo restando il limite, nel caso di veicoli di categoria M1, di potenza massima pari a 105 kW che deve essere rispettato nei primi tre anni di guida - dal conseguimento della patente - non si applica se a fianco del conducente si trova, in funzione di istruttore, persona di età non superiore a sessantacinque anni, munita di patente valida per la stessa categoria, conseguita da almeno dieci anni, ovvero valida per la categoria superiore. In caso di veicolo ibrido plug-in l'esito della verifica potrebbe essere non corretto. Effettuare anche la verifica utilizzando i dati del documento di circolazione."
      },
      "cpsv:hasChannel": {
        "@id": "https://www.ilportaledellautomobilista.it/web/portale-automobilista/ext/neopatentati/#channel-online-0",
        "@type": "cpsv:OtherElectronicChannel",
        "foaf:page": "https://www.ilportaledellautomobilista.it/web/portale-automobilista/ext/neopatentati/"
      }
    },
    {
      "@id": "https://www.ilportaledellautomobilista.it/web/portale-automobilista/pagamenti-pagopa/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Pagamenti con Autenticazione"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Pagamenti con Autenticazione"
      },
      "cpsv:producedBy": {
        "@id": "https://www.ilportaledellautomobilista.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.ilportaledellautomobilista.it"
      },
      "foaf:page": "https://www.ilportaledellautomobilista.it/web/portale-automobilista/pagamenti-pagopa/",
      "dct:description": {
        "@language": "it",
        "@value": "E' possibile utilizzare i servizi della piattaforma pagamenti PagoPA una volta effettuata il login sul Portale dell'Automobilista.\nNel sistema dei Pagamenti PagoPA, è necessario che per tutte le pratiche il codice fiscale del pagatore (indicato all'atto del pagamento) corrisponda al codice fiscale dell'intestatario del veicolo (o cointestatario) che effettua la pratica (ad esempio emissione del duplicato carta di circolazione-documento unico)."
      },
      "cpsv:hasChannel": {
        "@id": "https://www.ilportaledellautomobilista.it/web/portale-automobilista/pagamenti-pagopa/#channel-online-0",
        "@type": "cpsv:OtherElectronicChannel",
        "foaf:page": "https://www.ilportaledellautomobilista.it/sistema-pagamenti/"
      }
    },
    {
      "@id": "https://www.ilportaledellautomobilista.it/web/portale-automobilista/piattaforma-cude/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Piattaforma CUDE"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Piattaforma CUDE"
      },
      "cpsv:producedBy": {
        "@id": "https://www.ilportaledellautomobilista.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.ilportaledellautomobilista.it"
      },
      "foaf:page": "https://www.ilportaledellautomobilista.it/web/portale-automobilista/piattaforma-cude/",
      "dct:description": {
        "@language": "it",
        "@value": "Per semplificare la mobilità delle persone con disabilità su tutto il territorio italiano, il Decreto ministeriale del 5 luglio 2021 ha istituito una banca dati nazionale. Grazie a una gestione delle autorizzazioni coordinata su tutto il territorio, chi deve spostarsi da un Comune all'altro, non deve più comunicare l'ingresso nelle aree a traffico limitato situate in comuni diversi da quello di riferimento.\nLa funzionalità è disponibile, previa autenticazione, nella propria area riservata, sotto la voce Accesso ai servizi ---> Piattaforma unica contrassegno disabili - CUDE ."
      },
      "cpsv:hasChannel": {
        "@id": "https://www.ilportaledellautomobilista.it/web/portale-automobilista/piattaforma-cude/#channel-online-0",
        "@type": "cpsv:OtherElectronicChannel",
        "foaf:page": "https://www.ilportaledellautomobilista.it/web/portale-automobilista/piattaforma-cude/"
      }
    },
    {
      "@id": "https://www.ilportaledellautomobilista.it/web/portale-automobilista/rent/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Istruzioni operative per l'iscrizione al RENT"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Istruzioni operative per l'iscrizione al RENT"
      },
      "cpsv:producedBy": {
        "@id": "https://www.ilportaledellautomobilista.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.ilportaledellautomobilista.it"
      },
      "foaf:page": "https://www.ilportaledellautomobilista.it/web/portale-automobilista/rent/",
      "dct:description": {
        "@language": "it",
        "@value": "Le imprese titolari di licenza per il servizio taxi, oppure le imprese titolari di autorizzazione per il servizio di noleggio con conducente, direttamente, ovvero tramite delega conferita ai soggetti di cui all'articolo 7, comma 1, lettere b) e c) della legge 15 gennaio 1992, n. 21 o alle associazioni di categoria, potranno presentare l'istanza di iscrizione al RENT seguendo le istruzioni riportate nel seguito.\nIstruzioni rivolte ai legali rappresentanti di imprese esercenti il servizio di autotrasporto pubblico non di linea\nL'applicazione è disponibile, via internet, collegandosi al Portale dell'Automobilista.\nUna volta effettuata l'autenticazione con le proprie credenziali SPID, cliccare qui per accedere all'applicazione di gestione delle istanze di iscrizione al RENT ."
      },
      "cpsv:hasChannel": {
        "@id": "https://www.ilportaledellautomobilista.it/web/portale-automobilista/rent/#channel-online-0",
        "@type": "cpsv:OtherElectronicChannel",
        "foaf:page": "https://www.ilportaledellautomobilista.it/web/portale-automobilista/rent/"
      }
    },
