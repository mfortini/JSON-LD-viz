    {
      "@id": "https://www.ilportaledellautomobilista.it/gms/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Menù di servizio"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Menù di servizio"
      },
      "cpsv:producedBy": {
        "@id": "https://www.ilportaledellautomobilista.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.ilportaledellautomobilista.it"
      },
      "foaf:page": "https://www.ilportaledellautomobilista.it/gms/",
      "dct:description": {
        "@language": "it",
        "@value": "Seleziona la provincia di interesse e accedi alle informazioni degli Uffici.\nPer informazioni sui servizi offerti, contatta il Call Center del Portale dell'Automobilista attivo dal lunedì al sabato dalle 8.00 alle 20.00\nPer informazioni sui servizi di pagamento, contatta il Call Center attivo dal lunedì al sabato dalle 8.00 alle 20.00"
      },
