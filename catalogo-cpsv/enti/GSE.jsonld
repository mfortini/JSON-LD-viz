    {
      "@id": "https://www.gse.it/servizi-per-te/supporto/biocarburanti/dm-2-marzo-2018/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Dm 2 marzo 2018"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Dm 2 marzo 2018"
      },
      "cpsv:producedBy": {
        "@id": "https://www.gse.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.gse.it"
      },
      "foaf:page": "https://www.gse.it/servizi-per-te/supporto/biocarburanti/dm-2-marzo-2018/",
      "dct:description": {
        "@language": "it",
        "@value": "​Gli articoli 12 e 13 del D.M. 2 marzo 2018 disciplinano l'accesso agli incentivi degli impianti di produzione di biometano e di altri biocarburanti avanzati ubicati sul territorio di altri Stati membri dell'Unione Europea e di altri Stati terzi confinanti con l'Italia con i quali l'UE ha stipulato accordi di libero scambio e che esportano fisicamente la loro produzione di biometano o di altri biocarburanti avanzati in Italia. Tra le varie condizioni previste dal citato decreto per l'ammissione all'incentivazione di tali impianti vi è l'esistenza di un accordo con lo Stato membro o terzo confinante in cui è ubicato l'impianto che stabilisca delle condizioni di reciprocità. Ad oggi, non essendo ancora presenti accordi su tale tematica, non è ancora possibile incentivare impianti ubicati al di fuori del territorio nazionale.\n​Le materie prime valevoli per la produzione di biometano avanzato e di altri biocarburanti avanzati sono riportate nell’allegato 3 parte A del D.M. 10 ottobre 2014, così come modificato dal D.M. 2 marzo 2018, ad esclusione delle materie prime elencate nella parte B del medesimo allegato 3. Inoltre, al paragrafo 3.1 delle Procedure applicative, pubblicate dal…"
      },
      "cpsv:hasChannel": {
        "@id": "https://www.gse.it/servizi-per-te/supporto/biocarburanti/dm-2-marzo-2018/#channel-online-0",
        "@type": "cpsv:OtherElectronicChannel",
        "foaf:page": "https://www.gse.it/servizi-per-te/supporto/biocarburanti/dm-2-marzo-2018/"
      }
    },
