    {
      "@id": "https://www.gse.it/servizi-per-te/certificazione-della-sostenibilita/produzione-elettrica-da-impianti-a-biogas-e-biomasse-solide/conguaglio/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Produzione elettrica da impianti a biogas e biomasse solide"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Produzione elettrica da impianti a biogas e biomasse solide"
      },
      "cpsv:producedBy": {
        "@id": "https://www.gse.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.gse.it"
      },
      "foaf:page": "https://www.gse.it/servizi-per-te/certificazione-della-sostenibilita/produzione-elettrica-da-impianti-a-biogas-e-biomasse-solide/conguaglio/",
      "dct:description": {
        "@language": "it",
        "@value": "Per gli impianti che attualmente beneficiano degli incentivi GRIN, FER, TO e del meccanismo di remunerazione BIO-PMG , i produttori sono tenuti a fare richiesta di conguaglio al GSE nell’anno n+1 rispetto alla produzione dell’anno precedente inviando la documentazione necessaria al fine di attestare la sostenibilità dei biocombustibili utilizzati, pena la sospensione dell’erogazione degli incentivi e della remunerazione BIO-PMG. Nel caso in cui lo stesso impianto abbia beneficiato di due diversi regimi commerciali durante il medesimo anno, sarà necessario inviare la dichiarazione a consuntivo secondo le modalità descritte nella Guida."
      },
      "cpsv:hasChannel": {
        "@id": "https://www.gse.it/servizi-per-te/certificazione-della-sostenibilita/produzione-elettrica-da-impianti-a-biogas-e-biomasse-solide/conguaglio/#channel-online-0",
        "@type": "cpsv:OtherElectronicChannel",
        "foaf:page": "https://www.gse.it/servizi-per-te/certificazione-della-sostenibilita/produzione-elettrica-da-impianti-a-biogas-e-biomasse-solide/conguaglio/"
      }
    },
    {
      "@id": "https://www.gse.it/servizi-per-te/certificazione-della-sostenibilita/produzione-elettrica-da-impianti-a-bioliquidi/conguaglio-e-atto-dimpegno-2025/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Produzione elettrica da impianti a bioliquidi"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Produzione elettrica da impianti a bioliquidi"
      },
      "cpsv:producedBy": {
        "@id": "https://www.gse.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.gse.it"
      },
      "foaf:page": "https://www.gse.it/servizi-per-te/certificazione-della-sostenibilita/produzione-elettrica-da-impianti-a-bioliquidi/conguaglio-e-atto-dimpegno-2025/",
      "dct:description": {
        "@language": "it",
        "@value": "Per gli impianti che beneficiano degli incentivi GRIN/TO e contestualmente della remunerazione BIOL-PMG , i produttori sono tenuti a fornire al GSE la documentazione necessaria ad attestare la sostenibilità dei bioliquidi utilizzati, secondo le modalità descritte nella Guida.\nI titolari degli impianti che accedono al solo regime commerciale BIOL-PMG sono tenuti ad inviare la documentazione necessaria secondo le modalità descritte nella Guida."
      },
      "cpsv:hasChannel": {
        "@id": "https://www.gse.it/servizi-per-te/certificazione-della-sostenibilita/produzione-elettrica-da-impianti-a-bioliquidi/conguaglio-e-atto-dimpegno-2025/#channel-online-0",
