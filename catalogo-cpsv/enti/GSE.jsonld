    {
      "@id": "https://www.gse.it/servizi-per-te/rinnovabili-per-i-trasporti/biocarburanti/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Biocarburanti avanzati diversi dal biometano"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Biocarburanti avanzati diversi dal biometano"
      },
      "cpsv:producedBy": {
        "@id": "https://www.gse.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.gse.it"
      },
      "foaf:page": "https://www.gse.it/servizi-per-te/rinnovabili-per-i-trasporti/biocarburanti/",
      "dct:description": {
        "@language": "it",
        "@value": "I biocarburanti sono combustibili ottenuti da biomasse, inclusi rifiuti e sottoprodotti e possono avere anche forma gassosa, come ad esempio il biometano che viene impiegato per i trasporti. Nati come alternativa ai carburanti fossili, i biocarburanti sostenibili rapppresentano oggi la risposta più concreta per ridurre le emissioni di CO2 derivanti dal settore dei trasporti. I biocarburanti sono definiti avanzati se prodotti a partire dalle materie prime elencate nella parte A dell’Allegato 3 del DM 2 marzo 2018.\nManuale utente Produttori art7\nProcedure Applicative 6.0 DM 2 marzo 2018\nAdempimenti derivanti dal DM 5 agosto 2022 per l'accesso ai benefici del DM 2 marzo 2018"
      },
      "cpsv:hasChannel": {
        "@id": "https://www.gse.it/servizi-per-te/rinnovabili-per-i-trasporti/biocarburanti/#channel-online-0",
        "@type": "cpsv:OtherElectronicChannel",
        "foaf:page": "https://www.gse.it/servizi-per-te/rinnovabili-per-i-trasporti/biocarburanti/"
      }
    },
    {
      "@id": "https://www.gse.it/servizi-per-te/supporto/biocarburanti/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
