    {
      "@id": "https://www.gse.it/servizi-per-te/supporto/dichiarazione-di-consumo/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Dichiarazione di consumo"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Dichiarazione di consumo"
      },
      "cpsv:producedBy": {
        "@id": "https://www.gse.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.gse.it"
      },
      "foaf:page": "https://www.gse.it/servizi-per-te/supporto/dichiarazione-di-consumo/",
      "dct:description": {
        "@language": "it",
        "@value": "I titolari di impianti fotovoltaici di potenza complessiva superiore a 20 kW hanno l’obbligo di invio delle dichiarazioni di consumo al GSE per la produzione del proprio impianto fino all’anno 2015. L’obbligo non riguarda gli impianti incentivati con il Quarto Conto Energia in TFO o con il Quinto Conto Energia. L’obbligo inoltre non sussiste a partire dall’anno di produzione 2016. Il GSE si riserva tuttavia la facoltà di richiedere tale documentazione, qualora lo ritenga necessario.\n- Cessazione dell’obbligo di invio delle dichiarazioni di consumo: Del. N.595/2014/R/eel dell’Autorità di Regolazione per Energia Reti e Ambiente (“ARERA”); - Invio dichiarazioni di consumo pregresse: art. 53 del Testo Unico delle accise; - Esenzione invio Dichiarazione di Consumo in caso di impianti incentivati con il Quinto Conto Energia: Del. ARERA 343/2012/R/efr\nI documenti richiesti sono i seguenti:\nLa Documentazione deve essere inviata attraverso il portale dedicato al CONTO ENERGIA. Per maggiori informazioni consulta la Guida all’invio dematerializzato delle dichiarazioni di consumo"
      },
      "cpsv:hasChannel": {
        "@id": "https://www.gse.it/servizi-per-te/supporto/dichiarazione-di-consumo/#channel-online-0",
        "@type": "cpsv:OtherElectronicChannel",
        "foaf:page": "https://www.gse.it/servizi-per-te/supporto/dichiarazione-di-consumo/"
      }
    },
