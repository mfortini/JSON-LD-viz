    {
      "@id": "https://www.gse.it/servizi-per-te/certificazione-della-sostenibilita/produzione-elettrica-da-impianti-a-biogas-e-biomasse-solide/atto-dimpegno-2025/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Produzione elettrica da impianti a biogas e biomasse solide"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Produzione elettrica da impianti a biogas e biomasse solide"
      },
      "cpsv:producedBy": {
        "@id": "https://www.gse.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.gse.it"
      },
      "foaf:page": "https://www.gse.it/servizi-per-te/certificazione-della-sostenibilita/produzione-elettrica-da-impianti-a-biogas-e-biomasse-solide/atto-dimpegno-2025/",
      "dct:description": {
        "@language": "it",
        "@value": "In merito alla produzione elettrica, a partire dal 1° gennaio 2025 e fino al termine del periodo transitorio , ovvero 31 dicembre 2025 per i produttori che abbiano accettato il preventivo per la certificazione della sostenibilità da parte di un organismo accreditato, gli operatori sono tenuti all’invio di un atto d’impegno all’utilizzo esclusivo di biocombustibili sostenibili o, in alternativa, a comunicare mensilmente al GSE i quantitativi non sostenibili di combustibili utilizzati tramite un apposito modulo e secondo le modalità descritte nella Guida."
      },
      "cpsv:hasChannel": {
        "@id": "https://www.gse.it/servizi-per-te/certificazione-della-sostenibilita/produzione-elettrica-da-impianti-a-biogas-e-biomasse-solide/atto-dimpegno-2025/#channel-online-0",
        "@type": "cpsv:OtherElectronicChannel",
        "foaf:page": "https://www.gse.it/servizi-per-te/certificazione-della-sostenibilita/produzione-elettrica-da-impianti-a-biogas-e-biomasse-solide/atto-dimpegno-2025/"
      }
    },
