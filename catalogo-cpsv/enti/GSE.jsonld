      "cv:hasCompetentAuthority": {
        "@id": "https://www.gse.it"
      },
      "foaf:page": "https://www.gse.it/servizi-per-te/supporto/biocarburanti/",
      "dct:description": {
        "@language": "it",
        "@value": "Come possiamo esserti d'aiuto? Scegli un argomento qui di seguito o torna al servizio DM 2 marzo 2018 Informazioni generali Biocarburanti premiali Informazioni apertura conto proprietà e procedura emissione e ritiro Informazioni sulle sanzioni previste per mancato adempimento Supporto alla presentazione o annullamento della richiesta Rettifica dati pre ammissione Rettifica dati amministrativi e fiscali Fatturazione elettronica"
      },
      "cpsv:hasChannel": {
