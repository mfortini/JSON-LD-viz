        "@id": "https://www.anagrafenazionale.interno.it/area-cittadino/certificati#certificati-elettorali-input-0"
      },
      "cpsv:hasOutput": {
        "@id": "https://www.anagrafenazionale.interno.it/area-cittadino/certificati#certificati-elettorali-output-0"
      },
      "cpsv:hasProcessingTime": {
        "@id": "https://www.anagrafenazionale.interno.it/area-cittadino/certificati#certificati-elettorali-processing-time"
