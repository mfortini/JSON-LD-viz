      "dct:description": {
        "@language": "it",
        "@value": "Se desideri ricevere l’estratto via email o al tuo domicilio digitale, devi prima aver salvato queste informazioni nella sezione “I tuoi dati”."
      },
      "dct:type": {
        "@id": "https://w3id.org/italia/controlled-vocabulary/classifications-for-public-services/service-input-output/ADMINDOC"
