      "foaf:page": "https://www.anagrafenazionale.interno.it/area-cittadino/certificati/",
      "dct:isPartOf": {
        "@id": "https://www.anagrafenazionale.interno.it/area-cittadino/certificati/"
      },
      "dct:description": {
        "@language": "it",
        "@value": "Sono disponibili 2 tipologie di certificato elettorale :\ndi godimento dei diritti politici; di iscrizione nelle liste elettorali.\nPuoi chiedere i certificati singolarmente oppure in forma contestuale , cioè riunendo entrambe le tipologie in un unico certificato.\nTi ricordiamo che i certificati elettorali non possono essere sostituiti dall’ autocertificazione ."
      },
      "cv:addressee": {
        "@id": "https://www.anagrafenazionale.interno.it/area-cittadino/certificati#certificati-elettorali-addressee"
