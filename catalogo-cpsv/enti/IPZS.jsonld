    {
      "@id": "https://www.ipzs.it/soluzioni/identita/patente-di-guida/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Patente di Guida Europea"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Patente di Guida Europea"
      },
      "cpsv:producedBy": {
        "@id": "https://www.ipzs.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.ipzs.it"
      },
      "foaf:page": "https://www.ipzs.it/soluzioni/identita/patente-di-guida/",
      "dct:description": {
        "@language": "it",
        "@value": "La Patente di guida europea appartiene alla categoria delle carte di sicurezza ed è un documento ad elevato livello tecnologico che ne garantisce l'anticontraffazione.\nPatente di Guida Europea prodotte nel 2024\nIl Poligrafico realizza patenti di guida europee con tecnologie avanzate per garantire sicurezza e affidabilità. Conformi alle normative europee, le patenti includono elementi di sicurezza come microstampe e ologrammi a protezione dalla contraffazione. La produzione attenta e la gestione della personalizzazione assicurano alta qualità e durabilità."
      },
      "cpsv:hasChannel": {
        "@id": "https://www.ipzs.it/soluzioni/identita/patente-di-guida/#channel-online-0",
        "@type": "cpsv:OtherElectronicChannel",
        "foaf:page": "https://www.ipzs.it/soluzioni/identita/patente-di-guida/"
      }
    },
    {
      "@id": "https://www.ipzs.it/soluzioni/identita/permesso-di-soggiorno/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Permesso di soggiorno"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Permesso di soggiorno"
      },
      "cpsv:producedBy": {
        "@id": "https://www.ipzs.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.ipzs.it"
      },
      "foaf:page": "https://www.ipzs.it/soluzioni/identita/permesso-di-soggiorno/",
      "dct:description": {
        "@language": "it",
        "@value": "Il Permesso di Soggiorno Elettronico (PSE) è il documento rilasciato dalle questure che permette ai cittadini extra UE di risiedere nel territorio Schengen. È conforme al modello uniforme definito in ambito comunitario, al fine di garantire un livello di sicurezza omogeneo per tutti i Paesi dell'UE. Il PSE è conforme agli standard internazionali (ICAO 9303) adottati anche per i passaporti.\ndi permessi di soggiorno prodotti nel 2024\nIl Poligrafico cura l'intero progetto per il Ministero garantendo la produzione, personalizzazione e la gestione dei sistemi di emissione centrali e periferici. La produzione adotta tecniche produttive, materiali e tecnologie innovativi in grado di innalzare il livello di sicurezza, rendendo così il documento più sicuro dai rischi di contraffazione e falsificazione."
      },
      "cpsv:hasChannel": {
        "@id": "https://www.ipzs.it/soluzioni/identita/permesso-di-soggiorno/#channel-online-0",
        "@type": "cpsv:OtherElectronicChannel",
        "foaf:page": "https://www.ipzs.it/soluzioni/identita/permesso-di-soggiorno/"
      }
    },
