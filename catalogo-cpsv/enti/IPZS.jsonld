    {
      "@id": "https://www.ipzs.it/soluzioni/identita/bio-based-card/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Bio Based Card"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Bio Based Card"
      },
      "cpsv:producedBy": {
        "@id": "https://www.ipzs.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.ipzs.it"
      },
      "foaf:page": "https://www.ipzs.it/soluzioni/identita/bio-based-card/",
      "dct:description": {
        "@language": "it",
        "@value": "Progettata con materiali innovativi ottenuti da fonti rinnovabili, e biodegradabile in conformità alla norma ISO 14855.\nRealizzata con materiali biodegradabili, compostabili e riciclabili ottenuti esclusivamente da fonti rinnovabili\nIl nostro impegno per la sicurezza garantisce che la carta sia a prova di manomissione, incorporando elementi di sicurezza avanzati\nLa sua durata ineguagliabile resiste all'usura quotidiana, rimanendo pienamente conforme agli standard del formato ID1"
      },
      "cpsv:hasChannel": {
        "@id": "https://www.ipzs.it/soluzioni/identita/bio-based-card/#channel-online-0",
        "@type": "cpsv:OtherElectronicChannel",
        "foaf:page": "https://www.ipzs.it/soluzioni/identita/bio-based-card/"
      }
    },
