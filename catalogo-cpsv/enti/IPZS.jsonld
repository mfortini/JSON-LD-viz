    {
      "@id": "https://www.ipzs.it/soluzioni/stampa-di-sicurezza/valori-di-carta/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Valoridicarta"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Valoridicarta"
      },
      "cpsv:producedBy": {
        "@id": "https://www.ipzs.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.ipzs.it"
      },
      "foaf:page": "https://www.ipzs.it/soluzioni/stampa-di-sicurezza/valori-di-carta/",
      "dct:description": {
        "@language": "it",
        "@value": "Carte speciali e sistemi di sicurezza per valori di Stato, banconote e passaporti\nCarte con elementi olografici di sicurezza e anticontraffazione\nCostituita nel 2018 come società in-house del Poligrafico e Zecca dello Stato e della Banca d’Italia con accreditamento da parte della Banca Centrale Europea nel maggio 2019, Valoridicarta produce carte speciali e relativi sistemi di sicurezza per le carte valori dello Stato, per banconote e passaporti.\nE' l'integrazione nello stesso processo produttivo di carte filigranate di pregio con elementi olografici di sicurezza e anticontraffazione a rendere Valoridicarta un polo industriale di eccellenza, a partecipazione interamente pubblica, in grado di competere con altre importanti realtà nell'ambito nella produzione di carte valori in Europa e nel mondo."
      },
      "cpsv:hasChannel": {
        "@id": "https://www.ipzs.it/soluzioni/stampa-di-sicurezza/valori-di-carta/#channel-online-0",
        "@type": "cpsv:OtherElectronicChannel",
        "foaf:page": "https://www.ipzs.it/soluzioni/stampa-di-sicurezza/valori-di-carta/"
      }
    }
