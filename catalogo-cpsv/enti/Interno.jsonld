    {
      "@id": "https://www.interno.gov.it/it/servizi/servizi-line#paragraph-1124",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Anagrafe antimafia degli esecutori: iscrizione ed elenchi"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Anagrafe antimafia degli esecutori: iscrizione ed elenchi"
      },
      "cpsv:producedBy": {
        "@id": "https://www.interno.gov.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.interno.gov.it"
      },
      "foaf:page": "https://www.interno.gov.it/it/servizi/servizi-line#paragraph-1124",
      "dct:description": {
        "@language": "it",
        "@value": "Per garantire la legalità delle attività connesse alla ricostruzione nei territori colpiti dagli eventi sismici in Centro Italia, nell’isola di Ischia e nelle provincie di Campobasso e Catania, all’organizzazione e allo svolgimento dei Giochi olimpici e paralimpici invernali Milano-Cortina 2026, nonché agli interventi urgenti relativi al sistema ospedaliero della Regione Calabria, opera la struttura per la prevenzione antimafia con il compito di verificare la documentazione antimafia degli operatori economici impegnati nei lavori"
      },
      "cpsv:hasChannel": {
        "@id": "https://www.interno.gov.it/it/servizi/servizi-line#paragraph-1124-channel-online-0",
        "@type": "cpsv:OtherElectronicChannel",
        "foaf:page": "https://anagrafeesecutori.interno.gov.it/home"
      }
    },
