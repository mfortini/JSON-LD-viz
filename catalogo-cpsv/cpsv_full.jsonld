      "dct:title": {
        "@language": "it",
        "@value": "Consultazione Estratto conto contributivo/previdenziale per dipendenti pubblici"
      },
      "dct:description": {
        "@language": "it",
        "@value": "L’ Estratto conto contributivo permette ai dipendenti delle pubbliche amministrazioni di:\n\nconsultare la propria posizione assicurativa ; verificare i dati retributivi trasmessi all’INPS dalla pubblica amministrazione presso cui si è svolto servizio; effettuare una valutazione più consapevole del proprio futuro previdenziale ."
      },
      "dct:abstract": {
        "@language": "it",
        "@value": "Verifica della posizione assicurativa e valutazioni previdenziali per dipendenti pubblici"
      },
