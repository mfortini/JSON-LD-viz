  "aci:unmappedSections": {
    "https://aci.gov.it/servizio/attestazione-classe-di-distanza-chilometrica-per-farmacie/": {
      "Contatti": "Per ogni ulteriore richiesta di informazioni o per assistenza è possibile scrivere una mail all’indirizzo distanzechilometriche@aci.it ."
    },
    "https://aci.gov.it/servizio/bollo-auto-istanze-online/": {
      "Contatti": "Le Regioni e le Province Autonome convenzionate con ACI hanno attivato un servizio di assistenza diretta agli utenti, tutte le informazioni sono disponibili alla pagina Recapiti per l’assistenza."
    },
    "https://aci.gov.it/servizio/bollonet-paga-il-bollo/": {
      "Modalità di pagamento": "Il pagamento del bollo sarà effettuato tramite PagoPA. PagoPA",
      "Contatti": "Tutte le informazioni e i contatti per l’assistenza sono disponibili alla pagina G uida al Bollo Auto ."
    },
    "https://aci.gov.it/servizio/consulta-attestazione-e-certificato-di-proprieta-digitale/": {
      "Contatti": "Per ogni ulteriore richiesta di informazioni o per casi particolari è possibile rivolgersi all’ufficio PRA della propria provincia di residenza ai contatti reperibili nella sezione Sedi ACI sul territorio ."
    },
    "https://aci.gov.it/servizio/consulta-atto-e-nota-digitale/": {
      "Contatti": "Per ogni ulteriore richiesta di informazioni o per casi particolari è possibile rivolgersi all’ufficio URP della propria provincia di residenza ai contatti reperibili nella sezione Sedi ACI sul territorio ."
    },
    "https://aci.gov.it/servizio/consultazione-online-esito-istanza-di-rimborso/": {
      "Utilizza il servizio": "Compila e verifica lo stato della tua richiesta di rimborso. Tutti i campi richiesti sono obbligatori.",
      "Contatti": "Per ogni ulteriore richiesta di informazioni è possibile contattare l’Ufficio PRA presso il quale è stata presentata l’istanza, ai contatti reperibili nella sezione Sedi ACI sul territorio ."
    },
    "https://aci.gov.it/servizio/convenzioni-accesso-dati-pra/": {
      "Contatti": "Per ogni ulteriore richiesta di informazioni o per assistenza è possibile rivolgersi alla Direzione PRA e Fiscalità Automobilistica (DPFA) inviando una e-mail all’indirizzo gestionecontratti.usgef-pra@aci.it ."
    },
    "https://aci.gov.it/servizio/crononet-estratto-cronologico-pra/": {
      "Contatti": "Per tutte le informazioni e l’assistenza relative al servizio Crononet scrivere una e-mail all’indirizzo visurenet@aci.it . Per le visure non richiedibili tramite questo servizio è possibile rivolgersi all’ufficio PRA della propria provincia di residenza ai contatti reperibili nella sezione Sedi ACI sul territorio . Link utili Lo sportello virtuale ACI"
    },
    "https://aci.gov.it/servizio/fornitura-dati-pra/": {
      "Contatti": "Per ogni ulteriore richiesta di informazioni o per assistenza è possibile scrivere una e-mail all’indirizzo aci-fdautomotive@aci.it ."
    },
    "https://aci.gov.it/servizio/portale-di-assistenza-ai-servizi-aci/": {
      "Contatti": "Il Portale è il canale unico d’ingresso delle richieste. Solo per l’assistenza al Bollo Auto, consultare le modalità indicate nella pagina Recapiti per l’assistenza . Solo per problemi di accesso ai servizi online con SPID, CIE, CNS o eiDAS, compilare una richiesta di assistenza da questo link ."
    },
    "https://aci.gov.it/servizio/reve-ricerca-codice-identificativo-di-iscrizione-al-registro-veicoli-esteri/": {
      "Contatti": "Per ogni ulteriore richiesta di informazioni o per casi particolari è possibile rivolgersi all’ufficio URP della propria provincia di residenza ai contatti reperibili nella sezione Sedi ACI sul territorio .",
      "Argomenti correlati": "REVE: registrazione dei veicoli immatricolati all’estero Come fare per iscrivere un veicolo al Registro dei Veicoli Esteri (REVE). Pratica REVE: fine disponibilità Il servizio permette l'annotazione di fine disponibilità di un veicolo iscritto al Registro dei Veicoli Esteri (REVE). Pratica"
    },
    "https://aci.gov.it/servizio/verifica-estratto-cronologico-pra/": {
      "Contatti": "Per ogni ulteriore richiesta di informazioni o per casi particolari è possibile rivolgersi all’ufficio URP della propria provincia di residenza ai contatti reperibili nella sezione Sedi ACI sul territorio ."
    },
    "https://aci.gov.it/servizio/verifica-tipo-documento-e-vincoli/": {
      "Contatti": "Per ogni ulteriore richiesta di informazioni o per casi particolari è possibile rivolgersi all’ufficio URP della propria provincia di residenza ai contatti reperibili nella sezione Sedi ACI sul territorio ."
    },
    "https://aci.gov.it/servizio/visurenet-visura-della-banca-dati-del-pubblico-registro-automobilistico-pra/": {
      "Modalità di pagamento": "Il pagamento può essere effettuato solo tramite PagoPA. PagoPA",
      "Contatti": "Per ogni ulteriore richiesta di informazioni o per assistenza https://assistenzaservizicittadino.aci.it"
