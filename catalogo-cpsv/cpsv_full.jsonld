    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.indennit-per-i-lavoratori-dipendenti-del-settore-privato-richiamati-alle-armi.Indennit--per-i-lavoratori-dipendenti-del-settore-privato-richiamati-alle-armi.html#addressee-Cittadini",
