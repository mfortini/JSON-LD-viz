      "dct:description": {
        "@language": "it",
        "@value": "Cosa serve: Indicazioni specifiche delle variabili riguardanti la statistica che si intende ottenere, quali ad esempio anno di riferimento, disaggregazione geografica, tipo di categoria del veicolo, alimentazione, classificazione euro, ecc."
      }
    },
