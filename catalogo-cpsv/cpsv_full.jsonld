    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50577.prestazione-di-accompagnamento-alla-pensione.html",
      "@type": "cpsv:PublicService",
      "cv:hasCompetentAuthority": {
        "@id": "https://www.inps.it"
      },
      "dct:identifier": "IT_1eaa865e-3c7a-4a67-9a10-6ddef4de9902",
      "cpsv:otherServiceCode": "IT_1eaa865e-3c7a-4a67-9a10-6ddef4de9902",
      "dct:title": {
        "@language": "it",
        "@value": "Prestazione di accompagnamento alla pensione"
      },
      "dct:description": {
        "@language": "it",
        "@value": "La legge prevede che nell'ambito di processi di ristrutturazione, di situazioni di crisi, di riorganizzazione aziendale, di riduzione o trasformazione di attività di lavoro, possano essere erogate prestazioni di accompagnamento alla pensione a totale carico del datore di lavoro."
      },
      "dct:abstract": {
        "@language": "it",
        "@value": "Domanda di accompagnamento alla pensione dei lavoratori a tempo indeterminato e dirigenti in esubero con specifici requisiti per datori di lavoro"
      },
      "foaf:page": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50577.prestazione-di-accompagnamento-alla-pensione.html",
      "dct:language": "http://publications.europa.eu/resource/authority/language/ITA",
      "dct:issued": "3 aprile 2017",
