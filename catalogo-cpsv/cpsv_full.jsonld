    },
    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.sportello-malattia-a-pagamento-diretto.html#addressee-Dipendenti%20Privati",
      "@type": "cv:Agent",
