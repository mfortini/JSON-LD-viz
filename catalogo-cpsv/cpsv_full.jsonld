      "dct:description": {
        "@language": "it",
        "@value": "La domanda per l'autorizzazione al versamento dei contributi volontari deve essere presentata online all'INPS attraverso il servizio dedicato.\n\nIn alternativa, si può fare la domanda tramite:"
      }
    },
    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50035.contributo-cure-termali-per-iscritti-al-vecchio-fondo-mutualit-ipost.html",
      "@type": "cpsv:PublicService",
