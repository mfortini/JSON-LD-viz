    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50298.assegno-straordinario-di-sostegno-al-reddito.html#addressee-Intermediari%20e%20consulenti-%20Amministrazioni%2C%20Enti%20e%20Aziende",
