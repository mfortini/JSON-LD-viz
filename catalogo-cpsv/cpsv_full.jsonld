      "dct:title": {
        "@language": "it",
        "@value": "Contributi per master in Italia"
      },
      "dct:description": {
        "@language": "it",
        "@value": "Ogni anno l’INPS sostiene, attraverso l'erogazione di contributi a copertura parziale delle spese di iscrizione, la partecipazione a master universitari in Italia di durata annuale o biennale."
      },
      "dct:abstract": {
        "@language": "it",
        "@value": "Richiesta dei contributi per la partecipazione a master universitari per i figli di iscritti alla Gestione Unitaria e Gestione Assistenza Magistrale"
      },
