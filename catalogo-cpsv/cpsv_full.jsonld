    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.fondo-di-solidariet-di-bolzano---alto-adige-51292.fondo-di-solidariet-di-bolzano---alto-adige.html#website-channel",
