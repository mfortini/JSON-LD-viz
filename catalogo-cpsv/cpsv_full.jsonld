        "cpsv-portalone:badge": "aci",
        "cpsv-portalone:sourceField": "area_tematica",
        "cpsv-portalone:sourceValue": "Pratiche auto"
      },
      "dct:description": {
        "@language": "it",
        "@value": "Il servizio AvvisACI ti permettere di monitorare l’avvenuta registrazione al PRA di pratiche da te stesso presentate, e di essere informato di eventi registrati sul proprio veicolo su richiesta di altri soggetti."
      },
      "dct:modified": "27 Gennaio 2025",
      "aci:outputDescription": {
        "@language": "it",
        "@value": "Una e-mail o un sms relativo alle seguenti tipologie di registrazioni al PRA: iscrizione di immatricolazione trascrizione dell’atto di vendita da parte dell’acquirente iscrizione del fermo amministrativo da parte di un Agente della riscossione e relativa cancellazione radiazione da parte dell’Autodemolitore al quale è stato consegnato il veicolo per la demolizione radiazione per definitiva esportazione all’estero perdita di possesso del veicolo e rientro in possesso."
      },
      "aci:processingTime": {
        "@language": "it",
        "@value": "l’iscrizione è immediata successivamente verrà inviata una e-mail, all’indirizzo fornito, ogni qualvolta verrà registrato al PRA un evento su un veicolo di tuo interesse."
      },
      "aci:costDescription": {
        "@language": "it",
        "@value": "Il servizio è gratuito."
      },
      "cpsv:hasWebSiteChannel": {
        "@id": "https://aci.gov.it/servizio/avvisaci-2/#website-channel"
      },
