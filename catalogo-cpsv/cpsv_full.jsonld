        "@value": "Contributi per collaboratori e figure assimilate"
      },
      "dct:description": {
        "@language": "it",
        "@value": "È un contributo che riguarda le collaborazioni coordinate e continuative e figure assimilate:\n\nper 2/3 a carico del committente; per 1/3 a carico del collaboratore."
      },
      "dct:abstract": {
