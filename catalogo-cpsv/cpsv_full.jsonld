      }
    },
    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.riscatto-dei-periodi-non-coperti-da-contribuzione-52463.riscatto-dei-periodi-non-coperti-da-contribuzione-pace-contributiva.html#addressee-Cittadini",
