    {
      "@id": "https://www.agenziaentrate.gov.it/portale/consegna-documenti",
      "@type": "cpsv:PublicService",
      "cv:hasCompetentAuthority": {
        "@id": "https://www.agenziaentrate.gov.it"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Consegna documenti e istanze"
      },
      "dct:description": {
        "@language": "it",
        "@value": "Il servizio consente all’utente in possesso delle credenziali di accesso all’area riservata del sito dell’Agenzia di inviare documenti e istanze agli uffici dell’Agenzia, sia a seguito di una specifica richiesta dell’Agenzia sia su iniziativa spontanea. Il servizio può essere utilizzato sia per esigenze personali sia per conto di un altro soggetto. Previa abilitazione, il servizio è disponibile anche per i rappresentanti legali di persone fisiche (tutori, curatori speciali, amministratori di sostegno e genitori di minori) e per le persone di fiducia. Si possono inviare fino a 10 file della dimensione massima di 20 MB ognuno. Oltre che file in formato PDF e TIF/TIFF, è possibile inviare file firmati digitalmente nei formati PAdES e CAdES. Il canale è sempre aperto e permette, inoltre, di ottenere la ricevuta di protocollazione analogamente a quanto avviene con la consegna diretta in Ufficio, senza doversi recare fisicamente allo sportello. Fornendo l’indirizzo PEC o l’indirizzo e-mail e/o un numero di cellulare è anche possibile essere avvisati della disponibilità della ricevuta di consegna o della ricevuta di scarto, se l’invio non va a buon fine."
      },
      "dct:abstract": {
        "@language": "it",
        "@value": "Consegna documenti"
      },
      "foaf:page": "https://www.agenziaentrate.gov.it/portale/consegna-documenti",
      "dct:identifier": "https://www.agenziaentrate.gov.it/portale/consegna-documenti",
      "dct:language": "http://publications.europa.eu/resource/authority/language/ITA",
      "skos:notation": {
        "@language": "it",
        "@value": "Altri servizi"
      },
      "cpsv:hasWebSiteChannel": {
        "@id": "https://www.agenziaentrate.gov.it/portale/consegna-documenti#website-channel"
      },
      "cpsv:hasOtherElectronicChannel": [
        {
          "@id": "https://www.agenziaentrate.gov.it/portale/consegna-documenti#electronic-channel-0"
        }
      ]
    },
