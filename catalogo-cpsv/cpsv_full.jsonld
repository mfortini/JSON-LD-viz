    },
    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.richiedere-la-successione-in-un-mutuo-ipotecario-50071.richiedere-la-successione-o-il-subentro-in-un-mutuo-ipotecario.html#addressee-Cittadini",
