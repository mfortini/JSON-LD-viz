    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.disoccupazione-per-i-lavoratori-rimpatriati-in-italia-dopo-un-periodo-di-lavoro-50191.disoccupazione-per-i-lavoratori-rimpatriati-in-italia-dopo-un-periodo-di-lavoro-all-estero.html#addressee-Cittadini",
      "@type": "cv:Agent",
