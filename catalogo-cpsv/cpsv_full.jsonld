      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.certificazione-dei-debiti-contributivi-vera-56089.certificazione-dei-debiti-contributivi-vera.html#addressee-Cittadini-%20Amministrazioni%2C%20Enti%20e%20Aziende",
      "@type": "cv:Agent",
      "skos:prefLabel": {
        "@language": "it",
