      "dct:title": {
        "@language": "it",
        "@value": "Rapporti a tempo indeterminato - Verifica"
      },
      "dct:description": {
        "@language": "it",
        "@value": "La procedura consente la verifica del possesso del requisito previsto ai fini del riconoscimento dell’ esonero contributivo per le nuove assunzioni di giovani , che consiste nell’assenza di rapporti di lavoro a tempo indeterminato in capo al lavoratore alla data della prima assunzione incentivata."
      },
      "dct:abstract": {
        "@language": "it",
