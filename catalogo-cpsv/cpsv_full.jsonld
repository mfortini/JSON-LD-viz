    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.screening-patologie-oncologiche-e-cardiovasculopatie-accreditamento-strutture-sanitarie-55398.screening-patologie-oncologiche-e-cardiovasculopatie-accreditamento-strutture-sanitarie.html#addressee-Amministrazioni%2C%20Enti%20e%20Aziende",
