      "dct:title": {
        "@language": "it",
        "@value": "Assegno per il Nucleo Familiare - ANF (Dipendenti privati)"
      },
      "dct:description": {
        "@language": "it",
        "@value": "L’ Assegno per il Nucleo Familiare (ANF) è una prestazione economica erogata dall'INPS ai nuclei familiari di alcune categorie di lavoratori , dei titolari delle pensioni e delle prestazioni economiche previdenziali da lavoro dipendente."
      },
      "dct:abstract": {
