    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.assegno-per-il-nucleo-familiare-ai-pensionati-53730.Assegno-per-il-Nucleo-Familiare-ai-Pensionati.html#addressee-Cittadini",
