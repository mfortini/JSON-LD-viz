      "dct:title": {
        "@language": "it",
        "@value": "Trasmissione UNIEMENS per enti e amministrazioni"
      },
      "dct:description": {
        "@language": "it",
        "@value": "La Denuncia Mensile Analitica (DMA) , che rientra nel flusso UNIEMENS, deve essere trasmessa obbligatoriamente all'INPS da parte degli enti e delle amministrazioni iscritti all'INPS Gestione Dipendenti Pubblici."
      },
      "dct:abstract": {
        "@language": "it",
        "@value": "Trasmissione della Denuncia Mensile Analitica (DMA) tramite flusso UNIEMENS per enti e amministrazioni iscritti alla Gestione Dipendenti"
      },
