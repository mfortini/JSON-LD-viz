    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50135.sospensione-obbligo-contributivo-per-calamit-naturali.html",
      "@type": "cpsv:PublicService",
      "cv:hasCompetentAuthority": {
        "@id": "https://www.inps.it"
      },
      "dct:identifier": "IT_dfd05d20-db46-4f92-ac5a-d306e74142e1",
      "cpsv:otherServiceCode": "IT_dfd05d20-db46-4f92-ac5a-d306e74142e1",
      "dct:title": {
        "@language": "it",
        "@value": "Sospensione obbligo contributivo per calamità naturali"
      },
      "dct:description": {
        "@language": "it",
        "@value": "In caso di calamità naturali o eventi eccezionali , sono previste sospensioni contributive , disposte sempre con appositi provvedimenti normativi conseguenti a uno stato d'emergenza nei territori interessati, che viene dichiarato con decreto del Presidente del Consiglio dei ministri."
      },
      "dct:abstract": {
        "@language": "it",
