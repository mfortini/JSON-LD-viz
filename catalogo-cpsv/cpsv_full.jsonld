    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.Pensione-di-inabilit-per-i-dipendenti-pubblici-art-2-comma-12-legge-335-95.html#website-channel",
