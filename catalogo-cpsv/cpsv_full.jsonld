    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50225.assegno-emergenziale-integrativo-per-lavoratori-licenziati-da-aziende-iscritte-ai-fondi-di-solidariet-.html#addressee-Amministrazioni%2C%20Enti%20e%20Aziende",
