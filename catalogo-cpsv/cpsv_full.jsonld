      "dct:title": {
        "@language": "it",
        "@value": "Domanda di compensazione contributiva per agricoltori"
      },
      "dct:description": {
        "@language": "it",
        "@value": "I lavoratori agricoli autonomi e le aziende agricole possono chiedere di compensare le somme versate in eccesso con contribuzioni che saranno dovute in futuro se:\n\nhanno versato più contributi del necessario; hanno avuto accesso ad un esonero contributivo o ad una riduzione che genera un’eccedenza di versamento."
      },
      "dct:abstract": {
        "@language": "it",
        "@value": "Domanda per la compensazione delle somme contributive versate in eccedenza per i lavoratori agricoli autonomi e i titolari di imprese agricole"
      },
