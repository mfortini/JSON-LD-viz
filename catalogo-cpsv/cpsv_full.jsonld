    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.anticipazione-ordinaria-tfr-per-gli-iscritti-alla-gestione-unitaria-delle-prestazioni-creditizie-e-sociali-(fondo-credito).html",
      "@type": "cpsv:PublicService",
      "cv:hasCompetentAuthority": {
