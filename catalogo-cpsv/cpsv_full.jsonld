    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.corso-di-lingue-in-italia-borse-di-studio-51932.corso-di-lingue-in-italia-borse-di-studio.html#addressee-Dipendenti%20Pubblici",
