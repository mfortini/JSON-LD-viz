      "dct:title": {
        "@language": "it",
        "@value": "Indennità per congedo parentale per lavoratori e lavoratrici autonome"
      },
      "dct:description": {
        "@language": "it",
        "@value": "È un periodo facoltativo di assenza dal lavoro concesso ai lavoratori e alle lavoratrici autonome per ogni figlio. In questo periodo i lavoratori percepiscono un’ indennità economica sostitutiva del reddito da lavoro."
      },
