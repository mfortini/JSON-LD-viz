    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.benefici-in-favore-dei-lavoratori-sordomuti-e-invalidi-50612.benefici-in-favore-dei-lavoratori-sordomuti-e-invalidi.html",
