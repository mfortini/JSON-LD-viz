    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50243.rateazione-dei-debiti-contributivi-in-fase-amministrativa.html",
      "@type": "cpsv:PublicService",
      "cv:hasCompetentAuthority": {
