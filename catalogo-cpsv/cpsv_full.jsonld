    {
      "@id": "https://www.agenziaentrate.gov.it/portale/schede/istanze/domicilio-per-notifica-atti/compilazione-e-invio-via-web-comunicazione-domicilio-per-notifica-atti",
      "@type": "cpsv:PublicService",
      "cv:hasCompetentAuthority": {
        "@id": "https://www.agenziaentrate.gov.it"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Indicazione del domicilio per la notifica degli atti"
      },
      "dct:description": {
        "@language": "it",
        "@value": "Per compilare la comunicazione del domicilio per la notifica degli atti è disponibile sul sito dei servizi telematici un’apposita applicazione web. Il programma consente di compilare e trasmettere direttamente on line il modello di comunicazione, quindi, senza la necessità di scaricare alcun software. Per utilizzare il servizio è necessario accedere all'area riservata, tramite le credenziali SPID, CIE, CNS o, nei casi ammessi, le credenziali Entratel e Fisconline."
      },
