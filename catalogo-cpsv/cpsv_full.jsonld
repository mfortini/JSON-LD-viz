    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.accertamento-dell-esistenza-in-vita-cos-e-come-funziona--50197.accertamento-dell-esistenza-in-vita-cos-e-come-funziona-.html#website-channel",
