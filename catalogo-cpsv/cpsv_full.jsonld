    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.assegno-per-il-nucleo-familiare---anf-(dipendenti-privati).html#addressee-Dipendenti%20privati-%20Patronati",
