      "dct:title": {
        "@language": "it",
        "@value": "Mutuo ipotecario edilizio: consultazione domande fino al 15 ottobre 2022"
      },
      "dct:description": {
        "@language": "it",
        "@value": "Il servizio permette di visualizzare le notifiche e consultare lo stato delle domande di mutuo ipotecario edilizio presentate fino al 15 ottobre 2022 , prima dell’entrata in vigore del nuovo regolamento 2023 e delle nuove procedure di domanda."
      },
