    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.calcolo-dei-contributi-eccedenti-il-minimale-annuale-previsto-per-legge-50150.calcolo-dei-contributi-eccedenti-il-minimale-annuale-previsto-per-legge.html",
      "@type": "cpsv:PublicService",
      "cv:hasCompetentAuthority": {
        "@id": "https://www.inps.it"
      },
      "dct:identifier": "IT_fecd8b87-ba4d-48ad-942b-411e4eb3485a",
      "cpsv:otherServiceCode": "IT_fecd8b87-ba4d-48ad-942b-411e4eb3485a",
      "dct:title": {
        "@language": "it",
        "@value": "Calcolo dei contributi eccedenti il minimale annuale previsto per legge"
      },
      "dct:description": {
        "@language": "it",
        "@value": "Gli artigiani e i commercianti sono tenuti al versamento dei contributi previdenziali per loro stessi e per i loro collaboratori in misura minima fissa.\n\nSe i redditi conseguiti superano un importo minimo fissato ogni anno, è necessario quantificare e versare ulteriori contributi."
      },
      "dct:abstract": {
        "@language": "it",
        "@value": "Domanda di calcolo dei redditi conseguiti. Se superano un importo minimo fissato annualmente, è necessario quantificare e versare ulteriori contributi"
      },
      "foaf:page": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.calcolo-dei-contributi-eccedenti-il-minimale-annuale-previsto-per-legge-50150.calcolo-dei-contributi-eccedenti-il-minimale-annuale-previsto-per-legge.html",
      "dct:language": "http://publications.europa.eu/resource/authority/language/ITA",
      "dct:issued": "3 aprile 2017",
