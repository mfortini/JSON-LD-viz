    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.la-rete-del-lavoro-agricolo-di-qualit--50213.la-rete-del-lavoro-agricolo-di-qualit-.html#addressee-Cittadini",
