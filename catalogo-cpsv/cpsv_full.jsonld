    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.55617.gestione-dei-ricorsi-amministrativi-in-materia-di-inquadramento-previdenziale.html#addressee-Patronati",
