      "dct:description": {
        "@language": "it",
        "@value": "È un’integrazione al reddito a favore delle lavoratrici madri per il 2025, introdotta dall’articolo 6, decreto-legge 30 giugno 2025, n. 95, convertito dalla legge 8 agosto 2025, n. 118."
      },
      "dct:abstract": {
