    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.assicurazione-sociale-vita-per-dipendenti-di-enti-di-diritto-pubblico-asv--50032.assicurazione-sociale-vita-per-dipendenti-di-enti-di-diritto-pubblico-asv-.html#website-channel",
      "@type": "cpsv:WebSiteChannel",
      "foaf:page": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.assicurazione-sociale-vita-per-dipendenti-di-enti-di-diritto-pubblico-asv--50032.assicurazione-sociale-vita-per-dipendenti-di-enti-di-diritto-pubblico-asv-.html"
    },
    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.assicurazione-sociale-vita-per-dipendenti-di-enti-di-diritto-pubblico-asv--50032.assicurazione-sociale-vita-per-dipendenti-di-enti-di-diritto-pubblico-asv-.html#addressee-Cittadini",
      "@type": "cv:Agent",
