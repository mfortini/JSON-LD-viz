      "dct:identifier": "IT_e1027fbe-1ddc-4fc4-84e6-b15eeab9a7fd",
      "cpsv:otherServiceCode": "IT_e1027fbe-1ddc-4fc4-84e6-b15eeab9a7fd",
      "dct:title": {
        "@language": "it",
        "@value": "Agricoli: consultazione quote associative FIMI e CAC"
      },
      "dct:description": {
        "@language": "it",
        "@value": "Il servizio permette di consultare le quote associative del Fondo Integrazione Malattie-Infortuni (FIMI) e Contributo Assistenza Contrattuale (CAC) in agricoltura, al fine di consentire ai comitati intersindacali provinciali di verificare il rapporto emesso/riscosso della contribuzione in esame."
      },
      "dct:abstract": {
        "@language": "it",
        "@value": "Consultazione quote associative del Fondo Integrazione Malattie-Infortuni e Contributo Assistenza Contrattuale in agricoltura"
