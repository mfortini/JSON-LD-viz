    },
    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.riscatto-della-laurea-ai-fini-pensionistici-gestioni-dipendenti-privati-50145.riscatto-della-laurea-ai-fini-pensionistici-gestioni-dipendenti-privati.html#addressee-Cittadini",
