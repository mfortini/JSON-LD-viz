    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.bonus-nuovi-nati.html",
      "@type": "cpsv:PublicService",
      "cv:hasCompetentAuthority": {
        "@id": "https://www.inps.it"
      },
      "dct:identifier": "IT_7fa7adad-b450-474c-9915-51b078321291",
      "cpsv:otherServiceCode": "IT_7fa7adad-b450-474c-9915-51b078321291",
      "dct:title": {
        "@language": "it",
        "@value": "Bonus nuovi nati"
      },
      "dct:description": {
        "@language": "it",
        "@value": "È un contributo di sostegno al reddito introdotto dall’art. 1 comma 206 della legge 30 dicembre 2024, n. 207 a favore dei genitori, per incentivare la natalità e contribuire alle spese per il sostegno."
      },
      "dct:abstract": {
        "@language": "it",
        "@value": "Domanda di contributo per ogni figlio nato o adottato dal 1° gennaio 2025, per genitori con i requisiti richiesti"
      },
