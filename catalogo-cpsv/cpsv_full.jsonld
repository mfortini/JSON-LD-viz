    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.delega-dell-identit-digitale-per-accedere-ai-servizi-online.html",
      "@type": "cpsv:PublicService",
      "cv:hasCompetentAuthority": {
        "@id": "https://www.inps.it"
      },
      "dct:identifier": "IT_a1dfa46b-9392-4394-b751-fabdb1e56b3f",
      "cpsv:otherServiceCode": "IT_a1dfa46b-9392-4394-b751-fabdb1e56b3f",
      "dct:title": {
        "@language": "it",
        "@value": "Delega dell’identità digitale per accedere ai servizi online"
      },
      "dct:description": {
        "@language": "it",
        "@value": "È uno strumento a supporto degli utenti impossibilitati a utilizzare in autonomia i servizi online dell’Istituto che possono così delegare una persona di fiducia all'esercizio dei propri diritti nei confronti dell’Istituto.\n\nAttraverso questo strumento, inoltre, anche i tutori, i curatori, gli amministratori di sostegno e gli esercenti la potestà genitoriale possono esercitare i diritti dei rispettivi soggetti rappresentati e dei minori."
      },
      "dct:abstract": {
        "@language": "it",
        "@value": "Possibilità dell’utente di delegare una persona di fiducia all'esercizio dei propri diritti nei confronti dell'INPS"
      },
      "foaf:page": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.delega-dell-identit-digitale-per-accedere-ai-servizi-online.html",
