      "cpsv:otherServiceCode": "IT_7ea33086-49d3-408e-89db-1ab3da5b47ad",
      "dct:title": {
        "@language": "it",
        "@value": "Rimborso delle denunce passive alle aziende"
      },
      "dct:description": {
        "@language": "it",
        "@value": "Nell'ipotesi in cui il saldo della denuncia passiva mensile UNIEMENS sia a credito dell’azienda, il relativo importo può essere richiesto a rimborso o posto in compensazione , in tutto o in parte."
      },
      "dct:abstract": {
        "@language": "it",
        "@value": "Istanza di rimborso o compensazione del saldo relativo alla denuncia passiva mensile UNIEMENS a credito dell'azienda per i datori di lavoro"
      },
      "foaf:page": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50138.rimborso-delle-denunce-passive-alle-aziende.html",
