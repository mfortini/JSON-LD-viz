    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50066.Prestito-pluriennale-diretto-iscritti-Gestione-Unitaria-prestazioni-creditizie-sociali-iscritti-Gestione-speciale-Previdenza-personale-Poste-Italiane-SpA-Fondo-Credito-ex-IPOST.html#addressee-Amministrazioni%2C%20Enti%20e%20Aziende",
