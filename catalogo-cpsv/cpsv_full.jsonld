    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.cassa-integrazione-speciale-operai-agricoli-cisoa.html#addressee-Intermediari%20e%20consulenti",
