    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50130.durc-online.html",
      "@type": "cpsv:PublicService",
      "cv:hasCompetentAuthority": {
        "@id": "https://www.inps.it"
      },
      "dct:identifier": "IT_b302d3f4-1370-4c3b-ba18-ab147a985519",
      "cpsv:otherServiceCode": "IT_b302d3f4-1370-4c3b-ba18-ab147a985519",
      "dct:title": {
        "@language": "it",
        "@value": "DURC online"
      },
      "dct:description": {
        "@language": "it",
        "@value": "Il Documento Unico di Regolarità Contributiva ( DURC ) è il documento con il quale, in modalità telematica e in tempo reale, indicando esclusivamente il codice fiscale del soggetto da verificare, si attesta la regolarità contributiva nei confronti di INPS, INAIL e, per le imprese tenute ad applicare i contratti del settore dell'edilizia, di Casse edili."
      },
      "dct:abstract": {
        "@language": "it",
        "@value": "Documento che attesta la regolarità contributiva verso Inps, Inail e Casse edili. La risposta viene fornita in modalità telematica e in tempo reale"
      },
      "foaf:page": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50130.durc-online.html",
      "dct:language": "http://publications.europa.eu/resource/authority/language/ITA",
      "dct:issued": "3 aprile 2017",
      "dct:modified": "30 giugno 2025",
      "cpsv:hasWebSiteChannel": {
        "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50130.durc-online.html#website-channel"
      },
      "cv:addressee": [
        {
          "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50130.durc-online.html#addressee-Amministrazioni%2C%20Enti%20e%20Aziende"
        },
        {
          "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50130.durc-online.html#addressee-description"
        }
      ],
      "cpsv:hasInput": {
        "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50130.durc-online.html#input-domanda"
      },
      "cpsv:hasProcessingTime": {
