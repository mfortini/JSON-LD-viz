      "dct:title": {
        "@language": "it",
        "@value": "Portale prestazioni esodo"
      },
      "dct:description": {
        "@language": "it",
        "@value": "Il Portale prestazioni esodo gestisce le fasi operative del processo di accompagnamento a pensione dei lavoratori di un’azienda esodante."
      },
      "dct:abstract": {
        "@language": "it",
        "@value": "Domanda di accreditamento al portale per aziende esodanti per erogare prestazioni di accompagnamento a pensione ai lavoratori che ne accettano le condizioni"
      },
      "foaf:page": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50292.portale-prestazioni-esodo.html",
