    {
      "@id": "https://www.agenziaentrate.gov.it/portale/schede/fabbricatiterreni/interrogazione-registro-delle-comunicazioni/interrogazione-registro-delle-comunicazioni",
      "@type": "cpsv:PublicService",
      "cv:hasCompetentAuthority": {
        "@id": "https://www.agenziaentrate.gov.it"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Interrogazione registro delle comunicazioni"
      },
      "dct:description": {
        "@language": "it",
        "@value": "Le informazioni contenute nelle banche dati ipotecarie sono pubbliche e, dunque, l’accesso è consentito a tutti. Il servizio \"Interrogazione del Registro delle comunicazioni\", in particolare, permette di conoscere lo stato di lavorazione della cancellazione di un'ipoteca. È gratuito e disponibile presso Alle informazioni si accede fornendo il codice fiscale del debitore. Prima di utilizzare il servizio, leggi l’ informativa sul trattamento dei dati personali"
      },
