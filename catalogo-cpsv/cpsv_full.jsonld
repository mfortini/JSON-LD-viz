      "dct:description": {
        "@language": "it",
        "@value": "L'INPS indice ogni anno un concorso per l’assegnazione di un contributo per soggiorni estivi agli iscritti al Nuovo Fondo Mutualità dell'ex IPOST."
      },
      "dct:abstract": {
