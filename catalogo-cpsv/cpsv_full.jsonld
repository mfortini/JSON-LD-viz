    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.assegno-di-cura-e-sostentamento-acs-a-seguito-di-malattia-tubercolare-50100.assegno-di-cura-e-sostentamento-acs-a-seguito-di-malattia-tubercolare.html",
      "@type": "cpsv:PublicService",
      "cv:hasCompetentAuthority": {
        "@id": "https://www.inps.it"
      },
      "dct:identifier": "IT_bb5f35ec-49cb-45e2-8a72-a53ba44e35ec",
      "cpsv:otherServiceCode": "IT_bb5f35ec-49cb-45e2-8a72-a53ba44e35ec",
      "dct:title": {
        "@language": "it",
        "@value": "Assegno di Cura e Sostentamento (ACS) a seguito di malattia tubercolare"
      },
      "dct:description": {
        "@language": "it",
        "@value": "L’ Assegno di Cura e Sostentamento (ACS) viene riconosciuto, a carico dell’INPS, in misura fissa, quando, a seguito di malattia tubercolare , la capacità di guadagno, in relazione alle proprie attitudini, si è ridotta a meno della metà e non si percepisce una normale retribuzione continuativa a tempo pieno."
      },
      "dct:abstract": {
        "@language": "it",
        "@value": "Domanda per assegno di cura e sostentamento per diversi soggetti che soffrono della malattia tubercolare e con retribuzione ridotta a meno della metà"
      },
      "foaf:page": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.assegno-di-cura-e-sostentamento-acs-a-seguito-di-malattia-tubercolare-50100.assegno-di-cura-e-sostentamento-acs-a-seguito-di-malattia-tubercolare.html",
