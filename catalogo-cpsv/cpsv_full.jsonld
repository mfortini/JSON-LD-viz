    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.assistenza-domiciliare-hcp-home-care-premium-per-persone-non-autosufficienti-servizi-di-consultazione.html",
