      },
      "dct:description": {
        "@language": "it",
        "@value": "È un trattamento pensionistico anticipato , calcolato secondo il sistema contributivo, erogato a domanda alle lavoratrici che hanno maturato i requisiti anagrafici e contributivi richiesti entro il 31 dicembre 2021 ."
      },
      "dct:abstract": {
