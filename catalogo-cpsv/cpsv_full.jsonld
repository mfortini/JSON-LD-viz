    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.ricorso-amministrativo-pensionistico-51189.ricorso-amministrativo-pensionistico.html#addressee-Pensionati-%20Patronati-%20Dipendenti%20privati-%20Dipendenti%20pubblici",
      "@type": "cv:Agent",
