    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50156.domande-di-costituzione-prosecuzione-variazione-e-cancellazione-di-rapporto-di-lavoro-agricolo-di-piccola-colonia-o-compartecipazione-familiare.html#addressee-Associazioni%20di%20categoria%20e%20sindacati-%20Aziende%20agricole-%20Intermediari%20e%20consulenti",
      "@type": "cv:Agent",
