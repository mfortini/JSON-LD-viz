      "dct:identifier": "IT_b6649b94-5a1d-484a-96c6-203ead07f811",
      "cpsv:otherServiceCode": "IT_b6649b94-5a1d-484a-96c6-203ead07f811",
      "dct:title": {
        "@language": "it",
        "@value": "Sussidio scolastico a orfani di iscritti ex IPOST"
      },
      "dct:description": {
        "@language": "it",
        "@value": "L’INPS indice annualmente un concorso per il conferimento di sussidi scolastici per l’iscrizione e la frequenza di:\n\nasili nido; scuole materne; scuole elementari; scuole medie; scuole medie superiori; corsi di laurea."
      },
      "dct:abstract": {
        "@language": "it",
        "@value": "Domanda di partecipazione al concorso per il conferimento di sussidi scolastici per orfani dei dipendenti del Gruppo Poste Italiane SpA ed ex IPOST"
      },
      "foaf:page": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.sussidio-scolastico-a-orfani-di-iscritti-ex-ipost-50051.sussidio-scolastico-a-orfani-di-iscritti-ex-ipost.html",
