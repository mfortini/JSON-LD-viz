      }
    },
    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.autorizzazione-al-versamento-di-contribuzione-aggiuntiva-per-mandato-sindacale--50107.autorizzazione-al-versamento-di-contribuzione-aggiuntiva-per-mandato-sindacale-.html#website-channel",
