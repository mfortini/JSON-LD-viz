      "dct:title": {
        "@language": "it",
        "@value": "Incentivo decreto Coesione: domanda"
      },
      "dct:description": {
        "@language": "it",
        "@value": "L ’Incentivo decreto Coesione è un contributo di 500 euro mensili, per 36 mesi, per giovani under 35 disoccupati."
      },
      "dct:abstract": {
        "@language": "it",
        "@value": "Domanda per l’Incentivo decreto Coesione di 500 euro mensili con durata di 36 mesi a giovani under 35 disoccupati che avviano attività nei settori strategici"
      },
      "foaf:page": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.incentivo-decreto-coesione-domanda.html",
