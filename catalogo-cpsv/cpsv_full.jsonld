    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.richiesta-visite-mediche-di-controllo-vmc-lavoratori-privati-e-pubblici-polo-unico-51200.richiesta-visite-mediche-di-controllo-vmc-lavoratori-privati-e-pubblici-polo-unico.html#addressee-Amministrazioni%2C%20Enti%20e%20Aziende",
      "@type": "cv:Agent",
      "skos:prefLabel": {
