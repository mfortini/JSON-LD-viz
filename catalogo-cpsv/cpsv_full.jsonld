      "dct:description": {
        "@language": "it",
        "@value": "Addetti ai lavori, studiosi e semplici appassionati del settore dell’automotive che vogliono approfondire le proprie conoscenze statistiche automobilistiche."
      }
    },
    {
      "@id": "https://aci.gov.it/servizio/assistenza-e-richiesta-dati-statistici/#input-cosa-serve",
