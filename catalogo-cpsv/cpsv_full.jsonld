    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.estate-inpsieme-senior-50038.estate-inpsieme-senior.html#addressee-Pensionati",
      "@type": "cv:Agent",
