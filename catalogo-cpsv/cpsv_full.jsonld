    },
    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.portale-prestazioni-welfare-accesso-operatore-collegi-gestione-beneficio.html#addressee-Amministrazioni%2C%20Enti%20e%20Aziende",
