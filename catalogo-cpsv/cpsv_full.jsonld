    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.reddito-di-libert-.html#addressee-Amministrazioni%2C%20Enti%20e%20Aziende",
      "@type": "cv:Agent",
      "skos:prefLabel": {
        "@language": "it",
        "@value": "Amministrazioni, Enti e Aziende"
      }
    },
    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.reddito-di-libert-.html#addressee-CAF",
