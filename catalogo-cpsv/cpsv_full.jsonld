    },
    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.riscatto-dei-periodi-per-contributi-omessi-e-prescritti-50255.riscatto-dei-periodi-per-contributi-omessi-e-prescritti.html#addressee-Patronati",
      "@type": "cv:Agent",
