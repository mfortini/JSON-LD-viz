      "dct:title": {
        "@language": "it",
        "@value": "Indennità Straordinaria di Continuità Reddituale e Operativa (ISCRO)"
      },
      "dct:description": {
        "@language": "it",
        "@value": "L’ Indennità Straordinaria di Continuità Reddituale e Operativa (ISCRO) è stata istituita in via sperimentale per il triennio 2021-2023 dalla legge di bilancio 2021 (art. 1, commi 386-400, l. 178/2020) e riconosciuta a regime, a partire dal 1° gennaio 2024, con la legge di bilancio 2024 (art. 1, commi 142-155, l. 213/2023)."
      },
