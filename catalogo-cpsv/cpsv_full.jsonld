    {
      "@id": "https://www.agenziaentrate.gov.it/portale/servizi/servizitrasversali/altri/sid2",
      "@type": "cpsv:PublicService",
      "cv:hasCompetentAuthority": {
        "@id": "https://www.agenziaentrate.gov.it"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Sistema di Interscambio flussi Dati (SID)"
      },
      "dct:description": {
        "@language": "it",
        "@value": "L’Agenzia rende disponibile all’interno dell’area riservata il software per la generazione dei certificati e quello per l’elaborazione dei flussi scambiati tramite ogni specifico servizio. Per la corretta esecuzione di ciascuna applicazione è necessario installare la Java Virtual Machine (JVM versione 1.8. o successive) integrata con le policy java indispensabili per la crittografia dei file. Le modalità di installazione e di utilizzo di ciascuna applicazione sono illustrate all’interno del manuale di istruzioni reperibile nella sezione Manuali e guide operative , del menù a sinistra."
      },
      "dct:abstract": {
        "@language": "it",
