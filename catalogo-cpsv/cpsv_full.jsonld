    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50021.estinzione-anticipata-del-riscatto-ai-fini-tfs-tfr-con-piano-di-ammortamento-in-corso.html#addressee-description",
