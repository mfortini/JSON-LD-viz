      "dct:identifier": "IT_001087f9-0145-42c3-86c2-7efdc82f41f1",
      "cpsv:otherServiceCode": "IT_001087f9-0145-42c3-86c2-7efdc82f41f1",
      "dct:title": {
        "@language": "it",
        "@value": "Rimborso dei crediti contributivi alle aziende"
      },
      "dct:description": {
        "@language": "it",
        "@value": "Nel caso in cui il credito a favore del datore di lavoro derivi da una regolarizzazione contributiva relativa a periodi precedenti, il credito dovrà essere chiesto a rimborso o posto in compensazione legale .\n\nPer questa tipologia di crediti non è prevista la compensazione attraverso il modello F24 ."
      },
      "dct:abstract": {
        "@language": "it",
        "@value": "Istanza di rimborso creditizio derivante da regolarizzazione contributiva per datori di lavoro"
      },
      "foaf:page": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.rimborso-dei-crediti-contributivi-alle-aziende-50027.rimborso-dei-crediti-contributivi-alle-aziende.html",
      "dct:language": "http://publications.europa.eu/resource/authority/language/ITA",
      "dct:issued": "3 aprile 2017",
      "dct:modified": "17 giugno 2026",
