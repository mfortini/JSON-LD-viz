    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.pensione-opzione-donna-legge-di-bilancio-2023-legge-di-bilancio-2024-e-legge-di-bilancio-2025.html",
      "@type": "cpsv:PublicService",
