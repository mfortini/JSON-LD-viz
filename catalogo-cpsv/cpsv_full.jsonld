      "cpsv:otherServiceCode": "IT_ea52e2f0-dded-4bfe-97f0-14f415a15913",
      "dct:title": {
        "@language": "it",
        "@value": "Contributi formativi per figli e orfani di iscritti alla Gestione Assistenza Magistrale"
      },
      "dct:description": {
        "@language": "it",
        "@value": "Lo Statuto della Gestione Assistenza Magistrale prevede, tra le prestazioni assistenziali, l’erogazione di contributi formativi in favore di figli, orfani ed equiparati di iscritti alla Gestione , in condizione di disabilità ."
      },
      "dct:abstract": {
        "@language": "it",
        "@value": "Erogazione di contributi formativi per figli o orfani ed equiparati di dipendente o pensionato iscritto alla Gestione magistrale in condizione di disabilità"
      },
