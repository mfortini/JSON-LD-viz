    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50039.ammissione-case-albergo-pensionati-iscritti-gestione-unitaria-prestazioni-creditizie-e-sociali-e-loro-coniugi.html",
      "@type": "cpsv:PublicService",
      "cv:hasCompetentAuthority": {
