      "dct:title": {
        "@language": "it",
        "@value": "Riscatto dei periodi di lavoro compiuti all'estero"
      },
      "dct:description": {
        "@language": "it",
        "@value": "È una facoltà che permette di riscattare i periodi di lavoro subordinato :\n\nsvolti all'estero ; non coperti da assicurazione sociale riconosciuta dalla legislazione italiana."
      },
      "dct:abstract": {
