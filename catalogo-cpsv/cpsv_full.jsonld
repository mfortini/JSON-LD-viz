    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.54352.esonero-contributivo-art-43-bis-decreto-legge-109-2018-.html",
      "@type": "cpsv:PublicService",
      "cv:hasCompetentAuthority": {
        "@id": "https://www.inps.it"
      },
      "dct:identifier": "IT_8bd8aed8-f990-4a0e-b279-434c0fb8d8e3",
      "cpsv:otherServiceCode": "IT_8bd8aed8-f990-4a0e-b279-434c0fb8d8e3",
      "dct:title": {
        "@language": "it",
        "@value": "Esonero contributivo (art. 43 bis, decreto-legge 109/2018)"
      },
      "dct:description": {
        "@language": "it",
        "@value": "L’ esonero contributivo consente alle aziende di:\n\nnon versare al Fondo di Tesoreria le quote di TFR maturate durante i periodi di Cassa Integrazione Guadagni Straordinaria (CIGS), riferite alla retribuzione non percepita per riduzione o sospensione dell’orario di lavoro (art. 44, d.l. 109/2018); non versare il ticket di licenziamento , normalmente dovuto in caso di cessazione del rapporto di lavoro."
      },
      "dct:abstract": {
        "@language": "it",
        "@value": "Domanda di esonero dal versamento del TFR nei periodi di CIGS e del ticket di licenziamento per società in fallimento o in amministrazione straordinaria"
      },
      "foaf:page": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.54352.esonero-contributivo-art-43-bis-decreto-legge-109-2018-.html",
      "dct:language": "http://publications.europa.eu/resource/authority/language/ITA",
      "dct:issued": "27 ottobre 2020",
      "dct:modified": "14 gennaio 2026",
