    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.congedo-indennizzato-per-le-donne-vittime-di-violenza-di-genere-52401.congedo-indennizzato-per-le-donne-vittime-di-violenza-di-genere.html#addressee-Cittadini",
