      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.assegno-per-il-nucleo-familiare-ai-lavoratori-domestici-51717.assegno-per-il-nucleo-familiare-ai-lavoratori-domestici.html#addressee-Cittadini",
      "@type": "cv:Agent",
