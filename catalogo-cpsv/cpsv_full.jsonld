      }
    },
    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50599.cassa-integrazione-guadagni-ordinaria.html#addressee-Intermediari%20e%20consulenti",
