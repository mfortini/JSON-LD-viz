    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.richiesta-di-accertamento-sanitario-per-dipendenti-pubblici.html",
      "@type": "cpsv:PublicService",
      "cv:hasCompetentAuthority": {
        "@id": "https://www.inps.it"
      },
      "dct:identifier": "IT_db2c3b0c-9471-49e5-ac75-765960cc2f35",
      "cpsv:otherServiceCode": "IT_db2c3b0c-9471-49e5-ac75-765960cc2f35",
      "dct:title": {
        "@language": "it",
        "@value": "Richiesta di accertamento sanitario per dipendenti pubblici"
      },
      "dct:description": {
        "@language": "it",
        "@value": "Il servizio serve a presentare le richieste di accertamento sanitario e medico-legale per i dipendenti pubblici .\n\nA chi è rivolto\n\nPossono presentare le richieste:\n\ngli enti ; le amministrazioni pubbliche ; i datori di lavoro , il cui personale è rimasto iscritto alla Gestione esclusiva o al Fondo Quiescenza Poste."
      },
      "dct:abstract": {
        "@language": "it",
        "@value": "Domanda di accertamento sanitario e medico-legale per dipendenti del settore pubblico"
      },
