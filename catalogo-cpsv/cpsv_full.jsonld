    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50577.prestazione-di-accompagnamento-alla-pensione.html#website-channel",
      "@type": "cpsv:WebSiteChannel",
      "foaf:page": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50577.prestazione-di-accompagnamento-alla-pensione.html"
    },
    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50577.prestazione-di-accompagnamento-alla-pensione.html#addressee-Amministrazioni%2C%20Enti%20e%20Aziende",
