    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.assegno-per-il-nucleo-familiare-lavoratori-agricoli-58681.assegno-per-il-nucleo-familiare-lavoratori-agricoli.html#addressee-Agricoli-%20Patronati",
