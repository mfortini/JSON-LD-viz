    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.assegno-per-congedo-matrimoniale-50089.assegno-per-congedo-matrimoniale-a-pagamento-diretto.html#addressee-Patronati",
