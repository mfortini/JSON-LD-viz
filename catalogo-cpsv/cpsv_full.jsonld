    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.53721.importo-aggiuntivo-delle-pensioni.html",
      "@type": "cpsv:PublicService",
      "cv:hasCompetentAuthority": {
        "@id": "https://www.inps.it"
      },
      "dct:identifier": "IT_c6e00062-5520-4544-8715-a9a058fb7bd2",
      "cpsv:otherServiceCode": "IT_c6e00062-5520-4544-8715-a9a058fb7bd2",
      "dct:title": {
        "@language": "it",
        "@value": "Importo aggiuntivo delle pensioni"
      },
      "dct:description": {
        "@language": "it",
        "@value": "L’ importo aggiuntivo è un’erogazione supplementare alla pensione :\n\npari a 154,94 euro ; introdotta dalla legge finanziaria 2001 (art. 70, legge 23 dicembre 2000, n. 388); riconosciuta a chi percepisce una o più pensioni con un importo complessivo non superiore al trattamento minimo e che si trovi in determinate condizioni reddituali."
      },
      "dct:abstract": {
        "@language": "it",
        "@value": "Domanda di un importo aggiuntivo supplementare alla pensione per chi percepisce una o più pensioni non superiori complessivamente all'importo minimo"
      },
      "foaf:page": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.53721.importo-aggiuntivo-delle-pensioni.html",
