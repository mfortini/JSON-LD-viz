    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50290.indennit-per-congedo-parentale-per-lavoratrici-e-lavoratori-iscritti-alla-gestione-separata.html#website-channel",
