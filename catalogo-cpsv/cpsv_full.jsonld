    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50010.accredito-dei-contributi-figurativi-per-congedo-parentale-durante-il-rapporto-di-lavoro.html#website-channel",
