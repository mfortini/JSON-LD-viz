      "cpsv:otherServiceCode": "IT_2cd849c0-0da1-4109-9dac-53b561d99fcf",
      "dct:title": {
        "@language": "it",
        "@value": "Rimborso ai datori di lavoro per i giorni di riposo del lavoratore che dona il sangue"
      },
      "dct:description": {
        "@language": "it",
        "@value": "Al lavoratore dipendente che dona il proprio sangue gratuitamente viene concessa una giornata di riposo retribuita."
      },
      "dct:abstract": {
        "@language": "it",
        "@value": "Domanda di rimborso delle retribuzioni corrisposte ai lavoratori per le ore non lavorate nella giornata di donazione del sangue per datori di lavoro"
      },
      "foaf:page": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50106.rimborso-ai-datori-di-lavoro-per-i-giorni-di-riposo-del-lavoratore-che-dona-il-sangue.html",
