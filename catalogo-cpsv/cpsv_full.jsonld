    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.Contributi-volontari-gestione-privata.html",
      "@type": "cpsv:PublicService",
      "cv:hasCompetentAuthority": {
