    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.accredito-contributi-figurativi-lsu-finanziati-da-enti-utilizzatori-51997.accredito-contributi-figurativi-lsu-finanziati-da-enti-utilizzatori.html",
      "@type": "cpsv:PublicService",
      "cv:hasCompetentAuthority": {
