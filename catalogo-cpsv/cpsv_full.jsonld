      "dct:title": {
        "@language": "it",
        "@value": "Assegni familiari"
      },
      "dct:description": {
        "@language": "it",
        "@value": "Gli Assegni familiari sono una prestazione economica a sostegno delle famiglie di alcune categorie di lavoratori:\n\nche lavorano in Italia; con reddito complessivo inferiore ai limiti stabiliti annualmente dalla legge."
      },
      "dct:abstract": {
        "@language": "it",
        "@value": "Domanda di sostegno alle famiglie di lavoratori con reddito complessivo inferiore ai limiti stabiliti dalla legge."
      },
