    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50069.piccolo-prestito-iscritti-gestione-unitaria-prestazioni-creditizie-sociali-gestione-speciale-previdenza-personale-poste-italiane-spa-fondo-credito-ex-ipost.html#addressee-Amministrazioni%2C%20Enti%20e%20Aziende",
