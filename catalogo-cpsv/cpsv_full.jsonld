      "dct:title": {
        "@language": "it",
        "@value": "Ricongiunzione contributi da una gestione previdenziale a CPDEL, CPS, CPI, CPUG o CTPS"
      },
      "dct:description": {
        "@language": "it",
        "@value": "È un servizio che permette di trasferire in una sola gestione i contributi versati in più gestioni previdenziali, per ottenere una pensione unica ."
      },
      "dct:abstract": {
        "@language": "it",
        "@value": "Domanda di ricongiunzione nelle Gestioni dei dipendenti pubblici in un’unica gestione, dei contributi versati in più gestioni previdenziali per ottenere una pensione unica"
      },
      "foaf:page": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.ricongiunzione-contributi-da-casse-private-e-professionistiche-a-pubbliche-50154.ricongiunzione-contributi-da-una-gestione-previdenziale-a-CPDEL-CPS-CPI-CPU-o-CTPS.html",
