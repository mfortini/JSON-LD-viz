    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.sussidi-fondi-mutualit-gruppo-poste-italiane-52431.sussidi-fondi-mutualit-gruppo-poste-italiane.html#website-channel",
