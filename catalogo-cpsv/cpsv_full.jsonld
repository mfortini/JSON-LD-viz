    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.borse-di-studio-supermedia-per-scuola-secondaria-di-primo-e-secondo-grado.html#addressee-Dipendenti%20Pubblici",
      "@type": "cv:Agent",
