    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.ammissione-alla-casa-di-riposo-per-marittimi-g-bettolo-di-camogli-51692.ammissione-alla-casa-di-riposo-per-marittimi-g-bettolo-di-camogli.html#website-channel",
