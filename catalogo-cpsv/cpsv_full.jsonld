    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50081.indennit-di-accompagnamento-ai-ciechi-civili-assoluti.html#addressee-Associazioni%20di%20categoria%20e%20sindacati-%20Patronati-%20Persone%20con%20disabilit%C3%A0%20e%20invalidit%C3%A0",
