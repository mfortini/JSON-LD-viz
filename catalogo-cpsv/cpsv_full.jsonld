      "dct:title": {
        "@language": "it",
        "@value": "TROVA – Gestione archivi di deposito affidati ai fornitori esterni aggiudicatari della gara nazionale"
      },
      "dct:description": {
        "@language": "it",
        "@value": "Il servizio “T.R.O.V.A.” ha lo scopo di censire, monitorare e ricercare il patrimonio documentale cartaceo conservato presso gli outsourcer affidatari dei sei lotti della gara nazionale degli archivi."
      },
