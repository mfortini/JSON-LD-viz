      "dct:title": {
        "@language": "it",
        "@value": "Indennità Giornaliera (IG) per malattia tubercolare"
      },
      "dct:description": {
        "@language": "it",
        "@value": "È un' indennità riconosciuta per il periodo delle cure ospedaliere o ambulatoriali/domiciliari .\n\nNon spetta qualora il lavoratore abbia diritto all'intera retribuzione."
      },
      "dct:abstract": {
        "@language": "it",
        "@value": "Domanda di indennità giornaliera per cure ospedaliere o ambulatoriali per soggetti affetti da tubercolosi ai quali non spetta l’intera retribuzione"
      },
