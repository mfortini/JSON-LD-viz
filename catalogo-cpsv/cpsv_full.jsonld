      "dct:identifier": "IT_376dd0e7-58e3-4e74-a5f3-81a1959d90b2",
      "cpsv:otherServiceCode": "IT_376dd0e7-58e3-4e74-a5f3-81a1959d90b2",
      "dct:title": {
        "@language": "it",
        "@value": "Contributo cure termali per iscritti al Vecchio Fondo Mutualità IPOST"
      },
      "dct:description": {
        "@language": "it",
        "@value": "L'INPS pubblica, ogni anno, un bando di concorso per l’assegnazione di un contributo per cure termali agli iscritti al Vecchio Fondo Mutualità dell'ex IPOST."
      },
      "dct:abstract": {
        "@language": "it",
        "@value": "Richiesta del contributo per cure termali per tutti gli iscritti al Vecchio Fondo di Mutualità dell’ex IPOST con un capitale di almeno 516,46 euro"
      },
      "foaf:page": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50035.contributo-cure-termali-per-iscritti-al-vecchio-fondo-mutualit-ipost.html",
