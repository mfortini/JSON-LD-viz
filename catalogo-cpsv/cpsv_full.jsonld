    },
    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.benefici-in-favore-delle-vittime-del-terrorismo-50731.benefici-in-favore-delle-vittime-del-terrorismo.html#addressee-Patronati",
