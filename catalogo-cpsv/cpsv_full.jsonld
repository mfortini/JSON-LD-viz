    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.malattia-lavoratori-marittimi-comunicazione-integrativa-55695.malattia-lavoratori-marittimi-comunicazione-integrativa.html#addressee-Patronati",
