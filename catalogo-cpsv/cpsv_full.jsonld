    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.finanziamento-dei-programmi-formativi-per-lavoratori-dipendenti-di-aziende-iscritte-a-fondi-di-solidariet.html#website-channel",
