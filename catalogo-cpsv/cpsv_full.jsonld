      "dct:issued": "26 giugno 2026",
      "dct:modified": "2024-06-19T20:26:18.5Z",
      "cpsv:hasTheme": [
        {
          "@id": "https://w3id.org/italia/controlled-vocabulary/classifications-for-public-services/public-services-subject-matters/2"
