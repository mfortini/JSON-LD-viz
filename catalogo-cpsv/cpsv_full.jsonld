      "dct:title": {
        "@language": "it",
        "@value": "Gestione Assistenza Magistrale: assegno temporaneo integrativo"
      },
      "dct:description": {
        "@language": "it",
        "@value": "INPS riconosce un assegno temporaneo integrativo agli iscritti alla Gestione Assistenza Magistrale o ai loro superstiti, privi di reddito o con un reddito complessivo familiare annuo inferiore agli importi stabiliti."
      },
      "dct:abstract": {
        "@language": "it",
        "@value": "Domanda di assegno temporaneo integrativo per iscritti alla Gestione Assistenza Magistrale o loro superstiti in condizioni economiche disagiate"
      },
      "foaf:page": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.gestione-assistenza-magistrale-assegno-temporaneo-integrativo.html",
