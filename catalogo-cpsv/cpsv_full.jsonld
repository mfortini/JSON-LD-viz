      },
      "dct:identifier": "IT_4f366624-d9a1-48de-b570-8527d43cfe1c",
      "cpsv:otherServiceCode": "IT_4f366624-d9a1-48de-b570-8527d43cfe1c",
      "dct:title": {
        "@language": "it",
        "@value": "Quattordicesima"
      },
      "dct:description": {
        "@language": "it",
        "@value": "È una somma aggiuntiva alla pensione corrisposta dall'INPS a luglio o a dicembre di ogni anno, introdotta dalla legge 3 agosto 2007, n. 127 e modificata dall'articolo 1, comma 187, 11 dicembre 2016, n. 232, che ha esteso la platea dei beneficiari e modificato gli importi da corrispondere."
      },
      "dct:abstract": {
        "@language": "it",
        "@value": "Domanda di ricostituzione reddituale della quattordicesima per pensionati di almeno 64 anni con reddito fino a due volte il trattamento annuo del FPLD"
      },
      "foaf:page": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.quattordicesima-50602.quattordicesima.html",
