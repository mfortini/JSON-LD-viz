      },
      "dct:identifier": "IT_6cb5b2be-018b-4ed6-ae28-565c83cdfaab",
      "cpsv:otherServiceCode": "IT_6cb5b2be-018b-4ed6-ae28-565c83cdfaab",
      "dct:title": {
        "@language": "it",
        "@value": "Interruzione pagamento rate di riscatto ai fini pensionistici Gestione Dipendenti Pubblici"
      },
      "dct:description": {
        "@language": "it",
        "@value": "Il riscatto consente di valutare, a domanda, periodi e servizi altrimenti non utili ai fini pensionistici mediante il pagamento di un contributo a carico del richiedente.\n\nIn caso di pagamento rateale, è possibile richiedere l’ interruzione del pagamento rateale dell’onere di riscatto ."
      },
      "dct:abstract": {
        "@language": "it",
        "@value": "Domanda di interruzione dei pagamenti rateali dell’onere di riscatto e ricalcolo per iscritti alle Casse Pensioni della Gestione Pubblica"
      },
      "foaf:page": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50142.interruzione-del-pagamento-delle-rate-di-riscatto-ai-fini-pensionistici-gestione-dipendenti-pubblici.html",
