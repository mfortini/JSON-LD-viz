    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.riscatto-a-fini-pensionistici-per-iscritti-alle-casse-cpdel-cps-cpi-e-cpug-50143.riscatto-a-fini-pensionistici-per-iscritti-alle-casse-cpdel-cps-cpi-e-cpug.html#addressee-Patronati",
