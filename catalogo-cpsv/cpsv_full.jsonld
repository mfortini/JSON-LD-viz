      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.morosit-incolpevole-sospendere-l-ammortamento-o-rinegoziare-il-mutuo-50070.morosit-incolpevole-sospendere-l-ammortamento-o-rinegoziare-il-mutuo.html",
      "@type": "cpsv:PublicService",
      "cv:hasCompetentAuthority": {
