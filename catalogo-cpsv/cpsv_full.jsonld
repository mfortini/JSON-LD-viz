      "dct:title": {
        "@language": "it",
        "@value": "Pensione Quota 100"
      },
      "dct:description": {
        "@language": "it",
        "@value": "È una prestazione economica erogata, a domanda, ai lavoratori dipendenti e autonomi che maturano, nel periodo compreso tra il 1° gennaio 2019 e il 31 dicembre 2021, i requisiti prescritti dalla legge."
      },
      "dct:abstract": {
