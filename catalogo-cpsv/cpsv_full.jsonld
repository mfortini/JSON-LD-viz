      "dct:title": {
        "@language": "it",
        "@value": "Indennità per congedi straordinari (assistenza familiari disabili)"
      },
      "dct:description": {
        "@language": "it",
        "@value": "Il congedo straordinario è un periodo di assenza dal lavoro retribuito concesso ai lavoratori dipendenti che assistano familiari con disabilità grave ai sensi dell’articolo 3, comma 3, legge 5 febbraio 1992, n. 104."
      },
