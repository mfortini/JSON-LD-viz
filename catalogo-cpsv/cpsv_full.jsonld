      "dct:title": {
        "@language": "it",
        "@value": "Riscatto dei periodi per gli iscritti alle Gestioni private"
      },
      "dct:description": {
        "@language": "it",
        "@value": "I contributi da riscatto permettono di valorizzare, con pagamento di un importo a carico del richiedente, specifici periodi scoperti da contribuzione .\n\nI contributi vengono accreditati dopo l’accoglimento della richiesta:\n\ndel lavoratore; del pensionato; dei loro superstiti."
      },
