    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50109.mobilit-in-deroga---indennit-concessa-dalle-regioni-e-province-autonome-e-dal-ministero-del-lavoro-e-delle-politiche-sociali.html#addressee-Cittadini",
