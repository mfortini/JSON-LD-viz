    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.assegno-sociale-50184.assegno-sociale.html",
      "@type": "cpsv:PublicService",
      "cv:hasCompetentAuthority": {
        "@id": "https://www.inps.it"
      },
      "dct:identifier": "IT_5c741d0d-6831-42a1-b915-1822d80f28e2",
      "cpsv:otherServiceCode": "IT_5c741d0d-6831-42a1-b915-1822d80f28e2",
      "dct:title": {
        "@language": "it",
        "@value": "Assegno sociale"
      },
      "dct:description": {
        "@language": "it",
        "@value": "L' Assegno sociale è una prestazione economica, erogata a domanda, rivolta ai cittadini italiani e stranieri in condizioni economiche disagiate e con redditi inferiori alle soglie previste annualmente dalla legge.\n\nDal 1° gennaio 1996, l'Assegno sociale ha sostituito la pensione sociale .\n\nLa prestazione ha natura assistenziale.\n\nIl beneficio economico non è:\n\nreversibile ai familiari superstiti; gravato da imposte; esportabile; cedibile; sequestrabile; pignorabile."
      },
      "dct:abstract": {
        "@language": "it",
        "@value": "Domanda di Assegno sociale per cittadini italiani e stranieri in condizioni economiche disagiate e con redditi annuali inferiori alle soglie di legge"
      },
      "foaf:page": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.assegno-sociale-50184.assegno-sociale.html",
      "dct:language": "http://publications.europa.eu/resource/authority/language/ITA",
      "dct:issued": "3 aprile 2017",
      "dct:modified": "5 maggio 2026",
