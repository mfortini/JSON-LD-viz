      "dct:title": {
        "@language": "it",
        "@value": "Malattia e degenza ospedaliera per lavoratori iscritti alla Gestione Separata"
      },
      "dct:description": {
        "@language": "it",
        "@value": "L’ indennità di malattia e l’ indennità per degenza ospedaliera sono riconosciute ai lavoratori che, per motivi di salute, si trovano temporaneamente incapaci a svolgere l’attività lavorativa ."
      },
