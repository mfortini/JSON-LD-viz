    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.assegno-per-il-nucleo-familiare-per-gli-iscritti-alla-gestione-separata-51312.assegno-per-il-nucleo-familiare-per-gli-iscritti-alla-gestione-separata.html#addressee-Patronati",
