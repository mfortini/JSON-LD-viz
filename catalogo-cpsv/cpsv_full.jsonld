    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50128.trasmissione-uniemens-dmag-per-datori-di-lavoro-che-assumono-operai-agricoli.html",
      "@type": "cpsv:PublicService",
      "cv:hasCompetentAuthority": {
        "@id": "https://www.inps.it"
      },
      "dct:identifier": "IT_37b287d2-3284-4f42-8824-56a5185b6087",
      "cpsv:otherServiceCode": "IT_37b287d2-3284-4f42-8824-56a5185b6087",
      "dct:title": {
        "@language": "it",
        "@value": "Trasmissione UNIEMENS/DMAG per datori di lavoro che assumono operai agricoli"
      },
      "dct:description": {
        "@language": "it",
        "@value": "A decorrere dai periodi retributivi di aprile 2020 è stato esteso ai datori di lavoro che assumono operai agricoli a tempo determinato o indeterminato (manodopera agricola) l’ obbligo di utilizzo del flusso Uniemens mensile .\n\nNel flusso Uniemens/PosAgri devono essere dichiarati i dati retributivi e contributivi della manodopera agricola ai fini dell'accertamento e della riscossione dei contributi.\n\nPer i periodi precedenti ad aprile 2020 deve essere utilizzato il modello trimestrale DMAG."
      },
      "dct:abstract": {
        "@language": "it",
        "@value": "Il servizio è utile alla dichiarazione delle giornate di compartecipanti individuali ed è dedicato a datori di lavoro che assumono manodopera agricola"
      },
      "foaf:page": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50128.trasmissione-uniemens-dmag-per-datori-di-lavoro-che-assumono-operai-agricoli.html",
      "dct:language": "http://publications.europa.eu/resource/authority/language/ITA",
      "dct:issued": "3 aprile 2017",
      "dct:modified": "14 ottobre 2021",
      "cpsv:hasWebSiteChannel": {
        "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50128.trasmissione-uniemens-dmag-per-datori-di-lavoro-che-assumono-operai-agricoli.html#website-channel"
      },
      "cv:addressee": [
        {
