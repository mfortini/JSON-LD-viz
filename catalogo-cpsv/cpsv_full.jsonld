    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.reddito-di-cittadinanza-e-pensione-di-cittadinanza-53209.reddito-di-cittadinanza-e-pensione-di-cittadinanza.html#addressee-CAF",
