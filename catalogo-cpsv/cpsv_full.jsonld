      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.quattordicesima-50602.quattordicesima.html",
      "@type": "cpsv:PublicService",
      "cv:hasCompetentAuthority": {
