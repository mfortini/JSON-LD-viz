    {
      "@id": "https://www.lavoro.gov.it/strumenti-e-servizi/pagine/repertorio-degli-incentivi-allassunzione/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Repertorio degli incentivi all’assunzione"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Repertorio degli incentivi all’assunzione"
      },
      "cpsv:producedBy": {
        "@id": "https://www.lavoro.gov.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.lavoro.gov.it"
      },
      "foaf:page": "https://www.lavoro.gov.it/strumenti-e-servizi/pagine/repertorio-degli-incentivi-allassunzione/",
      "dct:description": {
        "@language": "it",
        "@value": "Il Repertorio nazionale degli incentivi per l’occupazione è il catalogo online di tutti gli incentivi per l’occupazione disponibili a livello nazionale e regionale. A chi è rivolto? Datori di lavoro, persone in cerca di occupazione e operatrici e operatori dei servizi per il lavoro. A cosa serve? Permette di consultare i diversi incentivi economici, normativi o contributivi riconosciuti alle aziende per assumere specifiche categorie di persone. Per consultare il Repertorio ricerca le schede degli incentivi, attraverso il menu in alto a sinistra, in base al tuo profilo. Vai al Repertorio nazionale degli incentivi per l’occupazione ."
      },
      "cpsv:hasChannel": {
        "@id": "https://www.lavoro.gov.it/strumenti-e-servizi/pagine/repertorio-degli-incentivi-allassunzione/#channel-online-0",
        "@type": "cpsv:OtherElectronicChannel",
        "foaf:page": "https://www.lavoro.gov.it/strumenti-e-servizi/pagine/repertorio-degli-incentivi-allassunzione/"
      }
    },
    {
      "@id": "https://www.lavoro.gov.it/strumenti-e-servizi/pagine/ricorsi-e-sanzioni-di-condizionalita/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Ricorsi e sanzioni di condizionalità"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Ricorsi e sanzioni di condizionalità"
      },
      "cpsv:producedBy": {
        "@id": "https://www.lavoro.gov.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.lavoro.gov.it"
      },
      "foaf:page": "https://www.lavoro.gov.it/strumenti-e-servizi/pagine/ricorsi-e-sanzioni-di-condizionalita/",
      "dct:description": {
        "@language": "it",
        "@value": "Comitato per i ricorsi di condizionalità Il Comitato per i ricorsi di condizionalità (previsto dall'art. 21, comma 12 del Decreto legislativo 14 settembre 2015, n. 150) è deputato a decidere sui ricorsi presentati dai percettori di NASpI/DIS-COLL avverso i provvedimenti adottati dai Centri per l'impiego. Il Comitato è composto da rappresentanti del Ministero del Lavoro e delle Politiche Sociali, dell'INPS, delle Regioni e Province Autonome e delle Parti Sociali.\nCome presentare un ricorso di condizionalità Chi ha ricevuto una sanzione del centro per l'impiego per non aver partecipato alle misure di politica attiva o per non aver accettato offerte di lavoro congrue può presentare ricorso al Comitato per i ricorsi di condizionalità. Il ricorso può essere presentato per motivi di legittimità e per motivi di merito, entro 30 giorni solari dal ricevimento della sanzione.\nIl ricorso deve essere presentato compilando l'apposito modulo e deve necessariamente essere accompagnato da copia di un documento di identità del ricorrente in corso di validità.\nAl ricorso si potrà allegare, inoltre, ulteriore documentazione ritenuta utile ai fini della definizione dello stesso da parte del Comitato…"
      },
      "cpsv:hasChannel": {
        "@id": "https://www.lavoro.gov.it/strumenti-e-servizi/pagine/ricorsi-e-sanzioni-di-condizionalita/#channel-online-0",
        "@type": "cpsv:OtherElectronicChannel",
        "foaf:page": "https://www.lavoro.gov.it/strumenti-e-servizi/pagine/ricorsi-e-sanzioni-di-condizionalita/"
      }
    },
