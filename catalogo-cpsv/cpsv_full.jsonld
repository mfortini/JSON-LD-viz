    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.ltc---ricovero-in-strutture-residenziali-long-term-care--50211.ltc-ricovero-in-strutture-residenziali-long-term-care-domanda-e-gestione-benefici.html",
      "@type": "cpsv:PublicService",
