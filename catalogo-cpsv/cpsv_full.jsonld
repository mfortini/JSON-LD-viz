      },
      "dct:description": {
        "@language": "it",
        "@value": "La gestione delle deleghe sindacali in agricoltura assicura uno scambio telematico tra l’INPS e le associazioni di categoria che favorisce la riscossione dei contributi associativi ."
      },
      "dct:abstract": {
        "@language": "it",
        "@value": "Richiesta di aggiornamento informazioni relative alla riscossione dei contributi associativi per le aziende agricole e gli autonomi in agricoltura"
      },
