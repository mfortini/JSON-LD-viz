    {
      "@id": "https://www.gse.it/servizi-per-te/supporto/come-funzionano-i-pagamenti-in-conto-energia/",
      "@type": "cpsv:PublicService",
      "cpsv:name": {
        "@language": "it",
        "@value": "Come funzionano i pagamenti in Conto Energia"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Come funzionano i pagamenti in Conto Energia"
      },
      "cpsv:producedBy": {
        "@id": "https://www.gse.it"
      },
      "cv:hasCompetentAuthority": {
        "@id": "https://www.gse.it"
      },
      "foaf:page": "https://www.gse.it/servizi-per-te/supporto/come-funzionano-i-pagamenti-in-conto-energia/",
      "dct:description": {
        "@language": "it",
        "@value": "Da I a IV Conto Energia (tariffa normale) l'incentivo è calcolato moltiplicando la quantità di energia prodotta dal tuo impianto per la tariffa incentivante\nDa IV al V Conto Energia (tariffa onnicomprensiva e tariffa premio autoconsumo) l'incentivo è dato dalla somma della tariffa fissa omnicomprensiva e della tariffa premio autoconsumo.\nL'importo della tariffa incentivante varia a seconda della potenza dell'impianto e il pagamento avviene, per ciascun anno, tramite acconti periodici costanti e un conguaglio annuale .\nL'acconto viene erogato sulla base della stima dell'energia prodotta. Per quantificare l'importo il GSE considera l'energia prodotta dall'impianto negli ultimi anni fino al periodo di riferimento"
      },
      "cpsv:hasChannel": {
        "@id": "https://www.gse.it/servizi-per-te/supporto/come-funzionano-i-pagamenti-in-conto-energia/#channel-online-0",
        "@type": "cpsv:OtherElectronicChannel",
        "foaf:page": "https://www.gse.it/servizi-per-te/supporto/come-funzionano-i-pagamenti-in-conto-energia/"
      }
    },
