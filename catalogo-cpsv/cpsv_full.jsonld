    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.Fondo-PSMSAD-disciplina-informazioni-e-iscrizione.html#website-channel",
      "@type": "cpsv:WebSiteChannel",
      "foaf:page": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.Fondo-PSMSAD-disciplina-informazioni-e-iscrizione.html"
    },
    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.Fondo-PSMSAD-disciplina-informazioni-e-iscrizione.html#addressee-description",
      "@type": "cv:Agent",
      "dct:description": {
        "@language": "it",
        "@value": "Si rivolge a cittadini italiani e comunitari :\n\nche esercitano prevalentemente e con continuità le attività di pittore, scultore, musicista, scrittore e autore drammatico ; tra i 18 e i 35 anni , non ancora dediti all'attività artistica, ma in grado di dimostrare con adeguata documentazione la loro potenzialità a intraprendere la professione artistica."
      }
    },
    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.Fondo-PSMSAD-disciplina-informazioni-e-iscrizione.html#processing-time",
      "@type": "cpsv:ServiceProcessingTime",
      "dct:description": {
        "@language": "it",
        "@value": "Il termine per la definizione del provvedimento è stato fissato in 30 giorni dal Regolamento per la definizione dei termini di conclusione dei procedimenti amministrativi adottato dall’INPS ai sensi dell’art. 2 della legge 241/1990.\n\nNella tabella (pdf 205KB) allegata al Regolamento sono riportati sia i termini di definizione dei provvedimenti stabiliti dall’Istituto superiori a quello di norma di 30 giorni, che l’indicazione del relativo responsabile."
      }
    },
    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.fondo-previdenza-marinara-estera-50622.fondo-previdenza-marinara-estera.html",
      "@type": "cpsv:PublicService",
      "cv:hasCompetentAuthority": {
        "@id": "https://www.inps.it"
      },
      "dct:identifier": "IT_22cd7441-0c33-4631-aa36-a4bc3c58532f",
      "cpsv:otherServiceCode": "IT_22cd7441-0c33-4631-aa36-a4bc3c58532f",
      "dct:title": {
        "@language": "it",
        "@value": "Fondo Previdenza marinara estera"
      },
      "dct:description": {
        "@language": "it",
        "@value": "Gli armatori e i raccomandatari marittimi possono trasmettere in maniera telematica i dati contributivi mensili dei lavoratori marittimi italiani imbarcati su navi straniere e dei piloti italiani che effettuano servizi in acque straniere."
      },
      "dct:abstract": {
        "@language": "it",
        "@value": "Trasmissione telematica dei dati contributivi mensili dei lavoratori marittimi italiani imbarcati su navi straniere, per armatori e raccomandatari marittimi"
      },
      "foaf:page": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.fondo-previdenza-marinara-estera-50622.fondo-previdenza-marinara-estera.html",
      "dct:language": "http://publications.europa.eu/resource/authority/language/ITA",
      "dct:issued": "3 aprile 2017",
      "dct:modified": "8 maggio 2026",
      "cpsv:hasWebSiteChannel": {
        "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.fondo-previdenza-marinara-estera-50622.fondo-previdenza-marinara-estera.html#website-channel"
      },
