    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.autorizzazione-al-versamento-contributi-volontari-per-lavoratori-del-settore-pubblico-50148.autorizzazione-al-versamento-contributi-volontari-per-lavoratori-del-settore-pubblico.html",
      "@type": "cpsv:PublicService",
      "cv:hasCompetentAuthority": {
        "@id": "https://www.inps.it"
      },
      "dct:identifier": "IT_826b0d41-187d-43bd-b3c3-d584d71b9133",
      "cpsv:otherServiceCode": "IT_826b0d41-187d-43bd-b3c3-d584d71b9133",
      "dct:title": {
        "@language": "it",
        "@value": "Autorizzazione al versamento contributi volontari per lavoratori del settore pubblico"
      },
      "dct:description": {
        "@language": "it",
        "@value": "I contributi volontari sono tutte quelle tipologie di contributi che vengono versati su domanda dell’iscritto che vuole proseguire la contribuzione per raggiungere il diritto alla pensione o per coprire periodi privi di contribuzione , come quelli derivanti da aspettative per motivi di studio o famiglia, interruzioni per motivi disciplinari, lavori discontinui o stagionali.\n\nVengono versati anche per integrare, ai fini della misura della pensione, i periodi di lavoro parzialmente scoperti in regime di part-time."
      },
      "dct:abstract": {
        "@language": "it",
        "@value": "Domanda di versamento dei contributi volontari per lavoratori iscritti alla Gestione Dipendenti Pubblici per proseguire la contribuzione o coprire periodi scoperti"
      },
      "foaf:page": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.autorizzazione-al-versamento-contributi-volontari-per-lavoratori-del-settore-pubblico-50148.autorizzazione-al-versamento-contributi-volontari-per-lavoratori-del-settore-pubblico.html",
