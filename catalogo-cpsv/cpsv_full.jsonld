    {
      "@id": "https://www.agenziaentrate.gov.it/portale/servizi/servizitrasversali/altri/ricevute",
      "@type": "cpsv:PublicService",
      "cv:hasCompetentAuthority": {
        "@id": "https://www.agenziaentrate.gov.it"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Ricevute"
      },
      "dct:description": {
        "@language": "it",
        "@value": "Nella sezione \"Ricevute\" sono consultabili le attestazioni per ogni invio effettuato. In particolare per ogni dichiarazione trasmessa telematicamente e regolarmente acquisita dal sistema viene predisposta una comunicazione di avvenuta presentazione; qualora invece i dati trasmessi non siano corretti, il sistema produce una comunicazione di scarto. Ulteriori informazioni sulle attestazioni delle dichiarazioni"
      },
      "dct:abstract": {
        "@language": "it",
        "@value": "Ricevute"
      },
      "foaf:page": "https://www.agenziaentrate.gov.it/portale/servizi/servizitrasversali/altri/ricevute",
