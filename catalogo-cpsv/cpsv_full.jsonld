    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.sussidio-scolastico-a-orfani-di-iscritti-ex-ipost-50051.sussidio-scolastico-a-orfani-di-iscritti-ex-ipost.html#website-channel",
