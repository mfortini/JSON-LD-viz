    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50142.interruzione-del-pagamento-delle-rate-di-riscatto-ai-fini-pensionistici-gestione-dipendenti-pubblici.html",
      "@type": "cpsv:PublicService",
      "cv:hasCompetentAuthority": {
