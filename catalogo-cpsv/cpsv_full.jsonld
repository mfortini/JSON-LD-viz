    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50599.cassa-integrazione-guadagni-ordinaria.html",
      "@type": "cpsv:PublicService",
      "cv:hasCompetentAuthority": {
        "@id": "https://www.inps.it"
      },
      "dct:identifier": "IT_033e8e4a-ee3a-4cbf-a2de-8f5207494cbd",
      "cpsv:otherServiceCode": "IT_033e8e4a-ee3a-4cbf-a2de-8f5207494cbd",
      "dct:title": {
        "@language": "it",
        "@value": "Cassa Integrazione Guadagni Ordinaria"
      },
      "dct:description": {
        "@language": "it",
        "@value": "La Cassa Integrazione Guadagni Ordinaria (CIGO) per l'industria e l'edilizia integra o sostituisce la retribuzione dei lavoratori la cui attività è sospesa o ridotta per situazioni aziendali dovute a eventi transitori e non imputabili all'impresa o ai dipendenti, comprese le intemperie stagionali e le situazioni temporanee di mercato."
      },
      "dct:abstract": {
        "@language": "it",
        "@value": "Domanda di Cassa Integrazione Guadagni Ordinaria per lavoratori subordinati nei casi di sospensione o riduzione dell’attività per eventi transitori non imputabili all'impresa o ai dipendenti, incluse le intemperie stagionali e le situazioni temporanee di mercato"
      },
      "foaf:page": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50599.cassa-integrazione-guadagni-ordinaria.html",
