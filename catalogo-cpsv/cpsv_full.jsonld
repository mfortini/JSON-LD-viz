    {
      "@id": "https://www.agenziaentrate.gov.it/portale/schede/istanze/costituzione-caf-e-relativi-elenchi/dati-caf-interrogazione",
      "@type": "cpsv:PublicService",
      "cv:hasCompetentAuthority": {
        "@id": "https://www.agenziaentrate.gov.it"
      },
      "dct:title": {
        "@language": "it",
        "@value": "Dati Caf – Interrogazione"
      },
      "dct:description": {
        "@language": "it",
        "@value": "L’Agenzia delle Entrate mette a disposizione dei Caf, in ambiente Entratel, un servizio di interrogazione dei propri dati. I Centri di assistenza fiscale, quindi, potranno consultare i propri dati, come Le informazioni sono aggiornate con cadenza settimanale. Ciascun Caf riceve presso la sede telematica principale (sede 000), nell’area autenticata - sezione “Comunicazioni “ alla voce “Altre comunicazioni’’, il file in formato excell firmato, compresso e cifrato. Restano a disposizione tutti i file prodotti nel corso dell’anno. Per maggiori chiarimenti consultare la guida sulle modalità di accesso ai dati"
      },
