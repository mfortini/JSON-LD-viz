      },
      "dct:identifier": "IT_881e8d22-af69-46c0-855d-3d4cd22f6043",
      "cpsv:otherServiceCode": "IT_881e8d22-af69-46c0-855d-3d4cd22f6043",
      "dct:title": {
        "@language": "it",
        "@value": "Il Casellario delle pensioni"
      },
      "dct:description": {
        "@language": "it",
        "@value": "È un servizio che raccoglie, conserva e gestisce i dati relativi ai trattamenti pensionistici obbligatori, integrativi e complementari erogati dagli enti previdenziali (d.p.r. 31 dicembre 1971, n. 1388)."
      },
      "dct:abstract": {
        "@language": "it",
        "@value": "Richiesta informazioni relative alla raccolta, alla conservazione e alla gestione dei dati e degli elementi relativi ai trattamenti pensionistici"
      },
      "foaf:page": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50587.il-casellario-delle-pensioni.html",
