      },
      "dct:identifier": "IT_d7be1ab3-59dc-46ad-aac8-cfd579d8f228",
      "cpsv:otherServiceCode": "IT_d7be1ab3-59dc-46ad-aac8-cfd579d8f228",
      "dct:title": {
        "@language": "it",
        "@value": "Benefici previdenziali per gli addetti a lavori usuranti"
      },
      "dct:description": {
        "@language": "it",
        "@value": "È un beneficio che prevede l’ accesso anticipato alla pensione con requisiti agevolati per i lavoratori dipendenti pubblici o privati che svolgono attività lavorative particolarmente faticose e pesanti, definite usuranti ."
      },
      "dct:abstract": {
        "@language": "it",
        "@value": "Domanda di accesso alla pensione anticipata con i requisiti agevolati per lavoratori dipendenti pubblici o privati che svolgono attività lavorative particolarmente faticose e pesanti"
      },
      "foaf:page": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50732.benefici-previdenziali-per-gli-addetti-a-lavori-usuranti.html",
