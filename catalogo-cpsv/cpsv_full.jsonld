    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.trattamenti-pensionistici-ai-lavoratori-stranieri-rimpatriati-50629.trattamenti-pensionistici-ai-lavoratori-stranieri-rimpatriati.html",
