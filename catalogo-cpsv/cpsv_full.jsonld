    {
      "@id": "https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.50185.fondo-di-garanzia-della-posizione-previdenziale-complementare.html#addressee-Banche%20e%20intermediari%20finanziari",
